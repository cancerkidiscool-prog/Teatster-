                else
                    local selected = library.flags[flag]
                    if not selected or typeof(selected) ~= "table" then
                        selected = {}
                        library.flags[flag] = selected
                    end

                    local function updateButtonText()
                        if #selected == 0 then
                            btn.Text = "  Select..."
                        elseif #selected == 1 then
                            btn.Text = "  " .. selected[1]
                        elseif #selected <= 3 then
                            btn.Text = "  " .. table.concat(selected, ", ")
                        else
                            btn.Text = "  " .. #selected .. " selected"
                        end
                    end
                    updateButtonText()

                    for _, v in next, list do
                        local item = utility.create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 28),
                            BackgroundColor3 = Color3.fromRGB(18, 18, 26),
                            BorderSizePixel = 0,
                            Text = "",
                            ZIndex = 21,
                            Parent = listFrame
                        })
                        item.MouseEnter:Connect(function()
                            item.BackgroundColor3 = Color3.fromRGB(30, 25, 45)
                        end)
                        item.MouseLeave:Connect(function()
                            item.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
                        end)

                        utility.create("TextLabel", {
                            Size = UDim2.new(1, -30, 1, 0),
                            Position = UDim2.new(0, 10, 0, 0),
                            BackgroundTransparency = 1,
                            Text = v,
                            TextColor3 = Color3.fromRGB(170, 170, 180),
                            TextSize = 13,
                            Font = Enum.Font.Code,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 22,
                            Parent = item
                        })

                        local check = utility.create("TextLabel", {
                            Size = UDim2.new(0, 20, 1, 0),
                            Position = UDim2.new(1, -25, 0, 0),
                            BackgroundTransparency = 1,
                            Text = "✔",
                            TextColor3 = library.accent,
                            TextSize = 14,
                            Font = Enum.Font.Code,
                            ZIndex = 22,
                            Parent = item
                        })
                        check.Visible = table.find(selected, v) ~= nil

                        item.MouseButton1Click:Connect(function()
                            local idx = table.find(selected, v)
                            if idx then
                                table.remove(selected, idx)
                                check.Visible = false
                            else
                                table.insert(selected, v)
                                check.Visible = true
                            end
                            updateButtonText()
                            if cb then cb(selected) end
                        end)
                    end
                end
            end

            -- ==================== SLIDER ====================
            function sectionActions:Slider(text, flag, min, max, default, callback)
                local slider = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 48),
                    BackgroundTransparency = 1,
                    ZIndex = 7,
                    Parent = items
                })

                -- Label and value on same line
                utility.create("TextLabel", {
                    Size = UDim2.new(0.6, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(190, 190, 200),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 8,
                    Parent = slider
                })

                local val = utility.create("TextLabel", {
                    Size = UDim2.new(0.4, 0, 0, 20),
                    Position = UDim2.new(0.6, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text = string.format("%.2f / %.2f", default, max),
                    TextColor3 = Color3.fromRGB(140, 140, 160),
                    TextSize = 12,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    ZIndex = 8,
                    Parent = slider
                })

                local sliderBar = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 22),
                    Position = UDim2.new(0, 0, 0, 24),
                    BackgroundTransparency = 1,
                    ZIndex = 8,
                    Parent = slider
                })

                local bg = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 8),
                    Position = UDim2.new(0, 0, 0.5, -4),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 35),
                    Text = "",
                    ZIndex = 8,
                    Parent = sliderBar
                })
                utility.create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = bg})
                bg.ClipsDescendants = true

                local fill = utility.create("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = library.accent,
                    BorderSizePixel = 0,
                    ZIndex = 9,
                    Parent = bg
                })
                utility.create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = fill})
                utility.create("UIGradient", {
                    Color = utility.gradient(library.outline),
                    Rotation = 0,
                    Parent = fill
                })

                -- Knob/thumb
                local knob = utility.create("Frame", {
                    Size = UDim2.new(0, 14, 0, 14),
                    Position = UDim2.new((default - min) / (max - min), -7, 0.5, -7),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    ZIndex = 10,
                    Parent = sliderBar
                })
                utility.create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = knob})

                library.flags[flag] = default

                local function update(input)
                    local perc = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
                    local rawValue = min + (max - min) * perc
                    local value = tonumber(string.format("%.2f", rawValue))
                    utility.tween(fill, {0.1}, {Size = UDim2.new(perc, 0, 1, 0)})
                    knob.Position = UDim2.new(perc, -7, 0.5, -7)
                    val.Text = string.format("%.2f / %.2f", value, max)
                    library.flags[flag] = value
                    if callback then callback(value) end
                end

                local dragging = false
                bg.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        update(input)
                    end
                end)
                services.UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        update(input)
                    end
                end)
                services.UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
            end

            -- ==================== BUTTON ====================
            function sectionActions:Button(text, callback)
                local btn = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundColor3 = Color3.fromRGB(22, 22, 30),
                    BorderSizePixel = 0,
                    Text = text,
                    TextColor3 = Color3.fromRGB(200, 200, 210),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    ZIndex = 7,
                    Parent = items
                })
                utility.stroke(btn, Color3.fromRGB(45, 45, 60), 1)
                utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = btn})

                btn.MouseEnter:Connect(function()
                    utility.tween(btn, {0.2}, {BackgroundColor3 = Color3.fromRGB(30, 25, 45)})
                end)
                btn.MouseLeave:Connect(function()
                    utility.tween(btn, {0.2}, {BackgroundColor3 = Color3.fromRGB(22, 22, 30)})
                end)
                btn.MouseButton1Click:Connect(function()
                    if callback then callback() end
                end)
            end

            -- ==================== INFO/TIP BOX ====================
            function sectionActions:Info(text)
                local infoFrame = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundColor3 = Color3.fromRGB(25, 22, 35),
                    BorderSizePixel = 0,
                    ZIndex = 7,
                    Parent = items
                })
                utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = infoFrame})
                utility.stroke(infoFrame, Color3.fromRGB(50, 40, 70), 1)

                utility.create("TextLabel", {
                    Size = UDim2.new(0, 20, 0, 20),
                    Position = UDim2.new(0, 8, 0, 8),
                    BackgroundTransparency = 1,
                    Text = "⭐",
                    TextSize = 14,
                    ZIndex = 8,
                    Parent = infoFrame
                })

                utility.create("TextLabel", {
                    Size = UDim2.new(1, -40, 0, 0),
                    Position = UDim2.new(0, 32, 0, 8),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(160, 160, 180),
                    TextSize = 12,
                    Font = Enum.Font.Code,
                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 8,
                    Parent = infoFrame
                })

                utility.create("UIPadding", {
                    PaddingBottom = UDim.new(0, 10),
                    Parent = infoFrame
                })
            end

            return sectionActions
        end

        return tabActions
    end

    -- Global search logic
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(searchBox.Text)

        if currentTab and currentTab.LeftCol and currentTab.RightCol then
            local cols = {currentTab.LeftCol, currentTab.RightCol}

            for _, col in ipairs(cols) do
                for _, child in ipairs(col:GetChildren()) do
                    if child.Name == "ZalSection" then
                        local title = child:FindFirstChildWhichIsA("TextLabel")
                        if title then
                            local match = (query == "") or string.find(string.lower(title.Text), query, 1, true)
                            child.Visible = match ~= nil
                        end
                    end
                end
            end
        end
    end)

    return windowActions
end

return library
