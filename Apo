local function findMoundsNearPlayer(range)
    local results = {}
    local resources = workspace:FindFirstChild("Resources")
    if not resources then return results end
    local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not root then return results end
    for _, obj in ipairs(resources:GetChildren()) do
        if obj:IsA("Model") and obj.Name == "_MOUND" then
            local eid = obj:GetAttribute("EntityID")
            if type(eid) == "number" and eid > 0 then
                local pos = (obj.PrimaryPart and obj.PrimaryPart.Position) or obj:GetPivot().Position
                if (pos - root.Position).Magnitude <= range then
                    table.insert(results, {model = obj, entityID = math.floor(eid), position = pos})
                end
            end
        end
    end
    return results
end
local function dig4SpotsNearPlayer()
    local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local offsets = {Vector3.new(0.8,12,0.8), Vector3.new(-0.8,12,0.8), Vector3.new(0.8,12,-0.8), Vector3.new(-0.8,12,-0.8)}
    local resources = workspace:FindFirstChild("Resources")
    local filter = {plr.Character}
    if resources then table.insert(filter, resources) end
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = filter
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    for _, offset in ipairs(offsets) do
        if not getgenv().sandDigEnabled then break end
        local startPos = root.Position + offset
        local result = workspace:Raycast(startPos, Vector3.new(0,-80,0), rayParams)
        local groundPos = result and result.Position or (root.Position - Vector3.new(0,3,0))
        local sandDigPos = groundPos + Vector3.new(0,1.7,0)
        FirePacket(EncodeFirstDig(sandDigPos))
        task.wait(0.006)
    end
end
