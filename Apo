-- Safe GUI parent
local function getGuiParent()
    local ok, core = pcall(function() return game:GetService("CoreGui") end)
    if ok and core then return core end
    return game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

local services = setmetatable({}, { __index = function(_, s) return game:GetService(s) end })

----------------------------------------------------------------------
-- Utilities
----------------------------------------------------------------------
local utility = {}

function utility.create(class, props)
    local obj = Instance.new(class)
    for prop, v in next, props do obj[prop] = v end
    return obj
end

function utility.gradient(colors)
    local t = {}
    for i, c in ipairs(colors) do
        table.insert(t, ColorSequenceKeypoint.new((i - 1) / (#colors - 1), c))
    end
    return ColorSequence.new(t)
end

function utility.tween(obj, info, props)
    local tween = services.TweenService:Create(obj, TweenInfo.new(unpack(info)), props)
    tween:Play()
    return tween
end

-- Thin stroke (1px)
function utility.stroke(obj, color, thickness)
    thickness = thickness or 1
    local s = Instance.new("UIStroke")
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Color = color or theme.controlOutline
    s.Thickness = thickness
    s.Parent = obj
    return s
end

function utility.label(parent, text, props)
    local base = {
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = theme.text,
        TextSize = 13,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = parent,
    }
    for k, v in next, props or {} do base[k] = v end
    return utility.create("TextLabel", base)
end

function utility.round(v, d)
    d = d or 0
    local m = 10 ^ d
    return math.floor(v * m + 0.5) / m
end

function utility.dragify(object, inputFrame)
    local dragging, dragInput, dragStart, startPos
    local target = inputFrame or object
    target.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = object.Position
            local c
            c = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    c:Disconnect()
                end
            end)
        end
    end)
    target.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if dragging and dragStart and startPos then
                local delta = input.Position - dragStart
                object.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end)
end

function utility.draggableBar(track, onUpdate)
    local dragging = false
    local function update(input)
        local perc = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        onUpdate(perc)
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    services.UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    services.UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

local function table_find(t, v)
    for i, x in ipairs(t) do if x == v then return i end end
    return nil
end

-- Color picker (kept simple, but styled)
local colorPanels = {}
function utility.closeAllColorPanels(except)
    for _, p in ipairs(colorPanels) do
        if p ~= except and p.Visible then p.Visible = false end
    end
end

function utility.colorpicker(row, flag, default, callback)
    local color = default or library.accent
    if library.flags[flag] and typeof(library.flags[flag]) == "Color3" then
        color = library.flags[flag]
    else
        library.flags[flag] = color
    end
    local h, s, v = Color3.toHSV(color)

    local swatch = utility.create("TextButton", {
        Size = UDim2.new(0, 22, 0, 12),
        Position = UDim2.new(1, -22, 0.5, -6),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "",
        ZIndex = 9,
        Parent = row,
    })
    utility.stroke(swatch, theme.controlOutline)

    local panel = utility.create("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Size = UDim2.new(0, 170, 0, 94),
        Position = UDim2.new(1, 0, 1, 5),
        BackgroundColor3 = theme.titlebar,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 40,
        Parent = swatch,
    })
    utility.stroke(panel, theme.outline)
    table.insert(colorPanels, panel)

    local preview = utility.create("Frame", {
        Size = UDim2.new(1, -16, 0, 14),
        Position = UDim2.new(0, 8, 0, 8),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        ZIndex = 41,
        Parent = panel,
    })
    utility.stroke(preview, theme.controlOutline)

    local function apply()
        color = Color3.fromHSV(h, s, v)
        preview.BackgroundColor3 = color
        swatch.BackgroundColor3 = color
        library.flags[flag] = color
        if callback then callback(color) end
    end

    local function channel(name, y, init, setter)
        local track = utility.create("TextButton", {
            Size = UDim2.new(1, -16, 0, 12),
            Position = UDim2.new(0, 8, 0, y),
            BackgroundColor3 = theme.control,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "",
            ClipsDescendants = true,
            ZIndex = 41,
            Parent = panel,
        })
        utility.stroke(track, theme.controlOutline)

        local fill = utility.create("Frame", {
            Size = UDim2.new(init, 0, 1, 0),
            BackgroundColor3 = library.accent,
            BorderSizePixel = 0,
            ZIndex = 42,
            Parent = track,
        })
        utility.create("UIGradient", {
            Color = utility.gradient({ library.accent, library.accentLight }),
            Parent = fill,
        })
        utility.label(track, name, {
            Size = UDim2.new(1, -6, 1, 0),
            Position = UDim2.new(0, 4, 0, 0),
            TextSize = 11,
            TextColor3 = theme.text,
            ZIndex = 43,
        })
        utility.draggableBar(track, function(p)
            fill.Size = UDim2.new(p, 0, 1, 0)
            setter(p)
            apply()
        end)
    end

    channel("H", 28, h, function(p) h = p end)
    channel("S", 46, s, function(p) s = p end)
    channel("V", 64, v, function(p) v = p end)

    swatch.MouseButton1Click:Connect(function()
        utility.closeAllColorPanels(panel)
        panel.Visible = not panel.Visible
    end)

    local obj = {
        Swatch = swatch,
        Set = function(_, newColor, fire)
            h, s, v = Color3.toHSV(newColor)
            apply()
            if fire ~= false and callback then callback(color) end
        end,
    }
    library.uiElements[flag] = obj
    return obj
end

