                local btnLabel = utility.create("TextLabel", {
                    Size = UDim2.new(1, -30, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "Select...",
                    TextColor3 = library.theme.textMuted,
                    TextSize = 13,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 8,
                    Parent = btn
                })
                local arrow = utility.create("TextLabel", {
                    Size = UDim2.new(0, 24, 1, 0),
                    Position = UDim2.new(1, -26, 0, 0),
                    BackgroundTransparency = 1,
                    Text = "⌄",
                    TextColor3 = library.theme.textMuted,
                    TextSize = 16,
                    Font = Enum.Font.GothamBold,
                    ZIndex = 8,
                    Parent = btn
                })

                local contentHeight = #list * 28 + 8
                local listFrame = utility.create("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    Position = UDim2.new(0, 0, 1, 4),
                    BackgroundColor3 = library.theme.bgTertiary,
                    BorderSizePixel = 0,
                    Visible = false,
                    ZIndex = 20,
                    ScrollBarThickness = 3,
                    ScrollBarImageColor3 = library.accent,
                    CanvasSize = UDim2.new(0, 0, 0, contentHeight),
                    Parent = btn
                })
                utility.corner(listFrame, 8)
                utility.stroke(listFrame, library.theme.border, 1, 0.3)
                utility.padding(listFrame, 4, 4, 0, 0)
                utility.create("UIListLayout", {Padding = UDim.new(0, 2), Parent = listFrame})

                local opened = false
                btn.MouseButton1Click:Connect(function()
                    opened = not opened
                    listFrame.Visible = opened
                    local targetH = opened and math.min(contentHeight, 160) or 0
                    utility.tween(listFrame, {0.2, Enum.EasingStyle.Quart}, {Size = UDim2.new(1, 0, 0, targetH)})
                    utility.tween(arrow, {0.2}, {Rotation = opened and 180 or 0})
                end)

                local selected = multi and {} or nil
                if multi then library.flags[flag] = selected end

                local function updateText()
                    if not multi then return end
                    if #selected == 0 then
                        btnLabel.Text = "Select..."
                        btnLabel.TextColor3 = library.theme.textMuted
                    elseif #selected <= 2 then
                        btnLabel.Text = table.concat(selected, ", ")
                        btnLabel.TextColor3 = library.theme.text
                    else
                        btnLabel.Text = #selected .. " selected"
                        btnLabel.TextColor3 = library.theme.text
                    end
                end

                for _, v in next, list do
                    local item = utility.create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 26),
                        BackgroundColor3 = library.theme.bgTertiary,
                        BackgroundTransparency = 1,
                        BorderSizePixel = 0,
                        Text = "",
                        ZIndex = 21,
                        Parent = listFrame
                    })
                    utility.corner(item, 5)
                    utility.padding(item, 0, 0, 8, 8)

                    utility.create("TextLabel", {
                        Size = UDim2.new(1, -28, 1, 0),
                        BackgroundTransparency = 1,
                        Text = v,
                        TextColor3 = library.theme.textDim,
                        TextSize = 13,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 22,
                        Parent = item
                    })

                    local checkmark = utility.create("TextLabel", {
                        Size = UDim2.new(0, 20, 1, 0),
                        Position = UDim2.new(1, -22, 0, 0),
                        BackgroundTransparency = 1,
                        Text = "✓",
                        TextColor3 = library.accent,
                        TextSize = 13,
                        Font = Enum.Font.GothamBold,
                        ZIndex = 22,
                        Visible = false,
                        Parent = item
                    })

                    utility.hover(item, Color3.fromRGB(0,0,0), library.theme.bgHover)
                    item.BackgroundTransparency = 1

                    item.MouseButton1Click:Connect(function()
                        if not multi then
                            btnLabel.Text = v
                            btnLabel.TextColor3 = library.theme.text
                            library.flags[flag] = v
                            opened = false
                            listFrame.Visible = false
                            utility.tween(listFrame, {0.2}, {Size = UDim2.new(1, 0, 0, 0)})
                            utility.tween(arrow, {0.2}, {Rotation = 0})
                            updateStatus()
                            if cb then cb(v) end
                        else
                            local idx = table.find(selected, v)
                            if idx then
                                table.remove(selected, idx)
                                checkmark.Visible = false
                            else
                                table.insert(selected, v)
                                checkmark.Visible = true
                            end
                            updateText()
                            updateStatus()
                            if cb then cb(selected) end
                        end
                    end)

                    if multi then
                        checkmark.Visible = table.find(selected, v) ~= nil
                    end
                end
            end

