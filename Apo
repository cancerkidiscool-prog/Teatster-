U.pad(NotifyList, 0, 50, 0, 0)

function ZalHub:Notify(opts)
    opts = opts or {}
    local dur = opts.Duration or 4
    local ntype = opts.Type or "info"
    local colors = {
        info = ZalHub.accent, success = Color3.fromRGB(76, 175, 80),
        warning = ZalHub.theme.warning, error = ZalHub.theme.danger
    }
    local col = colors[ntype] or ZalHub.accent

    local card = U.new("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = ZalHub.theme.panelBg, BorderSizePixel = 0,
        ClipsDescendants = true, Parent = NotifyList
    })
    U.corner(card, 3)
    U.stroke(card, ZalHub.theme.borderDark, 1)

    U.new("Frame", {
        Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = col,
        BorderSizePixel = 0, ZIndex = 2, Parent = card
    })

    local inner = U.new("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Parent = card
    })
    U.pad(inner, 8, 8, 10, 10)
    U.list(inner, nil, 2)

    U.new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1,
        Text = (opts.Title or "NOTIFICATION"):upper(),
        TextColor3 = col, TextSize = 11,
        Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left,
        Parent = inner
    })
    U.new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Text = opts.Content or "",
        TextColor3 = ZalHub.theme.textSub, TextSize = 11,
        Font = Enum.Font.Gotham, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = inner
    })

    local timerBg = U.new("Frame", {
        Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = ZalHub.theme.inputBg,
        BorderSizePixel = 0, Parent = inner
    })
    local timerFill = U.new("Frame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = col,
        BorderSizePixel = 0, Parent = timerBg
    })

    card.Position = UDim2.new(1, 0, 0, 0)
    U.tween(card, 0.25, {Position = UDim2.new(0, 0, 0, 0)})
    U.tween(timerFill, dur, {Size = UDim2.new(0, 0, 1, 0)}, Enum.EasingStyle.Linear)

    task.delay(dur, function()
        U.tween(card, 0.2, {Position = UDim2.new(1, 0, 0, 0)})
        task.wait(0.25); card:Destroy()
    end)
end

