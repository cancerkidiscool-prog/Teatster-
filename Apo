local function FireSwingPacket(data)
    if buffer and data ~= "" then ByteNetReliable:FireServer(buffer.fromstring(data)) end
end
local function HitSwingTarget(ids)
    if #ids == 0 then return end
    FireSwingPacket(EncodeSwing(ids))
end
local QUEEN_AURA_RANGE = 25
local function getQueenTargets()
    local ids = {}
    local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not root then return ids end
    local function checkModel(model)
        if Players:GetPlayerFromCharacter(model) then return end
        if not model:IsA("Model") or not model:FindFirstChild("Health") or model.Health.Value <= 0 then return end
        local name = model.Name
        local eid = model:GetAttribute("EntityID") or model:GetAttribute("ClientIdentifier")
        if not eid then return end
        if name:find("Queen Ant") and not name:find("Servant") then return end
        local isValid = false
        if name:find("Servant") or name:find("Queen Ant Servant") then isValid = true
        elseif name == "Lurky Boi" then isValid = true
        elseif model.Parent == workspace.Critters then isValid = true
        elseif model.Parent == workspace then isValid = true end
        if isValid then
            local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
            local pos = part and part.Position or model:GetPivot().Position
            if (root.Position - pos).Magnitude <= QUEEN_AURA_RANGE then table.insert(ids, eid) end
        end
    end
    for _, v in ipairs(workspace:GetChildren()) do checkModel(v) end
    local crit = workspace:FindFirstChild("Critters")
    if crit then for _, v in ipairs(crit:GetChildren()) do checkModel(v) end end
    for _, v in ipairs(workspace:GetDescendants()) do if v.Name == "Lurky Boi" or v.Name:find("Servant") then checkModel(v) end end
    return ids
end
local function startQueenAura()
    if queenAuraConnection then return end
    queenAuraConnection = RunService.Heartbeat:Connect(function()
        if not getgenv().queenAuraEnabled then return end
        local targets = getQueenTargets()
        if #targets > 0 then HitSwingTarget(targets) end
    end)
end
local function stopQueenAura()
    if queenAuraConnection then queenAuraConnection:Disconnect() queenAuraConnection = nil end
end
queenAntSection:Toggle("Enable Servant Kill Aura", "queenAuraToggle", function(state)
    getgenv().queenAuraEnabled = state
    if state then startQueenAura() else stopQueenAura() end
end)

