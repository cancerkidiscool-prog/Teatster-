                    Text = text,
                    TextColor3 = Color3.fromRGB(180, 180, 180),
                    TextSize = 13,
                    Font = library.fonts.UI,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 7,
                    Parent = frame,
                })
                local bar = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 22),
                    Position = UDim2.new(0, 0, 0, 24),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    Text = "",
                    ZIndex = 7,
                    Parent = frame,
                })
                utility.stroke(bar, Color3.fromRGB(50, 50, 50), 1)
                utility.create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = bar })
                bar.ClipsDescendants = true
                local fill = utility.create("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = library.accent,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = bar,
                })
                utility.create("UIGradient", {
                    Color = utility.gradient(library.outline),
                    Rotation = 0,
                    Parent = fill,
                })
                local valLabel = utility.create("TextLabel", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Size = UDim2.new(1, 0, 1, 0),
                    Position = UDim2.new(0.5, 0, 0.5, 0),
                    BackgroundTransparency = 1,
                    Text = string.format("%.2f / %.2f", default, max),
                    TextColor3 = Color3.new(1, 1, 1),
                    TextSize = 13,
                    Font = library.fonts.UI,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    ZIndex = 9,
                    Parent = bar,
                })
                local function setValue(frac)
                    local val = tonumber(string.format("%.2f", min + (max - min) * frac))
                    utility.tween(fill, {0.1}, {Size = UDim2.new(frac, 0, 1, 0)})
                    valLabel.Text = string.format("%.2f / %.2f", val, max)
                    library.flags[flag] = val
                    if callback then callback(val) end
                end
                local dragging = false
                bar.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        setValue(math.clamp((inp.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1))
                    end
                end)
                userInput.InputChanged:Connect(function(inp)
                    if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                        setValue(math.clamp((inp.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1))
                    end
                end)
                userInput.InputEnded:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
            end

