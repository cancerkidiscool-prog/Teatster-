    local inner = Utility.new("Frame", {
        Size = UDim2.new(1, -12, 0, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = card
    })
    Utility.padding(inner, 10, 10, 4, 4)
    Utility.list(inner, nil, 3)

    Utility.new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 16),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = col,
        TextSize = 13,
        Font = Library.fontTitle,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = inner
    })
    Utility.new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        Text = content,
        TextColor3 = Library.theme.textDim,
        TextSize = 12,
        Font = Library.fontBody,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = inner
    })

    -- Progress bar
    local progressBg = Utility.new("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = Library.theme.border,
        BorderSizePixel = 0,
        Parent = inner
    })
    Utility.corner(progressBg, 1)
    local progressFill = Utility.new("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = col,
        BorderSizePixel = 0,
        Parent = progressBg
