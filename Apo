-- ==================== BUILDER HELPER FUNCTIONS ====================
local function updateRaycastFilter()
    local char = plr.Character
    if char then return {char} end
    return {}
end
local function getSurfaceHeight(flatPos)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = updateRaycastFilter()
    rayParams.IgnoreWater = true
    local rayOrigin = flatPos + Vector3.new(0, 50, 0)
    local rayDirection = Vector3.new(0, -1500, 0)
    local rayResult = workspace:Raycast(rayOrigin, rayDirection, rayParams)
    if rayResult then
        return rayResult.Position.Y + getgenv().BuilderConfig.HEIGHT_OFFSET
    else
        return flatPos.Y - 3
    end
end
local function getGridPosition(basePos, xOffset, zOffset, rightVector, forwardVector, surfaceY)
    local targetPos = basePos + (rightVector * xOffset) + (forwardVector * zOffset)
    return CFrame.new(targetPos.X, surfaceY, targetPos.Z) * CFrame.Angles(0, math.atan2(forwardVector.X, forwardVector.Z) + getgenv().BuilderConfig.BOX_ROTATION, 0)
end

-- ==================== REAL PLANT BOX PREVIEW ====================
_G.BuilderPreview = function()
    local config = getgenv().BuilderConfig
    local state = getgenv().BuilderState
    if state.isBuilding then Notify({Title = "Builder", Content = "Already building!", Duration = 2}) return end
    if state.previewFolder then state.previewFolder:Destroy() end
    local char = plr.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then Notify({Title = "Builder", Content = "No character found!", Duration = 3}) return end
    local modelPath = rs:WaitForChild("Deployables"):FindFirstChild("Plant Box")
    if not modelPath then Notify({Title = "Builder Error", Content = "Plant Box model not found in ReplicatedStorage.Deployables", Duration = 5}) return end
    state.previewFolder = Instance.new("Folder", workspace)
    state.previewFolder.Name = "ZalHub_PlantBox_Preview"
    local startPos = root.Position
    local forwardDir = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
    local rightDir = Vector3.new(root.CFrame.RightVector.X, 0, root.CFrame.RightVector.Z).Unit
    state.GridOrigin = { Position = startPos, Forward = forwardDir, Right = rightDir, RotationY = math.atan2(forwardDir.X, forwardDir.Z) }
    local totalCols = config.GRIDS_X * config.GRID_SIZE
    local totalRows = config.GRIDS_Z * config.GRID_SIZE
    local totalBoxes = totalCols * totalRows
    Notify({Title = "Builder", Content = "Generating " .. totalBoxes .. " real Plant Box previews...", Duration = 4})
    for col = 0, totalCols - 1 do
        local startRow, stopRow, step = 0, totalRows - 1, 1
        if col % 2 ~= 0 then startRow, stopRow, step = totalRows - 1, 0, -1 end
        for row = startRow, stopRow, step do
            local flatPos = startPos + (rightDir * col * config.GRID_SPACING) + (forwardDir * row * config.GRID_SPACING)
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {plr.Character or {}, state.previewFolder}
            local rayResult = workspace:Raycast(flatPos + Vector3.new(0, 10, 0), Vector3.new(0, -1500, 0), rayParams)
            local surfaceY = rayResult and (rayResult.Position.Y + config.HEIGHT_OFFSET) or (flatPos.Y - 3)
            local targetCFrame = CFrame.new(flatPos.X, surfaceY, flatPos.Z) * CFrame.Angles(0, state.GridOrigin.RotationY + config.BOX_ROTATION, 0)
            local previewModel = modelPath:Clone()
            previewModel.Name = "PlantBox_Preview_" .. col .. "_" .. row
            for _, scr in ipairs(previewModel:GetDescendants()) do
                if scr:IsA("Script") or scr:IsA("LocalScript") or scr:IsA("ModuleScript") then scr.Disabled = true end
            end
            for _, part in ipairs(previewModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Transparency = 0.6
                    part.CanCollide = false
                    part.Anchored = true
                end
            end
            if previewModel.PrimaryPart then previewModel:SetPrimaryPartCFrame(targetCFrame) else previewModel:PivotTo(targetCFrame) end
            previewModel.Parent = state.previewFolder
            task.wait()
        end
    end
    Notify({Title = "Builder", Content = "Real Plant Box Preview Ready (" .. totalBoxes .. " boxes)", Duration = 4})
end

_G.BuilderStart = function()
    local config = getgenv().BuilderConfig
    local state = getgenv().BuilderState
    if state.isBuilding then return end
    if not state.GridOrigin then Notify({Title = "Error", Content = "Preview a grid first!", Duration = 3}) return end
    state.isBuilding = true
    local char = plr.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then state.isBuilding = false; return end
    local startPos = state.GridOrigin.Position
    local forwardDir = state.GridOrigin.Forward
    local rightDir = state.GridOrigin.Right
    local lockedCFrameRot = CFrame.Angles(0, state.GridOrigin.RotationY, 0)
    local totalCols = config.GRIDS_X * config.GRID_SIZE
    local totalRows = config.GRIDS_Z * config.GRID_SIZE
    local visualIndex = 0
    local distToOrigin = (root.Position - startPos).Magnitude
    if distToOrigin > 10 then
        Notify({Title = "Builder", Content = "Moving to Grid Area (" .. math.floor(distToOrigin) .. " studs)...", Duration = 2})
        local travelTime = math.max(distToOrigin / 200, 0.1)
        local travelTween = TweenService:Create(root, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {CFrame = CFrame.new(startPos) * lockedCFrameRot})
        travelTween:Play()
        travelTween.Completed:Wait()
        task.wait(0.2)
    end
    Notify({Title = "Builder", Content = "Starting Build...", Duration = 5})
    local placedCount = 0
    for col = 0, totalCols - 1 do
        if not state.isBuilding then break end
        local start, stop, step = 0, totalRows - 1, 1
        if col % 2 ~= 0 then start, stop, step = totalRows - 1, 0, -1 end
        for row = start, stop, step do
            if not state.isBuilding then break end
            visualIndex = visualIndex + 1
            if state.previewFolder then
                local visualParts = state.previewFolder:GetChildren()
                local ghostPart = visualParts[visualIndex]
                if ghostPart then ghostPart:Destroy() end
            end
            local flatPos = startPos + (rightDir * col * config.GRID_SPACING) + (forwardDir * row * config.GRID_SPACING)
            local surfaceY = getSurfaceHeight(flatPos)
            local cframe = getGridPosition(startPos, col * config.GRID_SPACING, row * config.GRID_SPACING, rightDir, forwardDir, surfaceY)
            local targetAbove = cframe.Position + Vector3.new(0, 4, 0)
            local distance = (root.Position - targetAbove).Magnitude
            local travelTime = math.max(distance / config.MOVE_SPEED, 0.05)
            local tween = TweenService:Create(root, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetAbove) * lockedCFrameRot})
            tween:Play()
            task.wait(travelTime + 0.05)
            local packet = EncodePlacePlantBox(cframe)
            FirePacket(packet)
            placedCount = placedCount + 1
            task.wait(0.05)
        end
    end
    state.isBuilding = false
    state.GridOrigin = nil
    if state.previewFolder then state.previewFolder:Destroy() end
    Notify({Title = "Builder", Content = "Build Complete! Placed: " .. placedCount .. " (rotation fixed to 45°)", Duration = 5})
end
_G.BuilderStop = function()
    local state = getgenv().BuilderState
    state.isBuilding = false
    state.GridOrigin = nil
    if state.previewFolder then state.previewFolder:Destroy() end
    Notify({Title = "Builder", Content = "Stopped", Duration = 2})
end

