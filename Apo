                local bar = utility.create("TextButton", {
                    Size = UDim2.new(1,0,0,20), Position = UDim2.new(0,0,0,22),
                    BackgroundColor3 = Color3.fromRGB(25,25,25), Text = "", ZIndex = 7, Parent = slider,
                })
                utility.stroke(bar, Color3.fromRGB(50,50,50), 1)
                bar.ClipsDescendants = true
                local fill = utility.create("Frame", {
                    Size = UDim2.new((default-min)/(max-min),0,1,0),
                    BackgroundColor3 = library.accent, BorderSizePixel = 0, ZIndex = 8, Parent = bar,
                })
                utility.create("UIGradient", {
                    Color = utility.gradient(library.outline), Rotation = 0, Parent = fill,
                })
                local valLabel = utility.create("TextLabel", {
                    AnchorPoint = Vector2.new(0.5,0.5), Size = UDim2.new(1,0,1,0),
                    Position = UDim2.new(0.5,0,0.5,0), BackgroundTransparency = 1,
                    Text = string.format("%.2f/%.2f", default, max),
                    TextColor3 = Color3.fromRGB(255,255,255), TextSize = 13,
                    Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 9, Parent = bar,
                })
                local function setValue(frac)
                    local val = tonumber(string.format("%.2f", min + (max-min)*frac))
                    utility.tween(fill, {0.1}, {Size = UDim2.new(frac,0,1,0)})
                    valLabel.Text = string.format("%.2f/%.2f", val, max)
                    library.flags[flag] = val
                    if callback then callback(val) end
                end
                local dragging = false
                bar.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        setValue(math.clamp((inp.Position.X - bar.AbsolutePosition.X)/bar.AbsoluteSize.X, 0, 1))
                    end
                end)
                userInput.InputChanged:Connect(function(inp)
                    if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                        setValue(math.clamp((inp.Position.X - bar.AbsolutePosition.X)/bar.AbsoluteSize.X, 0, 1))
                    end
                end)
                userInput.InputEnded:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
            end

            -- ========== DROPDOWN (with overlay) ==========
            function sectionActions:Dropdown(text, flag, list, multiOrCallback, callback)
                local multi = false; local cb = nil
                if typeof(multiOrCallback) == "boolean" then multi = multiOrCallback; cb = callback
                else cb = multiOrCallback end
                local frame = utility.create("Frame", {
                    Size = UDim2.new(1,0,0,55), BackgroundTransparency = 1, ZIndex = 6, Parent = itemsFrame,
                })
                utility.create("TextLabel", {
                    Size = UDim2.new(1,0,0,22), BackgroundTransparency = 1, Text = text,
                    TextColor3 = Color3.fromRGB(180,180,180), TextSize = 14,
                    Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7, Parent = frame,
                })
                local btn = utility.create("TextButton", {
                    Size = UDim2.new(1,0,0,28), Position = UDim2.new(0,0,0,24),
                    BackgroundColor3 = Color3.fromRGB(25,25,25), BorderSizePixel = 0,
                    Text = "Select...", TextColor3 = Color3.fromRGB(200,200,200),
                    TextSize = 14, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7, Parent = frame,
                })
                utility.stroke(btn, Color3.fromRGB(50,50,50), 1)
                utility.create("UICorner", { CornerRadius = UDim.new(0,8), Parent = btn })
                local arrowLabel = utility.create("TextLabel", {
                    Size = UDim2.new(0,30,1,0), Position = UDim2.new(1,-35,0,0),
                    BackgroundTransparency = 1, Text = "▼", TextColor3 = Color3.fromRGB(120,120,120),
                    TextSize = 14, Font = Enum.Font.Gotham, ZIndex = 8, Parent = btn,
                })
                local listFrame; local searchInput; local selected = multi and (library.flags[flag] or {}) or {}
                if multi and not library.flags[flag] then library.flags[flag] = selected end

                local function updateButtonText()
                    if multi then
                        btn.Text = #selected == 0 and "Select..." or (#selected <= 3 and table.concat(selected, ", ") or #selected.." selected")
                    else
                        btn.Text = selected[1] or "Select..."
                    end
                end
                updateButtonText()

                local function closeDropdown()
                    if listFrame then listFrame:Destroy(); listFrame = nil end
                end

                local function openDropdown()
                    closeDropdown()
                    listFrame = utility.create("ScrollingFrame", {
                        Size = UDim2.new(0, 200, 0, math.min(#list*28+26, 200)),
                        BackgroundColor3 = Color3.fromRGB(20,20,20), BorderSizePixel = 0,
                        ScrollBarThickness = 5, ScrollBarImageColor3 = Color3.fromRGB(60,60,60),
                        CanvasSize = UDim2.new(0,0,0,#list*28+26), ZIndex = 200,
                        Parent = overlay, -- put on overlay layer
                    })
                    utility.stroke(listFrame, Color3.fromRGB(50,50,50), 1)
                    utility.create("UICorner", { CornerRadius = UDim.new(0,8), Parent = listFrame })
                    -- position relative to button
                    local btnAbsPos = btn.AbsolutePosition
                    local btnAbsSize = btn.AbsoluteSize
                    listFrame.Position = UDim2.new(0, btnAbsPos.X, 0, btnAbsPos.Y + btnAbsSize.Y + 4)

                    local searchFrame = utility.create("Frame", {
                        Size = UDim2.new(1,0,0,26), BackgroundColor3 = Color3.fromRGB(25,25,25),
                        ZIndex = 201, Parent = listFrame,
                    })
                    searchInput = utility.create("TextBox", {
                        Size = UDim2.new(1,-10,1,-4), Position = UDim2.new(0,5,0,2),
                        BackgroundTransparency = 1, PlaceholderText = "Filter...", PlaceholderColor3 = Color3.fromRGB(100,100,100),
                        Text = "", TextColor3 = Color3.fromRGB(220,220,220), TextSize = 13,
                        Font = Enum.Font.Gotham, ClearTextOnFocus = false, ZIndex = 202, Parent = searchFrame,
                    })
                    local function renderItems()
                        for _, child in ipairs(listFrame:GetChildren()) do
                            if child ~= searchFrame then child:Destroy() end
                        end
                        local filter = string.lower(searchInput.Text)
                        local y = 26
                        for _, item in ipairs(list) do
                            if filter == "" or string.find(string.lower(item), filter, 1, true) then
                                local optionBtn = utility.create("TextButton", {
                                    Size = UDim2.new(1,0,0,28), BackgroundColor3 = Color3.fromRGB(25,25,25),
                                    BorderSizePixel = 0, Text = "", ZIndex = 201, Parent = listFrame,
                                })
                                utility.create("TextLabel", {
                                    Size = UDim2.new(1,-30,1,0), Position = UDim2.new(0,8,0,0),
                                    BackgroundTransparency = 1, Text = item,
                                    TextColor3 = Color3.fromRGB(180,180,180), TextSize = 14,
                                    Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 202, Parent = optionBtn,
                                })
                                if multi then
                                    local check = utility.create("TextLabel", {
                                        Size = UDim2.new(0,20,1,0), Position = UDim2.new(1,-28,0,0),
                                        BackgroundTransparency = 1, Text = "✓", TextColor3 = library.accent,
                                        TextSize = 16, Font = Enum.Font.Gotham, ZIndex = 202, Parent = optionBtn,
                                    })
                                    check.Visible = table.find(selected, item) ~= nil
                                    optionBtn.MouseButton1Click:Connect(function()
                                        local idx = table.find(selected, item)
                                        if idx then table.remove(selected, idx); check.Visible = false
                                        else table.insert(selected, item); check.Visible = true end
                                        updateButtonText()
                                        if cb then cb(selected) end
                                    end)
                                else
                                    optionBtn.MouseButton1Click:Connect(function()
                                        selected[1] = item
                                        btn.Text = item
                                        closeDropdown()
                                        library.flags[flag] = item
                                        if cb then cb(item) end
                                    end)
                                end
                                y = y + 28
                            end
                        end
                        -- Select All / None for multi
                        if multi then
                            local controls = utility.create("Frame", {
                                Size = UDim2.new(1,0,0,24), BackgroundColor3 = Color3.fromRGB(20,20,20),
                                ZIndex = 201, Parent = listFrame,
                            })
                            local all = utility.create("TextButton", {
                                Size = UDim2.new(0.5,-2,1,0), BackgroundColor3 = Color3.fromRGB(25,25,25),
                                Text = "All", TextColor3 = Color3.fromRGB(200,200,200), TextSize = 12,
                                Font = Enum.Font.Gotham, ZIndex = 202, Parent = controls,
                            })
                            all.MouseButton1Click:Connect(function()
                                for i, v in ipairs(list) do if not table.find(selected, v) then table.insert(selected, v) end end
                                renderItems()
                                updateButtonText()
                                if cb then cb(selected) end
                            end)
                            local none = utility.create("TextButton", {
                                Size = UDim2.new(0.5,-2,1,0), Position = UDim2.new(0.5,2,0,0),
                                BackgroundColor3 = Color3.fromRGB(25,25,25), Text = "None",
                                TextColor3 = Color3.fromRGB(200,200,200), TextSize = 12,
                                Font = Enum.Font.Gotham, ZIndex = 202, Parent = controls,
                            })
                            none.MouseButton1Click:Connect(function()
                                selected = {}
                                renderItems()
                                updateButtonText()
                                if cb then cb(selected) end
                            end)
                        end
                        listFrame.CanvasSize = UDim2.new(0,0,0, y)
                        if y > 200 then listFrame.Size = UDim2.new(0,200,0,200) end
                    end
                    searchInput:GetPropertyChangedSignal("Text"):Connect(renderItems)
                    renderItems()
                end

                btn.MouseButton1Click:Connect(function()
                    if listFrame then closeDropdown() else openDropdown() end
                end)
                -- close on click outside
                userInput.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 and listFrame then
                        local pos = userInput:GetMouseLocation()
                        if pos and listFrame then
                            local rect = {listFrame.AbsolutePosition.X, listFrame.AbsolutePosition.Y, listFrame.AbsoluteSize.X, listFrame.AbsoluteSize.Y}
                            if not (pos.X >= rect[1] and pos.X <= rect[1]+rect[3] and pos.Y >= rect[2] and pos.Y <= rect[2]+rect[4])
                                and not (pos.X >= btn.AbsolutePosition.X and pos.X <= btn.AbsolutePosition.X+btn.AbsoluteSize.X
                                    and pos.Y >= btn.AbsolutePosition.Y and pos.Y <= btn.AbsolutePosition.Y+btn.AbsoluteSize.Y) then
                                closeDropdown()
                            end
                        end
                    end
                end)
            end

            -- ========== COLOR PICKER (HSV + Alpha, overlay) ==========
            function sectionActions:ColorPicker(text, flag, defaultColor, callback)
