-- Config saving/loading
function library:LoadConfig(name)
    if not library.__configFolder then
        library.__configFolder = Instance.new("Folder")
        library.__configFolder.Name = "ZalHub_Configs"
        library.__configFolder.Parent = services.CoreGui
    end
    local config = library.__configFolder:FindFirstChild(name)
    if config then
        for flag, val in pairs(config:GetAttributes()) do
            library.flags[flag] = val
        end
        return true
    end
    return false
end

function library:SaveConfig(name)
    if not library.__configFolder then
        library.__configFolder = Instance.new("Folder")
        library.__configFolder.Name = "ZalHub_Configs"
        library.__configFolder.Parent = services.CoreGui
    end
    local config = library.__configFolder:FindFirstChild(name)
    if not config then
        config = Instance.new("Folder")
        config.Name = name
        config.Parent = library.__configFolder
    end
    for flag, val in pairs(library.flags) do
        config:SetAttribute(flag, val)
    end
end

