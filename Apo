    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(searchBox.Text)
        if not currentTab then return end

        for _, col in ipairs({currentTab.LeftCol, currentTab.RightCol}) do
            for _, section in ipairs(col:GetChildren()) do
                if section.Name == "ZalSection" then
                    local items = section:FindFirstChild("Items")
                    if items then
                        local anyVisible = false
                        for _, child in ipairs(items:GetChildren()) do
                            if child:IsA("GuiObject") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                                local txt = child:FindFirstChildWhichIsA("TextLabel") or child:FindFirstChildWhichIsA("TextButton")
                                local match = query == "" or (txt and string.find(string.lower(txt.Text or ""), query, 1, true))
                                child.Visible = match
                                if match then anyVisible = true end
                            end
                        end
                        section.Visible = query == "" or anyVisible
                    end
                end
            end
            col.CanvasPosition = Vector2.new()
        end
    end)

    return windowActions
end

return library
