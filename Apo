                            TextSize = 12,
                            Font = Enum.Font.Code,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 27,
                            Parent = item
                        })
                        local tick_mark = create("TextLabel", {
                            Size = UDim2.new(0, 18, 1, 0),
                            Position = UDim2.new(1, -22, 0, 0),
                            BackgroundTransparency = 1,
                            Text = "✓",
                            TextColor3 = library.accent,
                            TextSize = 13,
                            Font = Enum.Font.GothamBold,
                            ZIndex = 27,
                            Visible = table.find(selected, v) ~= nil,
                            Parent = item
                        })
                        
                        item.MouseEnter:Connect(function()
                            item.BackgroundColor3 = Color3.fromRGB(28, 24, 42)
                        end)
                        item.MouseLeave:Connect(function()
                            item.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
                        end)
                        item.MouseButton1Click:Connect(function()
                            local idx = table.find(selected, v)
                            if idx then
                                table.remove(selected, idx)
                                tick_mark.Visible = false
                            else
                                table.insert(selected, v)
                                tick_mark.Visible = true
                            end
                            refreshText()
                            if callback then callback(selected) end
                        end)
                    end
                end
            end
            
