-- WATERMARK (CS:GO net_graph style)
-- ════════════════════════════════════════════════════════════
function ZalHub:Watermark(text)
    local wmGui = U.new("ScreenGui", {
        Name = "ZalHub_WM", Parent = CoreGui,
        ResetOnSpawn = false, DisplayOrder = 998
    })
    local wm = U.new("Frame", {
        Size = UDim2.new(0, 0, 0, 22), AutomaticSize = Enum.AutomaticSize.X,
        Position = UDim2.new(1, -8, 0, 8), AnchorPoint = Vector2.new(1, 0),
        BackgroundColor3 = ZalHub.theme.windowBg, BorderSizePixel = 0,
        Parent = wmGui
    })
    U.corner(wm, 2)
    U.stroke(wm, ZalHub.theme.border, 1, 0.3)
    U.pad(wm, 0, 0, 8, 8)

    U.new("Frame", {
        Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = ZalHub.accent,
        BorderSizePixel = 0, ZIndex = 2, Parent = wm
    })

    local lbl = U.new("TextLabel", {
        Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1, Text = text or "ZalHub",
        TextColor3 = ZalHub.theme.textSub, TextSize = 11,
        Font = Enum.Font.RobotoMono, Parent = wm
    })

    local fps = 60; local lastT = tick()
    RunService.RenderStepped:Connect(function()
        fps = math.floor(1 / (tick() - lastT)); lastT = tick()
    end)
    task.spawn(function()
        while not ZalHub.unloaded do
            local ping = math.floor(Players.LocalPlayer:GetNetworkPing() * 1000)
            lbl.Text = string.format("%s | %dfps | %dms", text or "ZalHub", fps, ping)
            task.wait(0.5)
        end
    end)
    U.dragify(wm)
end

