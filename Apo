                    ZIndex = 6,
                    Parent = itemsFrame
                })
                utility.create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(180, 180, 180),
                    TextSize = 14,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 7,
                    Parent = dropdown
                })
                local btn = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24),
                    Position = UDim2.new(0, 0, 0, 22),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    BorderSizePixel = 0,
                    Text = "Select...",
                    TextColor3 = Color3.fromRGB(200, 200, 200),
                    TextSize = 14,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 7,
                    Parent = dropdown
                })
                utility.stroke(btn, Color3.fromRGB(50, 50, 50), 1)
                utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = btn})
                utility.create("TextLabel", {
                    Size = UDim2.new(0, 30, 1, 0),
                    Position = UDim2.new(1, -35, 0, 0),
                    BackgroundTransparency = 1,
                    Text = "▼",
                    TextColor3 = Color3.fromRGB(120, 120, 120),
                    TextSize = 14,
                    Font = Enum.Font.Code,
                    ZIndex = 8,
                    Parent = btn
                })
                local maxDropdownHeight = 200
                local contentHeight = #list * 24
                local listFrame = utility.create("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 0, contentHeight),
                    Position = UDim2.new(0, 0, 1, 4),
                    BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                    BorderSizePixel = 0,
                    Visible = false,
                    ZIndex = 11,
                    ScrollBarThickness = 5,
                    ScrollBarImageColor3 = Color3.fromRGB(60, 60, 60),
                    CanvasSize = UDim2.new(1, 0, 0, contentHeight),
                    Parent = btn
                })
                utility.stroke(listFrame, Color3.fromRGB(50, 50, 50), 1)
                local listLayout = utility.create("UIListLayout", {Padding = UDim.new(0, 2), Parent = listFrame})

                -- Search bar inside dropdown
                local searchFrame = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 22),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    ZIndex = 12,
                    Parent = listFrame
                })
                local searchDropdown = utility.create("TextBox", {
                    Size = UDim2.new(1, -10, 1, -4),
                    Position = UDim2.new(0, 5, 0, 2),
                    BackgroundTransparency = 1,
                    PlaceholderText = "Filter...",
                    PlaceholderColor3 = Color3.fromRGB(100, 100, 100),
                    Text = "",
                    TextColor3 = Color3.fromRGB(220, 220, 220),
                    TextSize = 12,
                    Font = Enum.Font.Code,
                    ClearTextOnFocus = false,
                    ZIndex = 13,
                    Parent = searchFrame
                })
                listLayout:ApplyLayout() -- ensure initial order; searchFrame first

                local opened = false
                btn.MouseButton1Click:Connect(function()
                    opened = not opened
                    listFrame.Visible = opened
                    if opened then
                        listFrame.Size = UDim2.new(1, 0, 0, math.min(contentHeight+22, maxDropdownHeight)) -- extra for search
                        listFrame.CanvasSize = UDim2.new(1, 0, 0, contentHeight+22)
                        listFrame.CanvasPosition = Vector2.new(0, 0)
                        searchDropdown.Text = ""
                        updateDropdownItems()
                    else
                        listFrame.Size = UDim2.new(1, 0, 0, 0)
                    end
                end)

                local selected = {}
                if multi then
                    local existing = library.flags[flag]
                    if existing and typeof(existing) == "table" then
                        selected = existing
                    else
                        library.flags[flag] = selected
                    end
                end

                local function updateButtonText()
                    if multi then
                        if #selected == 0 then btn.Text = "Select..." else
                            btn.Text = #selected <= 3 and table.concat(selected, ", ") or #selected .. " selected"
                        end
                    else
                        btn.Text = selected[1] or "Select..."
                    end
                end
                updateButtonText()

                local function updateDropdownItems()
                    -- Clear old items except searchFrame
                    for _, child in ipairs(listFrame:GetChildren()) do
                        if child ~= searchFrame then child:Destroy() end
                    end
                    local filter = string.lower(searchDropdown.Text)
                    for _, v in ipairs(list) do
                        if filter == "" or string.find(string.lower(v), filter, 1, true) then
                            local item = utility.create("TextButton", {
                                Size = UDim2.new(1, 0, 0, 24),
                                BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                                BorderSizePixel = 0,
                                Text = "",
                                ZIndex = 12,
                                Parent = listFrame
                            })
                            local itemText = utility.create("TextLabel", {
                                Size = UDim2.new(1, -30, 1, 0),
                                Position = UDim2.new(0, 5, 0, 0),
                                BackgroundTransparency = 1,
                                Text = v,
                                TextColor3 = Color3.fromRGB(160, 160, 160),
                                TextSize = 14,
                                Font = Enum.Font.Code,
                                TextXAlignment = Enum.TextXAlignment.Left,
                                ZIndex = 13,
                                Parent = item
                            })
                            if multi then
                                local check = utility.create("TextLabel", {
                                    Size = UDim2.new(0, 20, 1, 0),
                                    Position = UDim2.new(1, -25, 0, 0),
                                    BackgroundTransparency = 1,
                                    Text = "✔",
                                    TextColor3 = library.accent,
                                    TextSize = 14,
                                    Font = Enum.Font.Code,
                                    ZIndex = 13,
                                    Parent = item
                                })
                                check.Visible = table.find(selected, v) ~= nil
                                item.MouseButton1Click:Connect(function()
                                    local idx = table.find(selected, v)
                                    if idx then table.remove(selected, idx); check.Visible = false
                                    else table.insert(selected, v); check.Visible = true end
                                    updateButtonText()
                                    if cb then cb(selected) end
                                end)
                            else
                                item.MouseButton1Click:Connect(function()
                                    selected = {v}
                                    btn.Text = v
                                    opened = false
                                    listFrame.Visible = false
                                    listFrame.Size = UDim2.new(1,0,0,0)
                                    library.flags[flag] = v
                                    if cb then cb(v) end
                                end)
                            end
                        end
                    end
                    -- Resize canvas to fit items + search
                    local totalHeight = 22 + (listFrame:GetChildren():size() - 1) * 24 -- -1 for searchFrame? careful
                    listFrame.CanvasSize = UDim2.new(1, 0, 0, math.max(listLayout.AbsoluteContentSize.Y, 22))
                end
                searchDropdown:GetPropertyChangedSignal("Text"):Connect(updateDropdownItems)
            end

            -- Slider (improved: shows percentage, drag & click)
            function sectionActions:Slider(text, flag, min, max, default, callback)
                local slider = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundTransparency = 1,
                    ZIndex = 6,
                    Parent = itemsFrame
                })
                utility.create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(180, 180, 180),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 7,
                    Parent = slider
                })
                local sliderBar = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 20),
                    Position = UDim2.new(0, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Parent = slider
                })
                local bg = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 20),
                    Position = UDim2.new(0, 0, 0.5, -10),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    Text = "",
                    ZIndex = 7,
                    Parent = sliderBar
                })
                utility.stroke(bg, Color3.fromRGB(50, 50, 50), 1)
                bg.ClipsDescendants = true
                local fill = utility.create("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = library.accent,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = bg
                })
                utility.create("UIGradient", {
                    Color = utility.gradient(library.outline),
                    Rotation = 0,
                    Parent = fill
                })
                local valLabel = utility.create("TextLabel", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Size = UDim2.new(1, 0, 1, 0),
                    Position = UDim2.new(0.5, 0, 0.5, 0),
                    BackgroundTransparency = 1,
                    Text = string.format("%.2f / %.2f", default, max),
                    TextColor3 = Color3.fromRGB(255, 255, 255),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    ZIndex = 9,
                    Parent = bg
                })
                local function setValue(frac)
                    local value = tonumber(string.format("%.2f", min + (max - min) * frac))
                    utility.tween(fill, {0.1}, {Size = UDim2.new(frac, 0, 1, 0)})
                    valLabel.Text = string.format("%.2f / %.2f", value, max)
                    library.flags[flag] = value
                    if callback then callback(value) end
                end
                local dragging = false
                bg.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        local frac = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
                        setValue(frac)
                    end
                end)
                services.UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        local frac = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
                        setValue(frac)
                    end
                end)
                services.UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
            end

            -- Button
            function sectionActions:Button(text, callback)
                local btn = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    BorderSizePixel = 0,
                    Text = text,
                    TextColor3 = Color3.fromRGB(200, 200, 200),
                    TextSize = 14,
                    Font = Enum.Font.Code,
                    ZIndex = 6,
                    Parent = itemsFrame
                })
                utility.stroke(btn, Color3.fromRGB(50, 50, 50), 1)
                utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = btn})
                btn.MouseButton1Click:Connect(function()
                    if callback then callback() end
                end)
            end

            -- Color Picker (Linoria-style, basic)
            function sectionActions:ColorPicker(text, flag, defaultColor, callback)
                local picker = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 50),
                    BackgroundTransparency = 1,
                    ZIndex = 6,
                    Parent = itemsFrame
                })
                utility.create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(180, 180, 180),
                    TextSize = 14,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 7,
                    Parent = picker
                })
                local colorBtn = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24),
                    Position = UDim2.new(0, 0, 0, 22),
                    BackgroundColor3 = defaultColor or Color3.fromRGB(255,255,255),
                    BorderSizePixel = 0,
                    Text = "",
                    ZIndex = 7,
                    Parent = picker
                })
                utility.stroke(colorBtn, Color3.fromRGB(50, 50, 50), 1)
                utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = colorBtn})
                colorBtn.MouseButton1Click:Connect(function()
                    -- Simple color input via RGB textboxes (could expand with actual color wheel)
                    local input = utility.create("Frame", {
                        Size = UDim2.new(0, 180, 0, 60),
                        Position = UDim2.new(0.5, -90, 1, 5),
                        BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                        BorderSizePixel = 0,
                        ZIndex = 12,
                        Parent = picker
                    })
                    utility.stroke(input, library.accent, 1)
                    utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = input})
                    local rBox = utility.create("TextBox", {
                        Size = UDim2.new(0.3, -4, 1, -4),
                        Position = UDim2.new(0, 2, 0, 2),
                        BackgroundColor3 = Color3.fromRGB(30,30,30),
                        Text = tostring(math.floor(defaultColor.R*255)),
                        TextColor3 = Color3.fromRGB(255,100,100),
                        TextSize = 14,
                        Font = Enum.Font.Code,
                        ZIndex = 13,
                        Parent = input
                    })
                    local gBox = utility.create("TextBox", {
                        Size = UDim2.new(0.3, -4, 1, -4),
                        Position = UDim2.new(0.33, 2, 0, 2),
                        BackgroundColor3 = Color3.fromRGB(30,30,30),
                        Text = tostring(math.floor(defaultColor.G*255)),
                        TextColor3 = Color3.fromRGB(100,255,100),
                        TextSize = 14,
                        Font = Enum.Font.Code,
                        ZIndex = 13,
                        Parent = input
                    })
                    local bBox = utility.create("TextBox", {
                        Size = UDim2.new(0.3, -4, 1, -4),
                        Position = UDim2.new(0.66, 2, 0, 2),
                        BackgroundColor3 = Color3.fromRGB(30,30,30),
                        Text = tostring(math.floor(defaultColor.B*255)),
                        TextColor3 = Color3.fromRGB(100,100,255),
                        TextSize = 14,
                        Font = Enum.Font.Code,
                        ZIndex = 13,
                        Parent = input
                    })
                    local confirm = utility.create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 20),
                        Position = UDim2.new(0, 0, 1, 2),
                        BackgroundColor3 = library.accent,
                        BorderSizePixel = 0,
                        Text = "Apply",
                        TextColor3 = Color3.new(1,1,1),
                        TextSize = 12,
                        Font = Enum.Font.Code,
                        ZIndex = 13,
                        Parent = input
                    })
                    confirm.MouseButton1Click:Connect(function()
                        local r = math.clamp(tonumber(rBox.Text) or 255,0,255)/255
                        local g = math.clamp(tonumber(gBox.Text) or 255,0,255)/255
                        local b = math.clamp(tonumber(bBox.Text) or 255,0,255)/255
                        local newColor = Color3.fromRGB(r*255,g*255,b*255)
                        colorBtn.BackgroundColor3 = newColor
                        library.flags[flag] = newColor
                        if callback then callback(newColor) end
                        input:Destroy()
                    end)
                    -- Close on click outside
                    local conn
                    conn = services.UserInputService.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                            local pos = services.UserInputService:GetMouseLocation()
                            if input.AbsolutePosition.X > pos.X or pos.X > input.AbsolutePosition.X + input.AbsoluteSize.X
                            or input.AbsolutePosition.Y > pos.Y or pos.Y > input.AbsolutePosition.Y + input.AbsoluteSize.Y then
                                input:Destroy()
                                conn:Disconnect()
                            end
                        end
                    end)
                end)
            end

            -- Keybind picker
            function sectionActions:Keybind(text, flag, defaultKey, callback)
                local keybind = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 50),
                    BackgroundTransparency = 1,
                    ZIndex = 6,
                    Parent = itemsFrame
                })
                utility.create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(180, 180, 180),
                    TextSize = 14,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 7,
                    Parent = keybind
                })
                local btn = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24),
                    Position = UDim2.new(0, 0, 0, 22),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    BorderSizePixel = 0,
                    Text = defaultKey and defaultKey.Name or "None",
                    TextColor3 = Color3.fromRGB(200, 200, 200),
                    TextSize = 14,
                    Font = Enum.Font.Code,
                    ZIndex = 7,
                    Parent = keybind
                })
                utility.stroke(btn, Color3.fromRGB(50, 50, 50), 1)
                utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = btn})
                local listening = false
                btn.MouseButton1Click:Connect(function()
                    listening = true
                    btn.Text = "..."
                    local conn
                    conn = services.UserInputService.InputBegan:Connect(function(input, gameProcessed)
                        if listening and not gameProcessed then
                            if input.KeyCode ~= Enum.KeyCode.Unknown then
                                local key = input.KeyCode
                                btn.Text = key.Name
                                library.flags[flag] = key
                                if callback then callback(key) end
                                listening = false
                                conn:Disconnect()
                            end
                        end
                    end)
                end)
            end

            -- Label (just display text)
            function sectionActions:Label(text)
                utility.create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 24),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(150, 150, 150),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    TextWrapped = true,
                    ZIndex = 6,
                    Parent = itemsFrame
                })
            end

            return sectionActions
        end
        return tabActions
    end

    -- Global search: filter items within sections, not just sections
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(searchBox.Text)
        if currentTab and currentTab.Frame then
            local cols = {currentTab.LeftCol, currentTab.RightCol}
            for _, col in ipairs(cols) do
                for _, section in ipairs(col:GetChildren()) do
                    if section.Name == "ZalSection" then
                        local items = section:FindFirstChild("Items")
                        if items then
                            local anyVisible = false
                            for _, child in ipairs(items:GetChildren()) do
                                if child:IsA("GuiObject") then
                                    local txt = child:FindFirstChildWhichIsA("TextLabel") or child:FindFirstChildWhichIsA("TextButton")
                                    local match = (query == "") or (txt and string.find(string.lower(txt.Text), query, 1, true))
                                    child.Visible = match
                                    if match then anyVisible = true end
                                end
                            end
                            -- Hide section if no items visible
                            section.Visible = (query == "") or anyVisible
                            if section.Visible then
                                -- Also show header if section collapsed? keep as is
                            end
                        end
                    end
                end
                col.CanvasPosition = Vector2.new(0, 0)
            end
            task.wait(0.05)
            updateCanvas()
        end
    end)

    return windowActions
end

return library
