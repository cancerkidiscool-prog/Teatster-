                    ZIndex = 7,
                })

                local function set(value, fire)
                    enabled = value
                    utility.tween(check, { 0.12 }, { BackgroundTransparency = enabled and 0 or 1 })
                    utility.tween(textLabel, { 0.12 }, { TextColor3 = enabled and theme.text or theme.dimText })
                    library.flags[flag] = enabled
                    if fire ~= false and cb then cb(enabled) end
                end

                row.MouseButton1Click:Connect(function() set(not enabled) end)

                local obj = {
                    Row = row,
                    Set = function(_, val, fire) set(val and true or false, fire) end,
                    Get = function() return enabled end,
                    ColorPicker = function(_, cpFlag, cpDefault, cpCallback)
                        return utility.colorpicker(row, cpFlag, cpDefault, cpCallback)
                    end,
                }
                library.uiElements[flag] = obj
                return obj
            end

            ------------------------------------------------------------------
            -- Slider with centered value display (e.g., "100/250")
            ------------------------------------------------------------------
            function sectionActions:Slider(text, flag, min, max, default, callback, suffix)
                local opts = {}
                if typeof(callback) == "table" then
                    opts = callback
                    callback = opts.callback
                    suffix = opts.suffix or suffix
                end
                suffix = suffix or ""
                local decimals = opts.decimals
                if decimals == nil then
                    decimals = (min % 1 == 0 and max % 1 == 0 and default % 1 == 0) and 0 or 2
                end

                local initialValue
                if library.flags[flag] ~= nil and type(library.flags[flag]) == "number" then
                    initialValue = math.clamp(library.flags[flag], min, max)
                else
                    initialValue = default
                    library.flags[flag] = initialValue
                end

                local function fmt(value)
                    if decimals <= 0 then return string.format("%d", value) end
                    return string.format("%." .. decimals .. "f", value)
                end

                local row = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ZIndex = 6,
                    Parent = items,
                })

                -- Label: text on left, value on right
                local label = utility.label(row, text, {
                    Size = UDim2.new(1, -20, 0, 16),
                    TextColor3 = theme.text,
                    TextSize = 13,
                    ZIndex = 7,
                })
                local valLabel = utility.label(row, fmt(initialValue) .. suffix, {
                    Size = UDim2.new(0, 0, 0, 16),
                    Position = UDim2.new(1, 0, 0, 0),
                    TextColor3 = theme.dimText,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    ZIndex = 7,
                    AutomaticSize = Enum.AutomaticSize.X,
                })

                -- Slider track
                local track = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 14),
                    Position = UDim2.new(0, 0, 0, 18),
                    BackgroundColor3 = theme.control,
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Text = "",
                    ClipsDescendants = true,
                    ZIndex = 7,
                    Parent = row,
                })
                utility.stroke(track, theme.controlOutline)

                local fill = utility.create("Frame", {
                    Size = UDim2.new((initialValue - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = library.accent,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = track,
                })
                utility.create("UIGradient", {
                    Color = utility.gradient({ library.accent, library.accentLight }),
                    Parent = fill,
                })

                -- Centered value display (e.g., "100/250")
                local centerText = utility.label(track, fmt(initialValue) .. "/" .. fmt(max) .. suffix, {
                    Size = UDim2.new(1, 0, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Center,
                    TextColor3 = Color3.fromRGB(220, 220, 230),
                    TextSize = 11,
                    Font = Enum.Font.GothamBold,
                    ZIndex = 9,
                    BackgroundTransparency = 1,
                })

                local function setValue(value, fire)
                    value = math.clamp(utility.round(value, decimals), min, max)
                    fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
                    label.Text = text
                    valLabel.Text = fmt(value) .. suffix
                    centerText.Text = fmt(value) .. "/" .. fmt(max) .. suffix
                    library.flags[flag] = value
                    if fire ~= false and callback then callback(value) end
                end

                utility.draggableBar(track, function(perc)
                    setValue(min + (max - min) * perc)
                end)

                local obj = {
                    Set = function(_, value, fire) setValue(value, fire) end,
                }
                library.uiElements[flag] = obj
                return obj
            end

            ------------------------------------------------------------------
            -- Dropdown (inline with popup that never clips)
            ------------------------------------------------------------------
            function sectionActions:Dropdown(text, flag, list, callbackOrMulti, callback)
                local multi, cb = false, nil
                if typeof(callbackOrMulti) == "boolean" then
                    multi = callbackOrMulti
                    cb = callback
                elseif typeof(callbackOrMulti) == "function" then
                    cb = callbackOrMulti
                else
                    cb = callback
                end
                list = list or {}

                local row = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ZIndex = 6,
                    Parent = items,
                })
                utility.label(row, text, {
                    Size = UDim2.new(1, 0, 0, 16),
                    TextColor3 = theme.text,
                    TextSize = 13,
                    ZIndex = 7,
                })

                local btn = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 20),
                    Position = UDim2.new(0, 0, 0, 18),
                    BackgroundColor3 = theme.control,
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Text = "",
                    ZIndex = 7,
                    Parent = row,
                })
                utility.stroke(btn, theme.controlOutline)

                local valueLabel = utility.label(btn, "Select...", {
                    Size = UDim2.new(1, -28, 1, 0),
                    Position = UDim2.new(0, 5, 0, 0),
                    TextColor3 = theme.text,
                    TextSize = 13,
                    ZIndex = 8,
                })
                local arrowBox = utility.create("Frame", {
                    Size = UDim2.new(0, 16, 0, 16),
                    Position = UDim2.new(1, -18, 0.5, -8),
                    BackgroundColor3 = theme.titlebar,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = btn,
                })
                utility.stroke(arrowBox, theme.controlOutline)
                utility.label(arrowBox, "▼", {
                    Size = UDim2.new(1, 0, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Center,
                    TextColor3 = theme.text,
                    TextSize = 11,
                    ZIndex = 9,
                })

                -- Popup frame (floating, never clipped)
                local popup = utility.create("Frame", {
                    Size = UDim2.new(0, 0, 0, 0),
                    Position = UDim2.new(0, 0, 1, 2),
                    BackgroundColor3 = theme.titlebar,
                    BorderSizePixel = 0,
                    Visible = false,
                    ZIndex = 50,
                    Parent = btn,
                    ClipsDescendants = true,
                })
                utility.stroke(popup, theme.outline)

                local scroll = utility.create("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ScrollBarThickness = 4,
                    ScrollBarImageColor3 = Color3.fromRGB(100,100,100),
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    ZIndex = 51,
                    Parent = popup,
                })
                utility.create("UIListLayout", {
                    Padding = UDim.new(0, 0),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Parent = scroll,
                })

                local rowHeight = 20
                local maxHeight = 160

                local function makeItem()
                    local item = utility.create("TextButton", {
                        Size = UDim2.new(1, 0, 0, rowHeight),
                        BackgroundColor3 = theme.control,
                        BackgroundTransparency = 1,
                        BorderSizePixel = 0,
                        AutoButtonColor = false,
                        Text = "",
                        ZIndex = 52,
                        Parent = scroll,
                    })
                    item.MouseEnter:Connect(function()
                        item.BackgroundColor3 = theme.hover
                        item.BackgroundTransparency = 0
                    end)
                    item.MouseLeave:Connect(function() item.BackgroundTransparency = 1 end)
                    return item
                end

                local function updatePopupSize()
                    local contentH = #list * rowHeight
                    local h = math.min(contentH, maxHeight)
                    popup.Size = UDim2.new(1, 0, 0, h)
                    scroll.CanvasSize = UDim2.new(0, 0, 0, contentH)
                end

                -- Reposition popup to avoid clipping (check if it goes out of window)
                local function repositionPopup()
                    local absPos = popup.AbsolutePosition
                    local parentAbs = popup.Parent:FindFirstAncestorWhichIsA("Frame") and popup.Parent:FindFirstAncestorWhichIsA("Frame").AbsolutePosition or Vector2.new(0,0)
                    -- We'll just ensure it stays within the window bounds by adjusting position if needed.
                    local win = popup:FindFirstAncestor("Holder")
                    if win then
                        local winAbs = win.AbsolutePosition
                        local winSize = win.AbsoluteSize
                        local popupSize = popup.AbsoluteSize
                        -- If popup goes below window bottom, move it up
                        local bottom = popup.AbsolutePosition.Y + popupSize.Y
                        if bottom > winAbs.Y + winSize.Y then
                            local offset = bottom - (winAbs.Y + winSize.Y)
                            popup.Position = UDim2.new(0, 0, 0, popup.Position.Y.Offset - offset - 4)
                        end
                    end
                end

                local dropdownObj = {}

                if not multi then
                    local currentValue
                    if library.flags[flag] ~= nil and type(library.flags[flag]) == "string" then
                        currentValue = library.flags[flag]
                    end
                    for _, v in next, list do
                        local item = makeItem()
                        utility.label(item, tostring(v), {
                            Size = UDim2.new(1, -10, 1, 0),
                            Position = UDim2.new(0, 5, 0, 0),
                            TextColor3 = theme.dimText,
                            TextSize = 13,
                            ZIndex = 53,
                        })
                        item.MouseButton1Click:Connect(function()
                            valueLabel.Text = tostring(v)
                            popup.Visible = false
                            library.flags[flag] = v
                            if cb then cb(v) end
                        end)
                    end
                    if currentValue and table_find(list, currentValue) then
                        valueLabel.Text = currentValue
                        library.flags[flag] = currentValue
                    else
                        library.flags[flag] = ""
                    end
                    function dropdownObj:Set(value, fire)
                        valueLabel.Text = tostring(value)
                        library.flags[flag] = value
                        if fire ~= false and cb then cb(value) end
                    end
                else
                    local selected
                    if library.flags[flag] ~= nil and type(library.flags[flag]) == "table" then
                        selected = library.flags[flag]
                    else
                        selected = {}
                        library.flags[flag] = selected
                    end
                    local function updateButtonText()
                        if #selected == 0 then valueLabel.Text = "Select..."
                        elseif #selected <= 2 then valueLabel.Text = table.concat(selected, ", ")
                        else valueLabel.Text = #selected .. " selected" end
                    end
                    updateButtonText()

                    for _, v in next, list do
                        local item = makeItem()
                        utility.label(item, tostring(v), {
                            Size = UDim2.new(1, -30, 1, 0),
                            Position = UDim2.new(0, 5, 0, 0),
                            TextColor3 = theme.dimText,
                            TextSize = 13,
                            ZIndex = 53,
                        })
                        local mark = utility.create("Frame", {
                            Size = UDim2.new(0, 8, 0, 8),
                            Position = UDim2.new(1, -16, 0.5, -4),
                            BackgroundColor3 = library.accent,
                            BorderSizePixel = 0,
                            Visible = table_find(selected, v) ~= nil,
                            ZIndex = 54,
                            Parent = item,
                        })
                        utility.create("UIGradient", {
                            Color = utility.gradient({ library.accent, library.accentLight }),
                            Parent = mark,
                        })
                        item.MouseButton1Click:Connect(function()
                            local idx = table_find(selected, v)
                            if idx then
                                table.remove(selected, idx)
                                mark.Visible = false
                            else
                                table.insert(selected, v)
                                mark.Visible = true
                            end
                            updateButtonText()
                            if cb then cb(selected) end
                        end)
                    end
                    function dropdownObj:Set(value, fire)
                        if typeof(value) == "table" then
                            selected = value
                            library.flags[flag] = selected
                            updateButtonText()
                            if fire ~= false and cb then cb(selected) end
                        end
                    end
                end

                updatePopupSize()

                local opened = false
                local function setOpen(state)
                    opened = state
                    popup.Visible = opened
                    if opened then
                        popup.Size = UDim2.new(1, 0, 0, 0) -- reset to recalc
                        updatePopupSize()
                        task.wait(0.02)
                        repositionPopup()
                    end
                end
                btn.MouseButton1Click:Connect(function() setOpen(not opened) end)

                function dropdownObj:Refresh(newList)
                    for _, child in ipairs(scroll:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end
                    list = newList or {}
                    updatePopupSize()
                    if not multi then
                        for _, v in next, list do
                            local item = makeItem()
                            utility.label(item, tostring(v), {
                                Size = UDim2.new(1, -10, 1, 0),
                                Position = UDim2.new(0, 5, 0, 0),
                                TextColor3 = theme.dimText,
                                TextSize = 13,
                                ZIndex = 53,
                            })
                            item.MouseButton1Click:Connect(function()
                                valueLabel.Text = tostring(v)
                                setOpen(false)
                                library.flags[flag] = v
                                if cb then cb(v) end
                            end)
                        end
                    end
                end

                library.uiElements[flag] = dropdownObj
                return dropdownObj
            end

            ------------------------------------------------------------------
            -- Textbox
            ------------------------------------------------------------------
            function sectionActions:Textbox(text, flag, placeholder, callback)
                local frame = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ZIndex = 6,
                    Parent = items,
                })
                utility.label(frame, text, {
                    Size = UDim2.new(1, 0, 0, 16),
                    TextColor3 = theme.text,
                    TextSize = 13,
                    ZIndex = 7,
                })
                local initial = ""
                if library.flags[flag] ~= nil and type(library.flags[flag]) == "string" then
                    initial = library.flags[flag]
                else
                    library.flags[flag] = initial
                end
                local box = utility.create("TextBox", {
                    Size = UDim2.new(1, 0, 0, 20),
                    Position = UDim2.new(0, 0, 0, 18),
                    BackgroundColor3 = theme.control,
                    BorderSizePixel = 0,
                    PlaceholderText = placeholder or "...",
                    PlaceholderColor3 = Color3.fromRGB(100,100,100),
                    Text = initial,
                    TextColor3 = theme.text,
                    TextSize = 13,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false,
                    ZIndex = 7,
                    Parent = frame,
                })
                utility.stroke(box, theme.controlOutline)
                utility.create("UIPadding", {
                    Parent = box,
                    PaddingLeft = UDim.new(0, 5),
                })
                box.FocusLost:Connect(function()
                    library.flags[flag] = box.Text
                    if callback then callback(box.Text) end
                end)
                local obj = {
                    Set = function(_, value, fire)
                        box.Text = value
                        library.flags[flag] = value
                        if fire ~= false and callback then callback(value) end
                    end,
                }
                library.uiElements[flag] = obj
                return obj
            end

            ------------------------------------------------------------------
            -- Button
            ------------------------------------------------------------------
            function sectionActions:Button(text, callback)
                local btn = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 22),
                    BackgroundColor3 = theme.titlebar,
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Text = text,
                    TextColor3 = theme.text,
                    TextSize = 13,
                    Font = Enum.Font.Gotham,
                    ZIndex = 6,
                    Parent = items,
                })
                utility.stroke(btn, theme.controlOutline)
                btn.MouseEnter:Connect(function()
                    utility.tween(btn, { 0.12 }, { BackgroundColor3 = library.accent })
                end)
                btn.MouseLeave:Connect(function()
                    utility.tween(btn, { 0.12 }, { BackgroundColor3 = theme.titlebar })
                end)
                btn.MouseButton1Click:Connect(function() if callback then callback() end end)
                return btn
            end

            ------------------------------------------------------------------
            -- ColorPicker standalone
            ------------------------------------------------------------------
            function sectionActions:ColorPicker(text, flag, default, callback)
                local row = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 18),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ZIndex = 6,
                    Parent = items,
                })
                utility.label(row, text, {
                    Size = UDim2.new(1, -34, 1, 0),
                    TextColor3 = theme.text,
                    TextSize = 13,
                    ZIndex = 7,
                })
                return utility.colorpicker(row, flag, default, callback)
            end

            return sectionActions
        end

        return tabActions
    end

    -- Search filter
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(searchBox.Text)
        if currentTab and currentTab.LeftCol and currentTab.RightCol then
            for _, col in ipairs({ currentTab.LeftCol, currentTab.RightCol }) do
                for _, child in ipairs(col:GetChildren()) do
                    if child.Name == "ZalSection" then
                        local title = child:FindFirstChild("SectionTitle")
                        local matched = query == ""
                        if not matched and title then
                            matched = string.find(string.lower(title.Text), query, 1, true) ~= nil
                        end
                        child.Visible = matched
                    end
                end
                local layout = col:FindFirstChildWhichIsA("UIListLayout")
                if layout then
                    col.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 30)
                end
            end
        end
    end)

    return windowActions
end

----------------------------------------------------------------------
-- Config system (unchanged API, but with style)
----------------------------------------------------------------------
local HttpService = services.HttpService
local CONFIG_FOLDER = "ZalHub"

local function ensureFolder()
    if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
end

function library:GetConfigs()
    ensureFolder()
    local files = listfiles(CONFIG_FOLDER)
    local configs = {}
    for _, path in ipairs(files) do
        local name = path:match("([^/\\]+)%.json$")
        if name then table.insert(configs, name) end
    end
    table.sort(configs)
    return configs
end

function library:SaveConfig(name)
    if not name or name == "" then
        library:Notify({ Title = "Config", Content = "Config name cannot be empty.", Duration = 3 })
        return false
    end
    ensureFolder()
    local data = {}
    for flag, value in pairs(library.flags) do
        if string.sub(flag, 1, 2) ~= "__" then
            local t = typeof(value)
            if t == "boolean" or t == "number" or t == "string" then
                data[flag] = { type = t, value = value }
            elseif t == "Color3" then
                data[flag] = { type = "Color3", value = { R = value.R, G = value.G, B = value.B } }
            elseif t == "table" then
                local safe = true
                for _, v in ipairs(value) do
                    if typeof(v) ~= "string" and typeof(v) ~= "number" then safe = false break end
                end
                if safe then data[flag] = { type = "table", value = value } end
            end
        end
    end
    local success, json = pcall(function() return HttpService:JSONEncode(data) end)
    if not success then
        library:Notify({ Title = "Config Error", Content = "Failed to serialize config data.", Duration = 4 })
        return false
    end
    writefile(CONFIG_FOLDER .. "/" .. name .. ".json", json)
    library:Notify({ Title = "Config Saved", Content = 'Saved "' .. name .. '".', Duration = 3 })
    return true
end

function library:LoadConfig(name, silent)
    if not name or name == "" then
        if not silent then library:Notify({ Title = "Config", Content = "Config name cannot be empty.", Duration = 3 }) end
        return false
    end
    ensureFolder()
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    if not isfile(path) then
        if not silent then library:Notify({ Title = "Config", Content = 'Config "' .. name .. '" not found.', Duration = 3 }) end
        return false
    end
    local json = readfile(path)
    local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or typeof(data) ~= "table" then
        if not silent then library:Notify({ Title = "Config Error", Content = "Failed to parse config file.", Duration = 4 }) end
        return false
    end

    library._loading = true
    local count = 0
    for flag, entry in pairs(data) do
        if entry.type == "Color3" then
            library.flags[flag] = Color3.new(entry.value.R, entry.value.G, entry.value.B)
        elseif entry.type == "table" then
            library.flags[flag] = entry.value
        else
            library.flags[flag] = entry.value
        end
        count = count + 1

        local el = library.uiElements[flag]
        if el and el.Set then
            el:Set(library.flags[flag], false)
        end
    end
    library._loading = false

    if not silent then
        library:Notify({ Title = "Config Loaded", Content = 'Loaded "' .. name .. '" (' .. count .. ' flags applied).', Duration = 3 })
    end
    return true
end

function library:DeleteConfig(name)
    if not name or name == "" then
        library:Notify({ Title = "Config", Content = "Config name cannot be empty.", Duration = 3 })
        return false
    end
    ensureFolder()
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    if not isfile(path) then
        library:Notify({ Title = "Config", Content = 'Config "' .. name .. '" does not exist.', Duration = 3 })
        return false
    end
    delfile(path)
    library:Notify({ Title = "Config Deleted", Content = 'Deleted "' .. name .. '" successfully.', Duration = 3 })
    return true
end

function library:ConfigExists(name)
    if not name or name == "" then return false end
    ensureFolder()
    return isfile(CONFIG_FOLDER .. "/" .. name .. ".json")
end

-- Config section (same as before)
function library:ConfigSection(tabActions, side)
    local section = tabActions:Section("Configuration", side)

    ensureFolder()
    local autoloadPath = CONFIG_FOLDER .. "/_autoload.txt"
    local autoLoadName = nil
    local autoLoadEnabled = false
    if isfile(autoloadPath) then
        autoLoadName = readfile(autoloadPath)
        if autoLoadName and autoLoadName ~= "" and library:ConfigExists(autoLoadName) then
            autoLoadEnabled = true
        else
            delfile(autoloadPath)
            autoLoadName = nil
        end
    end

    library.flags["__config_name"] = library.flags["__config_name"] or "my_config"
    if autoLoadName then
        library.flags["__config_select"] = autoLoadName
    else
        library.flags["__config_select"] = library.flags["__config_select"] or ""
    end
    library.flags["__config_autoload"] = autoLoadEnabled
    library.flags["__autosave_config_name"] = library.flags["__autosave_config_name"] or "autosave"
    library.flags["__autosave_enabled"] = library.flags["__autosave_enabled"] or false

    section:Divider("Save / Load")
    section:Textbox("Config Name", "__config_name", "my_config")

    section:Button("Save Config", function()
        local name = library.flags["__config_name"]
        if name and name ~= "" then
            library:SaveConfig(name)
            local newList = library:GetConfigs()
            loadDropdown:Refresh(newList)
            library.flags["__config_select"] = name
        else
            library:Notify({ Title = "Config", Content = "Enter a config name first.", Duration = 3 })
        end
    end)

    section:Divider("Manage")
    local configList = library:GetConfigs()
    local loadDropdown = section:Dropdown("Select Config", "__config_select", configList, function(selected) end)

    section:Button("Load Selected", function()
        local selected = library.flags["__config_select"]
        if selected and selected ~= "" then
            library:LoadConfig(selected)
        else
            library:Notify({ Title = "Config", Content = "Select a config from the dropdown first.", Duration = 3 })
        end
    end)

    section:Button("Overwrite Selected", function()
        local selected = library.flags["__config_select"]
        if selected and selected ~= "" then
            library:SaveConfig(selected)
            local newList = library:GetConfigs()
            loadDropdown:Refresh(newList)
        else
            library:Notify({ Title = "Config", Content = "Select a config to overwrite.", Duration = 3 })
        end
    end)

    section:Button("Delete Selected", function()
        local selected = library.flags["__config_select"]
        if selected and selected ~= "" then
            library:DeleteConfig(selected)
            local newList = library:GetConfigs()
            loadDropdown:Refresh(newList)
            library.flags["__config_select"] = ""
        else
            library:Notify({ Title = "Config", Content = "Select a config to delete.", Duration = 3 })
        end
    end)

    section:Button("Refresh List", function()
        local newList = library:GetConfigs()
        loadDropdown:Refresh(newList)
        library:Notify({ Title = "Config", Content = "Found " .. #newList .. " saved config(s).", Duration = 3 })
    end)

    section:Divider("Options")
    section:Toggle("Auto-Load on Start", "__config_autoload", function(enabled)
        if enabled then
            local name = library.flags["__config_select"]
            if name and name ~= "" then
                ensureFolder()
                writefile(CONFIG_FOLDER .. "/_autoload.txt", name)
                library:Notify({ Title = "Config", Content = '"' .. name .. '" will auto-load on start.', Duration = 3 })
            else
                library:Notify({ Title = "Config", Content = "Select a config first to set as auto-load.", Duration = 3 })
                library.flags["__config_autoload"] = false
            end
        else
            if isfile(CONFIG_FOLDER .. "/_autoload.txt") then delfile(CONFIG_FOLDER .. "/_autoload.txt") end
            library:Notify({ Title = "Config", Content = "Auto-load disabled.", Duration = 3 })
        end
    end)

    section:Divider("Auto-Save")
    section:Textbox("Auto-Save Name", "__autosave_config_name", "autosave", function(text)
        if library.autoSaveEnabled then
            library.autoSaveConfigName = text
        end
    end)

    section:Toggle("Enable Auto-Save", "__autosave_enabled", function(enabled)
        library.autoSaveEnabled = enabled
        if enabled then
            local name = library.flags["__autosave_config_name"]
            if name and name ~= "" then
                library.autoSaveConfigName = name
                library:Notify({ Title = "Auto-Save", Content = "Auto-saving to \"" .. name .. "\" enabled.", Duration = 3 })
            else
                library:Notify({ Title = "Auto-Save", Content = "Please enter an auto-save config name first.", Duration = 3 })
                library.autoSaveEnabled = false
            end
        else
            library.autoSaveConfigName = nil
            library:Notify({ Title = "Auto-Save", Content = "Auto-save disabled.", Duration = 3 })
        end
    end)

    return section
end

function library:AutoLoadConfig()
    ensureFolder()
    local autoloadPath = CONFIG_FOLDER .. "/_autoload.txt"
    if isfile(autoloadPath) then
        local name = readfile(autoloadPath)
        if name and name ~= "" and isfile(CONFIG_FOLDER .. "/" .. name .. ".json") then
            library:LoadConfig(name, true)
        end
    end
end

library:AutoLoadConfig()

return library
