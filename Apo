                local currentAlpha = 1

                local function closePicker()
                    if pickerFrame then pickerFrame:Destroy(); pickerFrame = nil end
                end

                local function openPicker()
                    closePicker()
                    pickerFrame = utility.create("Frame", {
                        Size = UDim2.new(0,240,0,210), Position = UDim2.new(0.5,-120,1,10),
                        BackgroundColor3 = Color3.fromRGB(18,18,18), BorderSizePixel = 0, ZIndex = 200, Parent = overlay,
                    })
                    utility.stroke(pickerFrame, library.accent, 1)
                    utility.create("UICorner", { CornerRadius = UDim.new(0,8), Parent = pickerFrame })
                    -- Position below button
                    local btnAbs = colorBtn.AbsolutePosition
                    pickerFrame.Position = UDim2.new(0, btnAbs.X, 0, btnAbs.Y + colorBtn.AbsoluteSize.Y + 5)

                    -- SV box
                    svBox = utility.create("ImageButton", {
                        Size = UDim2.new(0,150,0,150), Position = UDim2.new(0,5,0,5),
                        BackgroundColor3 = Color3.new(1,1,1), Image = "rbxassetid://284402810",
                        BorderSizePixel = 0, ZIndex = 201, Parent = pickerFrame,
                    })
                    local svGrad = utility.create("UIGradient", {
                        Name = "SVGradient", Color = ColorSequence.new{
                            ColorSequenceKeypoint.new(0, Color3.new(1,1,1)),
                            ColorSequenceKeypoint.new(1, Color3.fromHSV(currentH,1,1))
                        }, Rotation = 0, Parent = svBox,
                    })
                    local wbGrad = utility.create("UIGradient", {
                        Name = "WBGradient", Transparency = NumberSequence.new{
                            NumberSequenceKeypoint.new(0,0), NumberSequenceKeypoint.new(1,1)
                        }, Rotation = 90, Parent = svBox,
                    })
                    svCursor = utility.create("Frame", {
                        Size = UDim2.new(0,10,0,10), BackgroundColor3 = Color3.new(1,1,1),
                        BorderSizePixel = 0, ZIndex = 202, Parent = svBox,
                    })
                    utility.create("UICorner", { CornerRadius = UDim.new(0,5), Parent = svCursor })
                    utility.stroke(svCursor, Color3.new(0,0,0), 1)
                    svCursor.Position = UDim2.new(currentS, -5, 1-currentV, -5)

                    -- Hue bar
                    hueBar = utility.create("ImageButton", {
                        Size = UDim2.new(0,20,0,150), Position = UDim2.new(0,160,0,5),
                        BackgroundColor3 = Color3.new(1,1,1), Image = "rbxassetid://284402810",
                        BorderSizePixel = 0, ZIndex = 201, Parent = pickerFrame,
                    })
                    utility.create("UIGradient", {
                        Name = "HueGradient", Color = ColorSequence.new{
                            ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)),
                            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,255,0)),
                            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
                            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0,255,255)),
                            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0,0,255)),
                            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
                            ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0)),
                        }, Rotation = 90, Parent = hueBar,
                    })
                    hueCursor = utility.create("Frame", {
                        Size = UDim2.new(0,24,0,6), BackgroundColor3 = Color3.new(1,1,1),
                        BorderSizePixel = 0, ZIndex = 202, Parent = hueBar,
                    })
                    utility.stroke(hueCursor, Color3.new(0,0,0), 1)
                    hueCursor.Position = UDim2.new(0,-2, currentH, -3)

                    -- Alpha bar
                    alphaBar = utility.create("ImageButton", {
                        Size = UDim2.new(0,20,0,150), Position = UDim2.new(0,185,0,5),
                        BackgroundColor3 = Color3.new(1,1,1), Image = "rbxassetid://284402810",
                        BorderSizePixel = 0, ZIndex = 201, Parent = pickerFrame,
                    })
                    local alphaGrad = utility.create("UIGradient", {
                        Transparency = NumberSequence.new{
                            NumberSequenceKeypoint.new(0,0), NumberSequenceKeypoint.new(1,1)
                        }, Rotation = 90, Parent = alphaBar,
                    })
                    alphaCursor = utility.create("Frame", {
                        Size = UDim2.new(0,24,0,6), BackgroundColor3 = Color3.new(1,1,1),
                        BorderSizePixel = 0, ZIndex = 202, Parent = alphaBar,
                    })
                    utility.stroke(alphaCursor, Color3.new(0,0,0), 1)
                    alphaCursor.Position = UDim2.new(0,-2, 1-currentAlpha, -3)

                    local function updateColor()
                        local col = Color3.fromHSV(currentH, currentS, currentV)
                        -- Apply alpha? Not possible on Color3, but we store alpha in flag as {Color3, Alpha}
                        colorBtn.BackgroundColor3 = col
                        library.flags[flag] = {col, currentAlpha}
                        if callback then callback(col, currentAlpha) end
                    end

                    -- Update functions
                    local function updateSVFromHue()
                        svGrad.Color = ColorSequence.new{
                            ColorSequenceKeypoint.new(0, Color3.new(1,1,1)),
                            ColorSequenceKeypoint.new(1, Color3.fromHSV(currentH,1,1))
                        }
                        updateColor()
                    end
                    local svDragging, hueDragging, alphaDragging = false, false, false
                    svBox.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                            svDragging = true
                            local rx = (inp.Position.X - svBox.AbsolutePosition.X)/svBox.AbsoluteSize.X
                            local ry = (inp.Position.Y - svBox.AbsolutePosition.Y)/svBox.AbsoluteSize.Y
                            currentS = math.clamp(rx,0,1); currentV = 1-math.clamp(ry,0,1)
                            svCursor.Position = UDim2.new(currentS,-5,1-currentV,-5)
                            updateColor()
                        end
                    end)
                    hueBar.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                            hueDragging = true
                            local ry = (inp.Position.Y - hueBar.AbsolutePosition.Y)/hueBar.AbsoluteSize.Y
                            currentH = math.clamp(ry,0,1)
                            hueCursor.Position = UDim2.new(0,-2, currentH, -3)
                            updateSVFromHue()
                        end
                    end)
                    alphaBar.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                            alphaDragging = true
                            local ry = (inp.Position.Y - alphaBar.AbsolutePosition.Y)/alphaBar.AbsoluteSize.Y
                            currentAlpha = 1 - math.clamp(ry,0,1)
                            alphaCursor.Position = UDim2.new(0,-2, 1-currentAlpha, -3)
                            updateColor()
                        end
                    end)
                    userInput.InputChanged:Connect(function(inp)
                        if svDragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                            local rx = (inp.Position.X - svBox.AbsolutePosition.X)/svBox.AbsoluteSize.X
                            local ry = (inp.Position.Y - svBox.AbsolutePosition.Y)/svBox.AbsoluteSize.Y
                            currentS = math.clamp(rx,0,1); currentV = 1-math.clamp(ry,0,1)
                            svCursor.Position = UDim2.new(currentS,-5,1-currentV,-5)
                            updateColor()
                        elseif hueDragging then
                            local ry = (inp.Position.Y - hueBar.AbsolutePosition.Y)/hueBar.AbsoluteSize.Y
                            currentH = math.clamp(ry,0,1)
                            hueCursor.Position = UDim2.new(0,-2, currentH, -3)
                            updateSVFromHue()
                        elseif alphaDragging then
                            local ry = (inp.Position.Y - alphaBar.AbsolutePosition.Y)/alphaBar.AbsoluteSize.Y
                            currentAlpha = 1 - math.clamp(ry,0,1)
                            alphaCursor.Position = UDim2.new(0,-2, 1-currentAlpha, -3)
                            updateColor()
                        end
                    end)
                    userInput.InputEnded:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                            svDragging = false; hueDragging = false; alphaDragging = false
                        end
                    end)
                    -- close on outside click
                    local conn
                    conn = userInput.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 and pickerFrame then
                            local pos = userInput:GetMouseLocation()
                            if not (pickerFrame.AbsolutePosition.X <= pos.X and pos.X <= pickerFrame.AbsolutePosition.X + pickerFrame.AbsoluteSize.X
                                and pickerFrame.AbsolutePosition.Y <= pos.Y and pos.Y <= pickerFrame.AbsolutePosition.Y + pickerFrame.AbsoluteSize.Y) then
                                closePicker()
                                conn:Disconnect()
                            end
                        end
                    end)
                    updateColor()
                end
                colorBtn.MouseButton1Click:Connect(openPicker)
            end

            -- ========== KEYBIND (with modes) ==========
            function sectionActions:Keybind(text, flag, defaultKey, mode, callback)
                mode = mode or "Toggle"
                local frame = utility.create("Frame", {
                    Size = UDim2.new(1,0,0,55), BackgroundTransparency = 1, ZIndex = 6, Parent = itemsFrame,
                })
                utility.create("TextLabel", {
                    Size = UDim2.new(1,0,0,22), BackgroundTransparency = 1, Text = text,
                    TextColor3 = Color3.fromRGB(180,180,180), TextSize = 14,
                    Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7, Parent = frame,
                })
                local keyBtn = utility.create("TextButton", {
                    Size = UDim2.new(1,0,0,28), Position = UDim2.new(0,0,0,24),
                    BackgroundColor3 = Color3.fromRGB(25,25,25), BorderSizePixel = 0,
                    Text = defaultKey and defaultKey.Name or "None", TextColor3 = Color3.fromRGB(200,200,200),
                    TextSize = 14, Font = Enum.Font.Gotham, ZIndex = 7, Parent = frame,
                })
                utility.stroke(keyBtn, Color3.fromRGB(50,50,50), 1)
                utility.create("UICorner", { CornerRadius = UDim.new(0,8), Parent = keyBtn })
                local modeBtn = utility.create("TextButton", {
                    Size = UDim2.new(0,40,0,22), Position = UDim2.new(1,-45,0.5,-11),
                    BackgroundColor3 = Color3.fromRGB(30,30,30), BorderSizePixel = 0,
                    Text = mode, TextColor3 = Color3.fromRGB(200,200,200), TextSize = 11,
                    Font = Enum.Font.Gotham, ZIndex = 8, Parent = keyBtn,
                })
                utility.stroke(modeBtn, Color3.fromRGB(50,50,50), 1)
                utility.create("UICorner", { CornerRadius = UDim.new(0,6), Parent = modeBtn })
                local listening = false
                local currentKey = defaultKey
                local function updateMode()
                    if mode == "Toggle" then mode = "Hold" elseif mode == "Hold" then mode = "Always" else mode = "Toggle" end
                    modeBtn.Text = mode
                end
                modeBtn.MouseButton1Click:Connect(updateMode)
                keyBtn.MouseButton1Click:Connect(function()
                    if listening then return end
                    listening = true
                    keyBtn.Text = "..."
                    keyBtn.TextColor3 = library.accent
                    local conn
                    conn = userInput.InputBegan:Connect(function(inp, gpe)
                        if listening and not gpe and inp.KeyCode ~= Enum.KeyCode.Unknown then
                            currentKey = inp.KeyCode
                            keyBtn.Text = currentKey.Name
                            keyBtn.TextColor3 = Color3.fromRGB(200,200,200)
                            listening = false
                            conn:Disconnect()
                            library.flags[flag] = {key = currentKey, mode = mode}
                            if callback then callback(currentKey, mode) end
                        end
                    end)
                end)
                -- Handle key press for Hold/Always outside
                userInput.InputBegan:Connect(function(inp, gpe)
                    if gpe then return end
                    local data = library.flags[flag]
                    if data and data.key == inp.KeyCode then
                        if data.mode == "Toggle" then
                            library.flags[flag.."_state"] = not library.flags[flag.."_state"]
                        elseif data.mode == "Hold" then
                            library.flags[flag.."_state"] = true
                        elseif data.mode == "Always" then
                            library.flags[flag.."_state"] = true
                        end
                    end
                end)
                userInput.InputEnded:Connect(function(inp)
                    local data = library.flags[flag]
                    if data and data.key == inp.KeyCode then
                        if data.mode == "Hold" then library.flags[flag.."_state"] = false end
                    end
                end)
            end

