    utility.create("UICorner", { CornerRadius = UDim.new(0,12), Parent = mainBG })

    local topBar = utility.create("Frame", {
        Size = UDim2.new(1,0,0,60), BackgroundColor3 = Color3.fromRGB(20,20,20),
        BorderSizePixel = 0, ZIndex = 2, Parent = mainBG,
    })
    utility.create("UICorner", { CornerRadius = UDim.new(0,12), Parent = topBar })
    utility.create("Frame", {
        Size = UDim2.new(1,0,0,12), Position = UDim2.new(0,0,1,-12),
        BackgroundColor3 = Color3.fromRGB(20,20,20), BorderSizePixel = 0, ZIndex = 2, Parent = topBar,
    })
    utility.create("TextLabel", {
        Size = UDim2.new(0,200,1,0), Position = UDim2.new(0,20,0,0),
