                    utility.label(holderFrame, "  " .. text .. "  ", {
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Size = UDim2.new(0, 0, 1, 0),
                        AutomaticSize = Enum.AutomaticSize.X,
                        Position = UDim2.new(0.5, 0, 0.5, 0),
                        BackgroundColor3 = theme.container,
                        BackgroundTransparency = 0,
                        TextXAlignment = Enum.TextXAlignment.Center,
                        TextColor3 = theme.text,
                        TextSize = 13,
                        ZIndex = 7,
                    })
                end
                return holderFrame
            end
            sectionActions.Label = sectionActions.Divider

            ------------------------------------------------------------
            -- checkbox toggle
            ------------------------------------------------------------
            function sectionActions:Toggle(text, flag, defaultOrCallback, callback)
                local default, cb = false, nil
                if typeof(defaultOrCallback) == "boolean" then
                    default = defaultOrCallback
                    cb = callback
                elseif typeof(defaultOrCallback) == "function" then
                    cb = defaultOrCallback
                else
                    cb = callback
                end

                local enabled = default
                local row = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 18),
                    BackgroundTransparency = 1,
                    AutoButtonColor = false,
                    Text = "",
                    ZIndex = 6,
                    Parent = items,
                })

                local box = utility.create("Frame", {
                    Size = UDim2.new(0, 11, 0, 11),
                    Position = UDim2.new(0, 0, 0.5, -6),
                    BackgroundColor3 = theme.control,
                    BorderSizePixel = 0,
                    ZIndex = 7,
                    Parent = row,
                })
                utility.stroke(box, theme.controlOutline, 1)

                local check = utility.create("Frame", {
                    Size = UDim2.new(1, -4, 1, -4),
                    Position = UDim2.new(0, 2, 0, 2),
                    BackgroundColor3 = library.accent,
                    BackgroundTransparency = enabled and 0 or 1,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = box,
                })

                local textLabel = utility.label(row, text, {
                    AnchorPoint = Vector2.new(0, 0.5),
                    Size = UDim2.new(1, -60, 0, 16),
                    Position = UDim2.new(0, 18, 0.5, 0),
                    TextColor3 = enabled and theme.text or theme.dimText,
                    TextSize = 13,
                    ZIndex = 7,
                })

                local function set(value, fire)
                    enabled = value
                    utility.tween(check, { 0.12 }, { BackgroundTransparency = enabled and 0 or 1 })
                    utility.tween(textLabel, { 0.12 }, { TextColor3 = enabled and theme.text or theme.dimText })
                    library.flags[flag] = enabled
                    if fire ~= false and cb then
                        cb(enabled)
                    end
                end

                library.flags[flag] = enabled
                row.MouseButton1Click:Connect(function()
                    set(not enabled)
                end)

                local toggleObj = { Row = row }
                function toggleObj:Set(value)
                    set(value and true or false)
                end
                function toggleObj:Get()
                    return enabled
                end
                function toggleObj:ColorPicker(_, cpFlag, cpDefault, cpCallback)
                    return utility.colorpicker(row, cpFlag, cpDefault, cpCallback)
                end
                return toggleObj
            end

            ------------------------------------------------------------
            -- slider (label above, solid violet fill)
            ------------------------------------------------------------
            function sectionActions:Slider(text, flag, min, max, default, callback, suffix)
                local opts = {}
                if typeof(callback) == "table" then
                    opts = callback
                    callback = opts.callback
                    suffix = opts.suffix or suffix
                end
                suffix = suffix or ""
                local decimals = opts.decimals
                if decimals == nil then
                    decimals = (min % 1 == 0 and max % 1 == 0 and default % 1 == 0) and 0 or 2
                end

                local slider = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ZIndex = 6,
                    Parent = items,
                })

                local function fmt(value)
                    if decimals <= 0 then
                        return string.format("%d", value)
                    end
                    return string.format("%." .. decimals .. "f", value)
                end

                local label = utility.label(slider, text .. ": " .. fmt(default) .. suffix, {
                    Size = UDim2.new(1, 0, 0, 16),
                    TextColor3 = theme.text,
                    TextSize = 13,
                    ZIndex = 7,
                })

                local bg = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 14),
                    Position = UDim2.new(0, 0, 0, 18),
                    BackgroundColor3 = theme.control,
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Text = "",
                    ClipsDescendants = true,
                    ZIndex = 7,
                    Parent = slider,
                })
                utility.stroke(bg, theme.controlOutline, 1)

                local fill = utility.create("Frame", {
                    Size = UDim2.new(math.clamp((default - min) / (max - min), 0, 1), 0, 1, 0),
                    BackgroundColor3 = library.accent,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = bg,
                })
                utility.create("UIGradient", {
                    Color = utility.gradient(library.outline),
                    Rotation = 0,
                    Parent = fill,
                })

                local function setValue(value, fire)
                    value = math.clamp(utility.round(value, decimals), min, max)
                    fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
                    label.Text = text .. ": " .. fmt(value) .. suffix
                    library.flags[flag] = value
                    if fire ~= false and callback then
                        callback(value)
                    end
                end

                library.flags[flag] = default
                utility.draggableBar(bg, function(perc)
                    setValue(min + (max - min) * perc)
                end)

                return {
                    Set = function(_, value)
                        setValue(value)
                    end,
                }
            end

            ------------------------------------------------------------
            -- dropdown (single or multi select)
            ------------------------------------------------------------
            function sectionActions:Dropdown(text, flag, list, callbackOrMulti, callback)
                local multi, cb = false, nil
                if typeof(callbackOrMulti) == "boolean" then
                    multi = callbackOrMulti
                    cb = callback
                elseif typeof(callbackOrMulti) == "function" then
                    cb = callbackOrMulti
                else
                    cb = callback
                end
                list = list or {}

                local dropdown = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ZIndex = 6,
                    Parent = items,
                })

                utility.label(dropdown, text, {
                    Size = UDim2.new(1, 0, 0, 16),
                    TextColor3 = theme.text,
                    TextSize = 13,
                    ZIndex = 7,
                })

                local btn = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 20),
                    Position = UDim2.new(0, 0, 0, 18),
                    BackgroundColor3 = theme.control,
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Text = "",
                    ZIndex = 7,
                    Parent = dropdown,
                })
                utility.stroke(btn, theme.controlOutline, 1)

                local valueLabel = utility.label(btn, "Select...", {
                    Size = UDim2.new(1, -28, 1, 0),
                    Position = UDim2.new(0, 5, 0, 0),
                    TextColor3 = theme.text,
                    TextSize = 13,
                    ZIndex = 8,
                })

                -- square arrow button on the right, like the reference
                local arrowBox = utility.create("Frame", {
                    Size = UDim2.new(0, 16, 0, 16),
                    Position = UDim2.new(1, -18, 0.5, -8),
                    BackgroundColor3 = theme.titlebar,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = btn,
                })
                utility.stroke(arrowBox, theme.controlOutline, 1)
                utility.label(arrowBox, "▼", {
                    Size = UDim2.new(1, 0, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Center,
                    TextColor3 = theme.text,
                    TextSize = 11,
                    ZIndex = 9,
                })

                local rowHeight = 20
                local maxHeight = 160
                local contentHeight = #list * rowHeight
                local listFrame = utility.create("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    Position = UDim2.new(0, 0, 1, 2),
                    BackgroundColor3 = theme.control,
                    BorderSizePixel = 0,
                    Visible = false,
                    ScrollBarThickness = 4,
                    ScrollBarImageColor3 = Color3.fromRGB(110, 110, 110),
                    CanvasSize = UDim2.new(0, 0, 0, contentHeight),
                    ZIndex = 20,
                    Parent = btn,
                })
                utility.stroke(listFrame, theme.controlOutline, 1)
                utility.create("UIListLayout", {
                    Padding = UDim.new(0, 0),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Parent = listFrame,
                })

                local opened = false
                local function setOpen(state)
                    opened = state
                    listFrame.Visible = opened
                    listFrame.Size = opened and UDim2.new(1, 0, 0, math.min(contentHeight, maxHeight))
                        or UDim2.new(1, 0, 0, 0)
                    if opened then
                        listFrame.CanvasSize = UDim2.new(0, 0, 0, contentHeight)
                        listFrame.CanvasPosition = Vector2.new(0, 0)
                    end
                end
                btn.MouseButton1Click:Connect(function()
                    setOpen(not opened)
                end)

                local function makeItem()
                    local item = utility.create("TextButton", {
                        Size = UDim2.new(1, 0, 0, rowHeight),
                        BackgroundColor3 = theme.control,
                        BackgroundTransparency = 1,
                        BorderSizePixel = 0,
                        AutoButtonColor = false,
                        Text = "",
                        ZIndex = 21,
                        Parent = listFrame,
                    })
                    item.MouseEnter:Connect(function()
                        item.BackgroundColor3 = theme.hover
                        item.BackgroundTransparency = 0
                    end)
                    item.MouseLeave:Connect(function()
                        item.BackgroundTransparency = 1
                    end)
                    return item
                end

                if not multi then
                    for _, v in next, list do
                        local item = makeItem()
                        utility.label(item, tostring(v), {
                            Size = UDim2.new(1, -10, 1, 0),
                            Position = UDim2.new(0, 5, 0, 0),
                            TextColor3 = theme.dimText,
                            TextSize = 13,
                            ZIndex = 22,
                        })
                        item.MouseButton1Click:Connect(function()
                            valueLabel.Text = tostring(v)
                            setOpen(false)
                            library.flags[flag] = v
                            if cb then
                                cb(v)
                            end
                        end)
                    end
                else
                    local selected = library.flags[flag]
                    if typeof(selected) ~= "table" then
                        selected = {}
                        library.flags[flag] = selected
                    end

                    local function updateButtonText()
                        if #selected == 0 then
                            valueLabel.Text = "Select..."
                        elseif #selected <= 2 then
                            valueLabel.Text = table.concat(selected, ", ")
                        else
                            valueLabel.Text = #selected .. " selected"
                        end
                    end
                    updateButtonText()

                    for _, v in next, list do
                        local item = makeItem()
                        utility.label(item, tostring(v), {
                            Size = UDim2.new(1, -30, 1, 0),
                            Position = UDim2.new(0, 5, 0, 0),
                            TextColor3 = theme.dimText,
                            TextSize = 13,
                            ZIndex = 22,
                        })
                        local mark = utility.create("Frame", {
                            Size = UDim2.new(0, 8, 0, 8),
                            Position = UDim2.new(1, -16, 0.5, -4),
                            BackgroundColor3 = library.accent,
                            BorderSizePixel = 0,
                            Visible = table.find(selected, v) ~= nil,
                            ZIndex = 22,
                            Parent = item,
                        })
                        item.MouseButton1Click:Connect(function()
                            local idx = table.find(selected, v)
                            if idx then
                                table.remove(selected, idx)
                                mark.Visible = false
                            else
                                table.insert(selected, v)
                                mark.Visible = true
                            end
                            updateButtonText()
                            if cb then
                                cb(selected)
                            end
                        end)
                    end
                end

                return {
                    Set = function(_, value)
                        valueLabel.Text = tostring(value)
                        library.flags[flag] = value
                        if cb then
                            cb(value)
                        end
                    end,
                }
            end

            ------------------------------------------------------------
            -- textbox
            ------------------------------------------------------------
            function sectionActions:Textbox(text, flag, placeholder, callback)
                local frame = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ZIndex = 6,
                    Parent = items,
                })
                utility.label(frame, text, {
                    Size = UDim2.new(1, 0, 0, 16),
                    TextColor3 = theme.text,
                    TextSize = 13,
                    ZIndex = 7,
                })
                local box = utility.create("TextBox", {
                    Size = UDim2.new(1, 0, 0, 20),
                    Position = UDim2.new(0, 0, 0, 18),
                    BackgroundColor3 = theme.control,
                    BorderSizePixel = 0,
                    PlaceholderText = placeholder or "...",
                    PlaceholderColor3 = Color3.fromRGB(110, 110, 110),
                    Text = "",
                    TextColor3 = theme.text,
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false,
                    ZIndex = 7,
                    Parent = frame,
                })
                utility.stroke(box, theme.controlOutline, 1)
                utility.create("UIPadding", {
                    Parent = box,
                    PaddingLeft = UDim.new(0, 5),
                })
                box.FocusLost:Connect(function()
                    library.flags[flag] = box.Text
                    if callback then
                        callback(box.Text)
                    end
                end)
                return box
            end

            ------------------------------------------------------------
            -- button
            ------------------------------------------------------------
            function sectionActions:Button(text, callback)
                local btn = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 22),
                    BackgroundColor3 = theme.titlebar,
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Text = text,
                    TextColor3 = theme.text,
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    ZIndex = 6,
                    Parent = items,
                })
                utility.stroke(btn, theme.controlOutline, 1)
                btn.MouseEnter:Connect(function()
                    utility.tween(btn, { 0.12 }, { BackgroundColor3 = library.accent })
                end)
                btn.MouseLeave:Connect(function()
                    utility.tween(btn, { 0.12 }, { BackgroundColor3 = theme.titlebar })
                end)
                btn.MouseButton1Click:Connect(function()
                    if callback then
                        callback()
                    end
                end)
                return btn
            end

            ------------------------------------------------------------
            -- standalone color picker row
            ------------------------------------------------------------
            function sectionActions:ColorPicker(text, flag, default, callback)
                local row = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 18),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ZIndex = 6,
                    Parent = items,
                })
                utility.label(row, text, {
                    Size = UDim2.new(1, -34, 1, 0),
                    TextColor3 = theme.text,
                    TextSize = 13,
                    ZIndex = 7,
                })
                return utility.colorpicker(row, flag, default, callback)
            end

            return sectionActions
        end

        return tabActions
    end

    ------------------------------------------------------------------
    -- global search: hide groupboxes that don't match
    ------------------------------------------------------------------
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(searchBox.Text)

        if currentTab and currentTab.LeftCol and currentTab.RightCol then
            for _, col in ipairs({ currentTab.LeftCol, currentTab.RightCol }) do
                for _, child in ipairs(col:GetChildren()) do
                    if child.Name == "ZalSection" then
                        local title = child:FindFirstChild("SectionTitle")
                        local matched = (query == "")
                        if not matched and title then
                            matched = string.find(string.lower(title.Text), query, 1, true) ~= nil
                        end
                        child.Visible = matched
                    end
                end
                col.CanvasPosition = Vector2.new(0, 0)
            end

            task.delay(0.05, function()
                for _, col in ipairs({ currentTab.LeftCol, currentTab.RightCol }) do
                    local layout = col:FindFirstChildWhichIsA("UIListLayout")
                    if layout then
                        col.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 30)
                    end
                end
            end)
        end
    end)

    return windowActions
end

return libary
