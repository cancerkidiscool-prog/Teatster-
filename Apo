local function digMound(pos, entityID)
    local now = tick()
    if recentlyDug[entityID] and (now - recentlyDug[entityID] < 0.16) then return end
    recentlyDug[entityID] = now
    FirePacket(EncodeFirstDig(pos))
    task.wait(0.01)
    FirePacket(EncodeSecondDig(pos, entityID))
