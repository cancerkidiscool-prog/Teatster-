-- ==================== OV AUTO HEAL ====================
local OV_PacketsPerTick = 7
local OV_TargetCPS = 48
local OV_LoopDelay = OV_PacketsPerTick / OV_TargetCPS
local ovHealRunning = false

local function getFruitEntityID(fruitName)
    local success, PlayerData = pcall(function() return require(rs.Modules.GameUtil).Data end)
    if not success or not PlayerData.inventory then return nil end
    for _, item in pairs(PlayerData.inventory) do
        if item.name == fruitName and item.entityId then
            return item.entityId
        end
    end
    return nil
end

local function ovHealLoop()
    ovHealRunning = true
    while getgenv().ovAutoheal do
        pcall(function()
            if not lp or not lp.Character then return end
            local humanoid = lp.Character:FindFirstChild("Humanoid")
            if not humanoid or humanoid.Health >= humanoid.MaxHealth then return end
            local fruit = getgenv().ovFruitName
            local entityId = getFruitEntityID(fruit)
            if not entityId then return end
            local packet = EncodeOVHeal(entityId)
            FirePacket(packet)
            for _ = 1, OV_PacketsPerTick do FirePacket(packet) end
        end)
        task.wait(OV_LoopDelay)
    end
    ovHealRunning = false
end

task.spawn(function()
    while true do
        task.wait(0.05)
        if getgenv().ovAutoheal and not ovHealRunning then task.spawn(ovHealLoop) end
    end
end)

