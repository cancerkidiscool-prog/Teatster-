    card.BackgroundTransparency = 1
    Utility.tween(card, 0.3, {BackgroundTransparency = 0}, Enum.EasingStyle.Back)
    Utility.tween(progressFill, duration, {Size = UDim2.new(0, 0, 1, 0)}, Enum.EasingStyle.Linear)

    task.delay(duration, function()
        Utility.tween(card, 0.3, {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0)})
        task.wait(0.35)
        card:Destroy()
    end)
end

