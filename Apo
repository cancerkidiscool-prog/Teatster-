-- ==================== DYNAMIC PACKET LEARNING SYSTEM ====================
local LearnedTemplates = {}

-- Default templates (latest known from sniffed packets)
local DefaultTemplates = {
    harvest = {
        build = function(entityId)
            local b1 = entityId % 256
            local b2 = math.floor(entityId / 256) % 256
            local b3 = math.floor(entityId / 65536) % 256
            return string.char(0x00, 0x3B, b1, b2, b3, 0x45, 0x00)
        end
    },
    plant = {
        build = function(entityId, itemId)
            local b1 = entityId % 256
            local b2 = math.floor(entityId / 256) % 256
            local b3 = math.floor(entityId / 65536) % 256
            local i_low = itemId % 256
            local i_high = math.floor(itemId / 256) % 256
            return string.char(0x00, 0x60, b1, b2, b3, 0x00, i_low, i_high)
        end
    },
    drop = {
        build = function(slotId)
            return string.char(0x00, 0x42, slotId % 256, 0x00)
        end
    },
    heal = {
        build = function(entityId)
            local b1 = entityId % 256
            local b2 = math.floor(entityId / 256) % 256
            local b3 = math.floor(entityId / 65536) % 256
            return string.char(0x00, 0x3B, b1, b2, b3, 0x00)
        end
    },
    collect = {  -- cauldron collect
        build = function(entityId)
            local b1 = entityId % 256
            local b2 = math.floor(entityId / 256) % 256
            local b3 = math.floor(entityId / 65536) % 256
            return string.char(0x00, 0xCE, b1, b2, b3, 0x00)
        end
    }
}

-- Learning state
local LearningMode = { active = false, type = nil, captured = false }
local learningPacketBuffer = nil

-- Hook the remote to capture outgoing packets
local oldFireServer
if hookfunction then
    oldFireServer = hookfunction(ByteNetReliable.FireServer, function(self, ...)
        local args = {...}
        if args[1] and typeof(args[1]) == "buffer" then
