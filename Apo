-- MAIN WINDOW (CS:GO Settings Menu Style)
-- ════════════════════════════════════════════════════════════
function ZalHub:Window(opts)
    opts = opts or {}
    local title = opts.Title or "ZALHUB"
    local size = opts.Size or UDim2.new(0, 640, 0, 500)

    local gui = U.new("ScreenGui", {
        Name = "ZalHub_Main", Parent = CoreGui,
        ResetOnSpawn = false, DisplayOrder = 100
    })

    local main = U.new("Frame", {
        Size = size, Position = UDim2.new(0.5, -size.X.Offset/2, 0.5, -size.Y.Offset/2),
        BackgroundColor3 = ZalHub.theme.windowBg, BorderSizePixel = 0,
        Parent = gui
    })
    main.ClipsDescendants = true
    U.corner(main, 3)
    U.stroke(main, ZalHub.theme.borderDark, 2)

    -- ═══ HEADER BAR (CS:GO style with green accent line on top) ═══
    local header = U.new("Frame", {
        Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = ZalHub.theme.headerBg,
        BorderSizePixel = 0, ZIndex = 10, Parent = main
    })
    -- Top accent line
    U.new("Frame", {
        Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = ZalHub.accent,
        BorderSizePixel = 0, ZIndex = 11, Parent = header
    })
    -- Bottom border
    U.new("Frame", {
        Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1),
        BackgroundColor3 = ZalHub.theme.borderDark, BorderSizePixel = 0,
        ZIndex = 11, Parent = header
    })

    -- Title
    U.new("TextLabel", {
        Size = UDim2.new(0, 200, 1, 0), Position = UDim2.new(0, 10, 0, 2),
        BackgroundTransparency = 1, Text = title,
        TextColor3 = ZalHub.theme.text, TextSize = 13,
        Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 11, Parent = header
    })

    -- Close button
    local closeBtn = U.new("TextButton", {
        Size = UDim2.new(0, 30, 0, 30), Position = UDim2.new(1, -32, 0, 1),
        BackgroundTransparency = 1, Text = "✕",
        TextColor3 = ZalHub.theme.textDim, TextSize = 14,
        Font = Enum.Font.GothamBold, ZIndex = 12, Parent = header
    })
    closeBtn.MouseEnter:Connect(function() closeBtn.TextColor3 = ZalHub.theme.danger end)
    closeBtn.MouseLeave:Connect(function() closeBtn.TextColor3 = ZalHub.theme.textDim end)
    closeBtn.MouseButton1Click:Connect(function() gui.Enabled = false end)

    -- Minimize
    local minBtn = U.new("TextButton", {
        Size = UDim2.new(0, 30, 0, 30), Position = UDim2.new(1, -60, 0, 1),
        BackgroundTransparency = 1, Text = "—",
        TextColor3 = ZalHub.theme.textDim, TextSize = 14,
        Font = Enum.Font.GothamBold, ZIndex = 12, Parent = header
    })
    minBtn.MouseEnter:Connect(function() minBtn.TextColor3 = ZalHub.theme.text end)
    minBtn.MouseLeave:Connect(function() minBtn.TextColor3 = ZalHub.theme.textDim end)

    U.dragify(main, header)

    -- ═══ TAB BAR (CS:GO horizontal tabs at top) ═══
    local tabBar = U.new("Frame", {
        Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0, 32),
        BackgroundColor3 = ZalHub.theme.panelBg, BorderSizePixel = 0,
        ZIndex = 8, Parent = main
    })
    U.new("Frame", {
        Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1),
        BackgroundColor3 = ZalHub.theme.borderDark, BorderSizePixel = 0,
        ZIndex = 9, Parent = tabBar
    })

    local tabContainer = U.new("Frame", {
        Size = UDim2.new(1, -10, 1, 0), Position = UDim2.new(0, 5, 0, 0),
        BackgroundTransparency = 1, ZIndex = 9, Parent = tabBar
    })
    U.list(tabContainer, Enum.FillDirection.Horizontal, 0, nil, Enum.VerticalAlignment.Bottom)

    -- ═══ CONTENT AREA ═══
    local contentArea = U.new("Frame", {
        Size = UDim2.new(1, -16, 1, -68), Position = UDim2.new(0, 8, 0, 64),
        BackgroundTransparency = 1, ZIndex = 3, Parent = main
    })

    -- Toggle keybind
    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            gui.Enabled = not gui.Enabled
        end
    end)

    -- ════════════════════════════════════════════════════════════
    -- TAB SYSTEM
    -- ════════════════════════════════════════════════════════════
    local currentTab = nil
    local Window = {}

    function Window:Tab(tabName)
        local tabBtn = U.new("TextButton", {
            Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = ZalHub.theme.panelBg, BackgroundTransparency = 1,
            BorderSizePixel = 0, Text = "", ZIndex = 10, Parent = tabContainer
        })
        U.pad(tabBtn, 0, 0, 12, 12)

        local tabLabel = U.new("TextLabel", {
            Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1, Text = tabName:upper(),
            TextColor3 = ZalHub.theme.textDim, TextSize = 11,
            Font = Enum.Font.GothamBold, ZIndex = 11, Parent = tabBtn
        })

        -- Active bottom indicator
        local indicator = U.new("Frame", {
            Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2),
            BackgroundColor3 = ZalHub.accent, BorderSizePixel = 0,
            BackgroundTransparency = 1, ZIndex = 11, Parent = tabBtn
        })

        -- Tab content (two columns)
        local tabContent = U.new("Frame", {
            Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
            Visible = false, ZIndex = 4, Parent = contentArea
        })

        local leftCol = U.new("ScrollingFrame", {
            Size = UDim2.new(0.5, -4, 1, 0),
            BackgroundTransparency = 1, ScrollBarThickness = 3,
            ScrollBarImageColor3 = ZalHub.theme.scrollbar,
            ScrollBarImageTransparency = 0.2,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 5, Parent = tabContent
        })
        U.list(leftCol, nil, 6)
        U.pad(leftCol, 0, 6, 0, 3)

        local rightCol = U.new("ScrollingFrame", {
            Size = UDim2.new(0.5, -4, 1, 0), Position = UDim2.new(0.5, 4, 0, 0),
            BackgroundTransparency = 1, ScrollBarThickness = 3,
            ScrollBarImageColor3 = ZalHub.theme.scrollbar,
            ScrollBarImageTransparency = 0.2,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 5, Parent = tabContent
        })
        U.list(rightCol, nil, 6)
        U.pad(rightCol, 0, 6, 3, 0)

        -- Selection
        local function selectTab()
            if currentTab then
                currentTab.Content.Visible = false
                U.tween(currentTab.Label, 0.15, {TextColor3 = ZalHub.theme.textDim})
                U.tween(currentTab.Indicator, 0.15, {BackgroundTransparency = 1})
                U.tween(currentTab.Btn, 0.15, {BackgroundTransparency = 1})
            end
            tabContent.Visible = true
            U.tween(tabLabel, 0.15, {TextColor3 = ZalHub.theme.text})
            U.tween(indicator, 0.15, {BackgroundTransparency = 0})
            U.tween(tabBtn, 0.15, {BackgroundTransparency = 0.9, BackgroundColor3 = ZalHub.accent})
            currentTab = {Content = tabContent, Label = tabLabel, Indicator = indicator, Btn = tabBtn}
        end

        tabBtn.MouseButton1Click:Connect(selectTab)
        tabBtn.MouseEnter:Connect(function()
            if not currentTab or currentTab.Btn ~= tabBtn then
                U.tween(tabLabel, 0.1, {TextColor3 = ZalHub.theme.textSub})
            end
        end)
        tabBtn.MouseLeave:Connect(function()
            if not currentTab or currentTab.Btn ~= tabBtn then
                U.tween(tabLabel, 0.1, {TextColor3 = ZalHub.theme.textDim})
            end
        end)

        if not currentTab then selectTab() end

        -- ════════════════════════════════════════════════════════════
        -- GROUPBOX (CS:GO Panel Style)
        -- ════════════════════════════════════════════════════════════
        local Tab = {}
        local gIdx = 0

        function Tab:Group(name, side)
            side = side or "Left"
            local parent = side == "Left" and leftCol or rightCol
            gIdx = gIdx + 1

            local group = U.new("Frame", {
                Name = "Group_" .. name,
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = ZalHub.theme.panelBg, BorderSizePixel = 0,
                ZIndex = 6, LayoutOrder = gIdx, Parent = parent
            })
            U.corner(group, 3)
            U.stroke(group, ZalHub.theme.border, 1, 0.3)

            -- Header with title
            local hdr = U.new("Frame", {
                Size = UDim2.new(1, 0, 0, 24),
                BackgroundColor3 = ZalHub.theme.headerBg, BorderSizePixel = 0,
                ZIndex = 7, Parent = group
            })
            U.new("UICorner", {CornerRadius = UDim.new(0, 3), Parent = hdr})
            -- Square off bottom
            U.new("Frame", {
                Size = UDim2.new(1, 0, 0, 6), Position = UDim2.new(0, 0, 1, -6),
                BackgroundColor3 = ZalHub.theme.headerBg, BorderSizePixel = 0,
                ZIndex = 7, Parent = hdr
            })
            -- Bottom separator
            U.new("Frame", {
                Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1),
                BackgroundColor3 = ZalHub.theme.border, BorderSizePixel = 0,
                ZIndex = 8, Parent = hdr
            })

            U.new("TextLabel", {
                Size = UDim2.new(1, -12, 1, 0), Position = UDim2.new(0, 8, 0, 0),
                BackgroundTransparency = 1, Text = name,
                TextColor3 = ZalHub.theme.text, TextSize = 11,
                Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 8, Parent = hdr
            })

            -- Items
            local items = U.new("Frame", {
                Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 24),
                BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y,
                ZIndex = 7, Parent = group
            })
            U.list(items, nil, 0)
            U.pad(items, 4, 6, 8, 8)

            -- ════════════════════════════════════════════════════════════
            -- ELEMENTS
            -- ════════════════════════════════════════════════════════════
            local G = {}

            -- ═══ TOGGLE (CS:GO Checkbox) ═══
            function G:Toggle(opts)
                opts = opts or {}
                local text = opts.Text or "Option"
                local flag = opts.Flag or text
                local default = opts.Default or false
                local cb = opts.Callback
                local enabled = default
                ZalHub.flags[flag] = enabled

                local row = U.new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1,
                    BorderSizePixel = 0, Text = "", ZIndex = 8, Parent = items
                })

                -- CS:GO style checkbox (square, sharp corners)
                local box = U.new("Frame", {
                    Size = UDim2.new(0, 14, 0, 14),
                    Position = UDim2.new(0, 0, 0.5, -7),
                    BackgroundColor3 = enabled and ZalHub.accent or ZalHub.theme.inputBg,
                    BorderSizePixel = 0, ZIndex = 9, Parent = row
                })
                U.corner(box, 2)
                U.stroke(box, enabled and ZalHub.accent or ZalHub.theme.border, 1)

                local tick = U.new("TextLabel", {
                    Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
                    Text = "✓", TextColor3 = Color3.new(1, 1, 1),
                    TextSize = 11, Font = Enum.Font.GothamBold,
                    TextTransparency = enabled and 0 or 1,
                    ZIndex = 10, Parent = box
                })

                local lbl = U.new("TextLabel", {
                    Size = UDim2.new(1, -50, 1, 0), Position = UDim2.new(0, 20, 0, 0),
                    BackgroundTransparency = 1, Text = text,
                    TextColor3 = enabled and ZalHub.theme.text or ZalHub.theme.textSub,
                    TextSize = 11, Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9, Parent = row
                })

                -- Hover
                row.MouseEnter:Connect(function()
                    if not enabled then U.tween(lbl, 0.08, {TextColor3 = ZalHub.theme.text}) end
                end)
                row.MouseLeave:Connect(function()
                    if not enabled then U.tween(lbl, 0.08, {TextColor3 = ZalHub.theme.textSub}) end
                end)

                row.MouseButton1Click:Connect(function()
                    enabled = not enabled
                    ZalHub.flags[flag] = enabled
                    U.tween(box, 0.12, {BackgroundColor3 = enabled and ZalHub.accent or ZalHub.theme.inputBg})
                    U.tween(tick, 0.1, {TextTransparency = enabled and 0 or 1})
                    U.tween(lbl, 0.1, {TextColor3 = enabled and ZalHub.theme.text or ZalHub.theme.textSub})
                    local s = box:FindFirstChildOfClass("UIStroke")
                    if s then U.tween(s, 0.12, {Color = enabled and ZalHub.accent or ZalHub.theme.border}) end
                    if cb then cb(enabled) end
                end)

                -- Addon system (inline keybind/color)
                local addon = U.new("Frame", {
                    Size = UDim2.new(0, 0, 0, 16), AutomaticSize = Enum.AutomaticSize.X,
                    Position = UDim2.new(1, 0, 0.5, -8), AnchorPoint = Vector2.new(1, 0),
                    BackgroundTransparency = 1, ZIndex = 10, Parent = row
                })
                U.list(addon, Enum.FillDirection.Horizontal, 3, Enum.HorizontalAlignment.Right)

                local Obj = {}
                function Obj:Keybind(kOpts)
                    kOpts = kOpts or {}
                    local kFlag = kOpts.Flag or (flag .. "_key")
                    local kDefault = kOpts.Default or Enum.KeyCode.Unknown
                    ZalHub.flags[kFlag] = kDefault
                    local listening = false

                    local kBtn = U.new("TextButton", {
                        Size = UDim2.new(0, 44, 0, 16),
                        BackgroundColor3 = ZalHub.theme.inputBg, BorderSizePixel = 0,
                        Text = kDefault == Enum.KeyCode.Unknown and "[-]" or "[" .. kDefault.Name .. "]",
                        TextColor3 = ZalHub.theme.textDim, TextSize = 9,
                        Font = Enum.Font.RobotoMono, ZIndex = 11, Parent = addon
                    })
                    U.corner(kBtn, 2)
                    U.stroke(kBtn, ZalHub.theme.border, 1, 0.5)

                    kBtn.MouseButton1Click:Connect(function()
                        listening = true; kBtn.Text = "[...]"; kBtn.TextColor3 = ZalHub.accent
                    end)
                    UIS.InputBegan:Connect(function(input, gp)
                        if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                            listening = false
                            if input.KeyCode == Enum.KeyCode.Escape then
                                ZalHub.flags[kFlag] = Enum.KeyCode.Unknown; kBtn.Text = "[-]"
                            else
                                ZalHub.flags[kFlag] = input.KeyCode
                                kBtn.Text = "[" .. input.KeyCode.Name .. "]"
                            end
                            kBtn.TextColor3 = ZalHub.theme.textDim
                        elseif not listening and not gp and input.KeyCode == ZalHub.flags[kFlag] then
                            row.MouseButton1Click:Fire()
                        end
                    end)
                end

                function Obj:ColorPicker(cOpts)
                    cOpts = cOpts or {}
                    local cFlag = cOpts.Flag or (flag .. "_color")
                    local cDefault = cOpts.Default or Color3.new(1, 1, 1)
                    local cCb = cOpts.Callback
                    ZalHub.flags[cFlag] = cDefault

                    local cBtn = U.new("TextButton", {
                        Size = UDim2.new(0, 22, 0, 14),
                        BackgroundColor3 = cDefault, BorderSizePixel = 0,
                        Text = "", ZIndex = 11, Parent = addon
                    })
                    U.corner(cBtn, 2)
                    U.stroke(cBtn, ZalHub.theme.border, 1, 0.3)

                    local pickerOpen = false
                    local picker = U.new("Frame", {
                        Size = UDim2.new(0, 150, 0, 28),
                        Position = UDim2.new(0, 0, 1, 3),
                        BackgroundColor3 = ZalHub.theme.panelBg, BorderSizePixel = 0,
                        Visible = false, ZIndex = 50, Parent = cBtn
                    })
                    U.corner(picker, 3)
                    U.stroke(picker, ZalHub.theme.border, 1)

                    local hueBar = U.new("Frame", {
                        Size = UDim2.new(1, -10, 0, 14), Position = UDim2.new(0, 5, 0, 7),
                        BorderSizePixel = 0, ZIndex = 51, Parent = picker
                    })
                    U.corner(hueBar, 2)
                    local hueColors = {}
                    for i = 0, 6 do table.insert(hueColors, Color3.fromHSV(i/6, 1, 1)) end
                    U.new("UIGradient", {
                        Color = ColorSequence.new((function()
                            local kp = {}
                            for i, c in ipairs(hueColors) do
                                table.insert(kp, ColorSequenceKeypoint.new((i-1)/(#hueColors-1), c))
                            end
                            return kp
                        end)()),
                        Parent = hueBar
                    })

                    local hueHandle = U.new("TextButton", {
                        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
                        Text = "", ZIndex = 52, Parent = hueBar
                    })

                    local currentH = select(1, cDefault:ToHSV())
                    local hueDrag = false

                    hueHandle.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then hueDrag = true end
                    end)
                    UIS.InputChanged:Connect(function(input)
                        if hueDrag and input.UserInputType == Enum.UserInputType.MouseMovement then
                            local p = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
                            currentH = p
                            local c = Color3.fromHSV(currentH, 1, 1)
                            cBtn.BackgroundColor3 = c
                            ZalHub.flags[cFlag] = c
                            if cCb then cCb(c) end
                        end
                    end)
                    UIS.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then hueDrag = false end
                    end)

                    cBtn.MouseButton1Click:Connect(function()
                        pickerOpen = not pickerOpen; picker.Visible = pickerOpen
                    end)
                end

                return Obj
            end

            -- ═══ SLIDER (CS:GO style with numeric value box) ═══
            function G:Slider(opts)
                opts = opts or {}
                local text = opts.Text or "Value"
                local flag = opts.Flag or text
                local min = opts.Min or 0
                local max = opts.Max or 100
                local default = opts.Default or min
                local increment = opts.Increment or 1
                local suffix = opts.Suffix or ""
                local cb = opts.Callback
                ZalHub.flags[flag] = default

                local frame = U.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1,
                    ZIndex = 8, Parent = items
                })

                -- Label
                U.new("TextLabel", {
                    Size = UDim2.new(0.6, 0, 0, 14), Position = UDim2.new(0, 0, 0, 0),
                    BackgroundTransparency = 1, Text = text,
                    TextColor3 = ZalHub.theme.textSub, TextSize = 11,
                    Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 9, Parent = frame
                })

                -- Value box (CS:GO style editable number)
                local valBox = U.new("TextBox", {
                    Size = UDim2.new(0, 48, 0, 16),
                    Position = UDim2.new(1, -48, 0, 0),
                    BackgroundColor3 = ZalHub.theme.inputBg, BorderSizePixel = 0,
                    Text = tostring(default) .. suffix,
                    TextColor3 = ZalHub.accent, TextSize = 10,
                    Font = Enum.Font.RobotoMono, ZIndex = 9,
                    ClearTextOnFocus = true, Parent = frame
                })
                U.corner(valBox, 2)
                U.stroke(valBox, ZalHub.theme.border, 1, 0.5)

                -- Track
                local track = U.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 8), Position = UDim2.new(0, 0, 0, 20),
                    BackgroundColor3 = ZalHub.theme.inputBg, BorderSizePixel = 0,
                    ZIndex = 9, Parent = frame
                })
                U.corner(track, 2)
                U.stroke(track, ZalHub.theme.border, 1, 0.5)

                -- Fill
                local fill = U.new("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = ZalHub.accent, BorderSizePixel = 0,
                    ZIndex = 10, Parent = track
                })
                U.corner(fill, 2)

                -- Gradient on fill
                U.new("UIGradient", {
                    Color = ColorSequence.new(ZalHub.accentDim, ZalHub.accent),
                    Rotation = 0, Parent = fill
                })

                -- Thumb (CS:GO style notch)
                local thumb = U.new("Frame", {
                    Size = UDim2.new(0, 4, 0, 14),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0),
                    BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
                    ZIndex = 11, Parent = track
                })
                U.corner(thumb, 1)

                -- Drag area
                local dragBtn = U.new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0.5, -10),
                    BackgroundTransparency = 1, Text = "", ZIndex = 12, Parent = track
                })

                local function setValue(val)
                    val = math.clamp(val, min, max)
                    -- Round to increment
                    val = math.floor(val / increment + 0.5) * increment
                    val = tonumber(string.format("%.4g", val))
                    local perc = (val - min) / (max - min)
                    U.tween(fill, 0.06, {Size = UDim2.new(perc, 0, 1, 0)})
                    U.tween(thumb, 0.06, {Position = UDim2.new(perc, 0, 0.5, 0)})
                    valBox.Text = tostring(val) .. suffix
                    ZalHub.flags[flag] = val
                    if cb then cb(val) end
                end

                local dragging = false
                dragBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        local perc = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        setValue(min + (max - min) * perc)
                    end
                end)
                UIS.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        local perc = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        setValue(min + (max - min) * perc)
                    end
                end)
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                end)

                -- Manual input from value box
                valBox.FocusLost:Connect(function(enter)
                    if enter then
                        local num = tonumber(valBox.Text:gsub(suffix, ""))
                        if num then setValue(num) else valBox.Text = tostring(ZalHub.flags[flag]) .. suffix end
                    else
                        valBox.Text = tostring(ZalHub.flags[flag]) .. suffix
                    end
                end)
            end

            -- ═══ DROPDOWN (CS:GO Combo Box) ═══
            function G:Dropdown(opts)
                opts = opts or {}
                local text = opts.Text or "Select"
                local flag = opts.Flag or text
                local values = opts.Values or {}
                local default = opts.Default
                local multi = opts.Multi or false
                local cb = opts.Callback

                ZalHub.flags[flag] = multi and {} or (default or nil)

                local frame = U.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1,
                    ZIndex = 8, Parent = items
                })
                U.new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
                    Text = text, TextColor3 = ZalHub.theme.textSub,
                    TextSize = 11, Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9, Parent = frame
                })

                local btn = U.new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0, 16),
                    BackgroundColor3 = ZalHub.theme.inputBg, BorderSizePixel = 0,
                    Text = "", ZIndex = 9, Parent = frame
                })
                U.corner(btn, 2)
                U.stroke(btn, ZalHub.theme.border, 1, 0.3)

                local btnLbl = U.new("TextLabel", {
                    Size = UDim2.new(1, -24, 1, 0), Position = UDim2.new(0, 6, 0, 0),
                    BackgroundTransparency = 1, Text = default or "...",
                    TextColor3 = default and ZalHub.theme.text or ZalHub.theme.textDim,
                    TextSize = 11, Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 10, Parent = btn
                })
                local arrow = U.new("TextLabel", {
                    Size = UDim2.new(0, 18, 1, 0), Position = UDim2.new(1, -20, 0, 0),
                    BackgroundTransparency = 1, Text = "▾",
                    TextColor3 = ZalHub.theme.textDim, TextSize = 12,
                    Font = Enum.Font.GothamBold, ZIndex = 10, Parent = btn
                })

                local listFrame = U.new("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 1, 2),
                    BackgroundColor3 = ZalHub.theme.inputBg, BorderSizePixel = 0,
                    Visible = false, ZIndex = 40, ScrollBarThickness = 3,
                    ScrollBarImageColor3 = ZalHub.theme.scrollbar,
                    CanvasSize = UDim2.new(0, 0, 0, #values * 22),
                    Parent = btn
                })
                U.corner(listFrame, 2)
                U.stroke(listFrame, ZalHub.theme.border, 1, 0.3)
                U.list(listFrame, nil, 0)

                local opened = false
                btn.MouseButton1Click:Connect(function()
                    opened = not opened
                    listFrame.Visible = opened
                    local h = opened and math.min(#values * 22, 132) or 0
                    U.tween(listFrame, 0.15, {Size = UDim2.new(1, 0, 0, h)})
                    U.tween(arrow, 0.1, {Rotation = opened and 180 or 0})
                end)

                local function updateLabel()
                    if multi then
                        local sel = ZalHub.flags[flag]
                        if #sel == 0 then btnLbl.Text = "..."; btnLbl.TextColor3 = ZalHub.theme.textDim
                        elseif #sel <= 2 then btnLbl.Text = table.concat(sel, ", "); btnLbl.TextColor3 = ZalHub.theme.text
                        else btnLbl.Text = #sel .. " selected"; btnLbl.TextColor3 = ZalHub.theme.text end
                    end
                end

                for _, v in ipairs(values) do
                    local item = U.new("TextButton", {
                        Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = ZalHub.theme.inputBg,
                        BackgroundTransparency = 1, BorderSizePixel = 0,
                        Text = "", ZIndex = 41, Parent = listFrame
                    })
                    local itemLbl = U.new("TextLabel", {
                        Size = UDim2.new(1, -24, 1, 0), Position = UDim2.new(0, 6, 0, 0),
                        BackgroundTransparency = 1, Text = v,
                        TextColor3 = ZalHub.theme.textSub, TextSize = 11,
                        Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 42, Parent = item
                    })
                    local chk = U.new("TextLabel", {
                        Size = UDim2.new(0, 14, 1, 0), Position = UDim2.new(1, -18, 0, 0),
                        BackgroundTransparency = 1, Text = "✓",
                        TextColor3 = ZalHub.accent, TextSize = 11,
                        Font = Enum.Font.GothamBold, Visible = (not multi and default == v),
                        ZIndex = 42, Parent = item
                    })

                    item.MouseEnter:Connect(function()
                        U.tween(item, 0.08, {BackgroundTransparency = 0.3, BackgroundColor3 = ZalHub.theme.elementHover})
                        itemLbl.TextColor3 = ZalHub.theme.text
                    end)
                    item.MouseLeave:Connect(function()
                        U.tween(item, 0.08, {BackgroundTransparency = 1})
                        itemLbl.TextColor3 = ZalHub.theme.textSub
                    end)

                    item.MouseButton1Click:Connect(function()
                        if not multi then
                            btnLbl.Text = v; btnLbl.TextColor3 = ZalHub.theme.text
                            ZalHub.flags[flag] = v
                            -- Hide all checks, show this one
                            for _, c in ipairs(listFrame:GetDescendants()) do
                                if c.Name == "TextLabel" and c.Text == "✓" then c.Visible = false end
                            end
                            chk.Visible = true
                            opened = false; listFrame.Visible = false
                            U.tween(listFrame, 0.15, {Size = UDim2.new(1, 0, 0, 0)})
                            U.tween(arrow, 0.1, {Rotation = 0})
                            if cb then cb(v) end
                        else
                            local sel = ZalHub.flags[flag]
                            local idx = table.find(sel, v)
                            if idx then table.remove(sel, idx); chk.Visible = false
                            else table.insert(sel, v); chk.Visible = true end
                            updateLabel()
                            if cb then cb(sel) end
                        end
                    end)
                end
            end

            -- ═══ TEXTBOX ═══
            function G:Input(opts)
                opts = opts or {}
                local text = opts.Text or "Input"
                local flag = opts.Flag or text
                local placeholder = opts.Placeholder or "..."
                local cb = opts.Callback
                ZalHub.flags[flag] = ""

                local frame = U.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1,
                    ZIndex = 8, Parent = items
                })
                U.new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
                    Text = text, TextColor3 = ZalHub.theme.textSub,
                    TextSize = 11, Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9, Parent = frame
                })
                local box = U.new("TextBox", {
                    Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0, 16),
                    BackgroundColor3 = ZalHub.theme.inputBg, BorderSizePixel = 0,
                    Text = "", PlaceholderText = placeholder,
                    PlaceholderColor3 = ZalHub.theme.textDim,
                    TextColor3 = ZalHub.theme.text, TextSize = 11,
                    Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false, ZIndex = 9, Parent = frame
                })
                U.corner(box, 2)
                local bxStroke = U.stroke(box, ZalHub.theme.border, 1, 0.3)
                U.pad(box, 0, 0, 6, 6)

                box.Focused:Connect(function() U.tween(bxStroke, 0.1, {Color = ZalHub.accent, Transparency = 0}) end)
                box.FocusLost:Connect(function()
                    U.tween(bxStroke, 0.1, {Color = ZalHub.theme.border, Transparency = 0.3})
                    ZalHub.flags[flag] = box.Text
                    if cb then cb(box.Text) end
                end)
            end

            -- ═══ BUTTON ═══
            function G:Button(opts)
                opts = opts or {}
                local text = opts.Text or "Execute"
                local cb = opts.Callback
                local confirm = opts.Confirm or false

                local btn = U.new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24),
                    BackgroundColor3 = ZalHub.theme.elementBg, BorderSizePixel = 0,
                    Text = text, TextColor3 = ZalHub.theme.text,
                    TextSize = 11, Font = Enum.Font.GothamSemibold,
                    ZIndex = 8, Parent = items
                })
                U.corner(btn, 2)
                U.stroke(btn, ZalHub.theme.border, 1, 0.3)
                U.hover(btn, ZalHub.theme.elementBg, ZalHub.theme.elementHover)

                -- Click flash
                btn.MouseButton1Click:Connect(function()
                    if confirm then
                        if btn.Text == "CONFIRM?" then
                            btn.Text = text; btn.TextColor3 = ZalHub.theme.text
                            if cb then cb() end
                        else
                            btn.Text = "CONFIRM?"; btn.TextColor3 = ZalHub.theme.danger
                            task.delay(2, function()
                                if btn.Text == "CONFIRM?" then
                                    btn.Text = text; btn.TextColor3 = ZalHub.theme.text
                                end
                            end)
                        end
                        return
                    end
                    -- Flash green
                    U.tween(btn, 0.05, {BackgroundColor3 = ZalHub.accent})
                    task.delay(0.1, function() U.tween(btn, 0.15, {BackgroundColor3 = ZalHub.theme.elementBg}) end)
                    if cb then cb() end
                end)
            end

            -- ═══ KEYBIND (standalone) ═══
            function G:Keybind(opts)
                opts = opts or {}
                local text = opts.Text or "Bind"
                local flag = opts.Flag or text
                local default = opts.Default or Enum.KeyCode.Unknown
                local cb = opts.Callback
                ZalHub.flags[flag] = default
                local listening = false

                local row = U.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1,
                    ZIndex = 8, Parent = items
                })
                U.new("TextLabel", {
                    Size = UDim2.new(1, -55, 1, 0), BackgroundTransparency = 1,
                    Text = text, TextColor3 = ZalHub.theme.textSub,
                    TextSize = 11, Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9, Parent = row
                })
                local kBtn = U.new("TextButton", {
                    Size = UDim2.new(0, 50, 0, 16), Position = UDim2.new(1, -50, 0.5, -8),
                    BackgroundColor3 = ZalHub.theme.inputBg, BorderSizePixel = 0,
                    Text = default == Enum.KeyCode.Unknown and "[-]" or "[" .. default.Name .. "]",
                    TextColor3 = ZalHub.theme.textDim, TextSize = 9,
                    Font = Enum.Font.RobotoMono, ZIndex = 9, Parent = row
                })
                U.corner(kBtn, 2)
                U.stroke(kBtn, ZalHub.theme.border, 1, 0.5)

                kBtn.MouseButton1Click:Connect(function()
                    listening = true; kBtn.Text = "[...]"; kBtn.TextColor3 = ZalHub.accent
                end)
                UIS.InputBegan:Connect(function(input, gp)
                    if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                        listening = false
                        if input.KeyCode == Enum.KeyCode.Escape then
                            ZalHub.flags[flag] = Enum.KeyCode.Unknown; kBtn.Text = "[-]"
                        else
                            ZalHub.flags[flag] = input.KeyCode; kBtn.Text = "[" .. input.KeyCode.Name .. "]"
                        end
                        kBtn.TextColor3 = ZalHub.theme.textDim
                    elseif not listening and not gp and input.KeyCode == ZalHub.flags[flag] then
                        if cb then cb() end
                    end
                end)
            end

            -- ═══ SEPARATOR ═══
            function G:Separator()
                U.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 8), BackgroundTransparency = 1,
                    ZIndex = 8, Parent = items
                })
                U.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 0.5, 0),
                    BackgroundColor3 = ZalHub.theme.separator, BorderSizePixel = 0,
                    ZIndex = 9, Parent = items
                })
            end

            -- ═══ LABEL ═══
            function G:Label(txt)
                U.new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1,
                    Text = txt, TextColor3 = ZalHub.theme.textDim,
                    TextSize = 10, Font = Enum.Font.Gotham, TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 8, Parent = items
                })
            end

            return G
        end

        return Tab
    end

    return Window
end

function ZalHub:Destroy()
    ZalHub.unloaded = true
    for _, g in ipairs(CoreGui:GetChildren()) do
        if g.Name:find("ZalHub") then g:Destroy() end
    end
end

return ZalHub
