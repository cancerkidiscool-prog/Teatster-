            Size = UDim2.new(1, 0, 0, 2),
            Position = UDim2.new(0, 0, 1, -3),
            BackgroundColor3 = library.accent,
            BorderSizePixel = 0,
            BackgroundTransparency = 1,
            ZIndex = 5,
            Parent = tabBtn,
        })

