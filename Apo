            -- SLIDER
            function api:Slider(text, flag, min, max, default, callback)
                local frame = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 44),
                    BackgroundTransparency = 1,
                    ZIndex = 7,
                    Parent = items
                })
                
                create("TextLabel", {
                    Size = UDim2.new(0.55, 0, 0, 16),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(185, 185, 198),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 8,
                    Parent = frame
                })
                
                local valText = create("TextLabel", {
                    Size = UDim2.new(0.45, 0, 0, 16),
                    Position = UDim2.new(0.55, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text = string.format("%.2f / %.2f", default, max),
                    TextColor3 = Color3.fromRGB(120, 120, 140),
                    TextSize = 11,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    ZIndex = 8,
                    Parent = frame
                })
                
                local barBg = create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 6),
                    Position = UDim2.new(0, 0, 0, 24),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 35),
                    Text = "",
                    ZIndex = 8,
                    Parent = frame
                })
                addCorner(barBg, 3)
                barBg.ClipsDescendants = true
                
                local fill = create("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = library.accent,
                    BorderSizePixel = 0,
                    ZIndex = 9,
                    Parent = barBg
                })
                addCorner(fill, 3)
                create("UIGradient", {
                    Color = makeGradient(library.outline),
                    Parent = fill
                })
                
                -- thumb
                local thumb = create("Frame", {
                    Size = UDim2.new(0, 12, 0, 12),
                    Position = UDim2.new((default - min) / (max - min), -6, 0, 21),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    ZIndex = 10,
                    Parent = frame
                })
                addCorner(thumb, 6)
                
                library.flags[flag] = default
                
                local sliding = false
                local function doSlide(input)
                    local pct = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
                    local val = min + (max - min) * pct
                    val = tonumber(string.format("%.2f", val))
                    fill.Size = UDim2.new(pct, 0, 1, 0)
                    thumb.Position = UDim2.new(pct, -6, 0, 21)
                    valText.Text = string.format("%.2f / %.2f", val, max)
                    library.flags[flag] = val
                    if callback then callback(val) end
                end
                
                barBg.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        doSlide(input)
                    end
                end)
                uis.InputChanged:Connect(function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        doSlide(input)
                    end
                end)
                uis.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)
            end
            
