                    ScrollBarImageColor3 = Color3.fromRGB(60, 60, 60),
                    ScrollBarImageTransparency = 0.5,
                    CanvasSize = UDim2.new(1, 0, 0, contentHeight),
                    Parent = dropBtn
                })
                
                util.addStroke(dropdownList, Color3.fromRGB(50, 50, 50), 1)
                util.new("UIListLayout", {
                    Padding = UDim.new(0, 2),
                    Parent = dropdownList
                })
                
                local opened = false
                
                dropBtn.MouseButton1Click:Connect(function()
                    opened = not opened
                    dropdownList.Visible = opened
                    
                    if opened then
                        dropdownList.Size = UDim2.new(1, 0, 0, math.min(contentHeight, maxHeight))
                        dropdownList.CanvasSize = UDim2.new(1, 0, 0, contentHeight)
                        dropdownList.CanvasPosition = Vector2.new(0, 0)
                    else
                        dropdownList.Size = UDim2.new(1, 0, 0, 0)
                    end
                end)
                
                if not multi then
                    for _, v in next, list do
                        local item = util.new("TextButton", {
                            Size = UDim2.new(1, 0, 0, 24),
                            BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                            BorderSizePixel = 0,
                            Text = v,
                            TextColor3 = Color3.fromRGB(160, 160, 160),
                            TextSize = 14,
                            Font = Enum.Font.Code,
                            ZIndex = 12,
                            Parent = dropdownList
                        })
                        
                        item.MouseButton1Click:Connect(function()
                            dropBtn.Text = v
                            opened = false
                            dropdownList.Visible = false
                            dropdownList.Size = UDim2.new(1, 0, 0, 0)
                            lib.flags[flag] = v
                            if cb then cb(v) end
                        end)
                    end
                else
                    local selected = lib.flags[flag]
                    if not selected or typeof(selected) ~= "table" then
                        selected = {}
                        lib.flags[flag] = selected
                    end
                    
                    local function updateBtnText()
                        if #selected == 0 then
                            dropBtn.Text = "Select..."
                        elseif #selected == 1 then
                            dropBtn.Text = selected[1]
                        elseif #selected <= 3 then
                            dropBtn.Text = table.concat(selected, ", ")
                        else
                            dropBtn.Text = #selected .. " selected"
                        end
                    end
                    updateBtnText()
                    
                    for _, v in next, list do
                        local item = util.new("TextButton", {
                            Size = UDim2.new(1, 0, 0, 24),
                            BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                            BorderSizePixel = 0,
                            Text = "",
                            TextColor3 = Color3.fromRGB(160, 160, 160),
                            TextSize = 14,
                            Font = Enum.Font.Code,
                            ZIndex = 12,
                            Parent = dropdownList
                        })
                        
                        util.new("TextLabel", {
                            Size = UDim2.new(1, -30, 1, 0),
                            Position = UDim2.new(0, 5, 0, 0),
                            BackgroundTransparency = 1,
                            Text = v,
                            TextColor3 = Color3.fromRGB(160, 160, 160),
                            TextSize = 14,
                            Font = Enum.Font.Code,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 13,
                            Parent = item
                        })
                        
                        local checkmark = util.new("TextLabel", {
                            Size = UDim2.new(0, 20, 1, 0),
                            Position = UDim2.new(1, -25, 0, 0),
                            BackgroundTransparency = 1,
                            Text = "✔",
                            TextColor3 = lib.accent,
                            TextSize = 14,
                            Font = Enum.Font.Code,
                            TextXAlignment = Enum.TextXAlignment.Center,
                            ZIndex = 13,
                            Parent = item
                        })
                        checkmark.Visible = table.find(selected, v) ~= nil
                        
                        item.MouseButton1Click:Connect(function()
                            local idx = table.find(selected, v)
                            if idx then
                                table.remove(selected, idx)
                                checkmark.Visible = false
                            else
                                table.insert(selected, v)
                                checkmark.Visible = true
                            end
                            updateBtnText()
                            if cb then cb(selected) end
                        end)
                    end
                end
            end
            
            function sectionFuncs:addSlider(text, flag, min, max, default, callback)
                local sliderHolder = util.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundTransparency = 1,
                    ZIndex = 6,
                    Parent = itemHolder
                })
                
                util.new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(180, 180, 180),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 7,
                    Parent = sliderHolder
                })
                
                local sliderArea = util.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 20),
                    Position = UDim2.new(0, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Parent = sliderHolder
                })
                
                local sliderBg = util.new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 20),
                    Position = UDim2.new(0, 0, 0.5, -10),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    Text = "",
                    ZIndex = 7,
                    Parent = sliderArea
                })
                
                util.addStroke(sliderBg, Color3.fromRGB(50, 50, 50), 1)
                sliderBg.ClipsDescendants = true
                
                local fillBar = util.new("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = lib.accent,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = sliderBg
                })
                
                util.new("UIGradient", {
                    Color = util.makeGradient(lib.outline),
                    Rotation = 0,
                    Parent = fillBar
                })
                
                local valueLabel = util.new("TextLabel", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Size = UDim2.new(1, 0, 1, 0),
                    Position = UDim2.new(0.5, 0, 0.5, 0),
                    BackgroundTransparency = 1,
                    Text = string.format("%.2f/%.2f", default, max),
                    TextColor3 = Color3.fromRGB(255, 255, 255),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    ZIndex = 9,
                    Parent = sliderBg
                })
                
                local function updateSlider(input)
                    local perc = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
                    local rawValue = min + (max - min) * perc
                    local value = tonumber(string.format("%.2f", rawValue))
                    
                    util.tween(fillBar, {0.1}, {Size = UDim2.new(perc, 0, 1, 0)})
                    valueLabel.Text = string.format("%.2f/%.2f", value, max)
                    lib.flags[flag] = value
                    
                    if callback then callback(value) end
                end
                
                local dragging = false
                
                sliderBg.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        updateSlider(input)
                    end
                end)
                
                svcs.UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        updateSlider(input)
                    end
                end)
                
                svcs.UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
            end
            
            function sectionFuncs:addButton(text, callback)
                local button = util.new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    BorderSizePixel = 0,
                    Text = text,
                    TextColor3 = Color3.fromRGB(200, 200, 200),
                    TextSize = 14,
                    Font = Enum.Font.Code,
                    ZIndex = 6,
                    Parent = itemHolder
                })
                
                util.addStroke(button, Color3.fromRGB(50, 50, 50), 1)
                util.new("UICorner", {CornerRadius = UDim.new(0, 6), Parent = button})
                
                button.MouseButton1Click:Connect(function()
                    if callback then callback() end
                end)
            end
            
            return sectionFuncs
        end
        
        return tabFuncs
    end
    
    searchInput:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(searchInput.Text)
        
        if activeTab and activeTab.LeftCol and activeTab.RightCol then
            local cols = {activeTab.LeftCol, activeTab.RightCol}
            
            for _, col in ipairs(cols) do
                for _, child in ipairs(col:GetChildren()) do
                    if child.Name == "ZalSection" then
                        local title = child:FindFirstChildWhichIsA("TextLabel")
                        if title then
                            local match = (query == "") or string.find(string.lower(title.Text), query, 1, true)
                            child.Visible = match
                        end
                    end
                end
                
                col.CanvasPosition = Vector2.new(0, 0)
            end
            
            task.delay(0.05, function()
                if activeTab.LeftCol then
                    local leftList = activeTab.LeftCol:FindFirstChild("UIListLayout")
                    if leftList then
                        activeTab.LeftCol.CanvasSize = UDim2.new(0, 0, 0, leftList.AbsoluteContentSize.Y + 20)
                    end
                end
                if activeTab.RightCol then
                    local rightList = activeTab.RightCol:FindFirstChild("UIListLayout")
                    if rightList then
                        activeTab.RightCol.CanvasSize = UDim2.new(0, 0, 0, rightList.AbsoluteContentSize.Y + 20)
                    end
                end
            end)
        end
    end)
    
    return windowFuncs
end

return lib
