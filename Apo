                -- Label
                local label = Utility.new("TextLabel", {
                    Size = UDim2.new(1, -70, 1, 0),
                    Position = UDim2.new(0, 26, 0, 0),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = enabled and Library.theme.text or Library.theme.textDim,
                    TextSize = 12,
                    Font = Library.fontBody,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 8,
                    Parent = row
                })

                -- Hover effect
                row.MouseEnter:Connect(function()
                    Utility.tween(row, 0.1, {BackgroundTransparency = 0.5, BackgroundColor3 = Library.theme.elementHover})
                end)
                row.MouseLeave:Connect(function()
                    Utility.tween(row, 0.1, {BackgroundTransparency = 1})
                end)

                -- Click
                row.MouseButton1Click:Connect(function()
                    enabled = not enabled
                    Library.flags[flag] = enabled
                    Utility.tween(checkbox, 0.2, {BackgroundColor3 = enabled and Library.accent or Library.theme.element})
                    Utility.tween(checkmark, 0.15, {TextTransparency = enabled and 0 or 1})
                    Utility.tween(label, 0.15, {TextColor3 = enabled and Library.theme.text or Library.theme.textDim})
                    local s = checkbox:FindFirstChildOfClass("UIStroke")
                    if s then Utility.tween(s, 0.2, {Color = enabled and Library.accent or Library.theme.borderLight}) end
                    if callback then callback(enabled) end
                end)

                -- Addon holder (for keybind/colorpicker inline)
                local addonHolder = Utility.new("Frame", {
                    Size = UDim2.new(0, 0, 0, 20),
                    Position = UDim2.new(1, -4, 0.5, -10),
                    AnchorPoint = Vector2.new(1, 0),
                    BackgroundTransparency = 1,
                    AutomaticSize = Enum.AutomaticSize.X,
                    ZIndex = 9,
                    Parent = row
                })
                Utility.list(addonHolder, Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Right)

                local ToggleObj = {Row = row, AddonHolder = addonHolder, Flag = flag}

                -- Inline Keybind addon
                function ToggleObj:Keybind(kOpts)
                    kOpts = kOpts or {}
                    local kDefault = kOpts.Default or Enum.KeyCode.Unknown
                    local kFlag = kOpts.Flag or (flag .. "_keybind")
                    local kCallback = kOpts.Callback
                    Library.flags[kFlag] = kDefault

                    local kBtn = Utility.new("TextButton", {
                        Size = UDim2.new(0, 50, 0, 18),
                        BackgroundColor3 = Library.theme.element,
                        BorderSizePixel = 0,
                        Text = kDefault == Enum.KeyCode.Unknown and "[None]" or "[" .. kDefault.Name .. "]",
                        TextColor3 = Library.theme.textMuted,
                        TextSize = 10,
                        Font = Library.fontMono,
                        ZIndex = 10,
                        Parent = addonHolder
                    })
                    Utility.corner(kBtn, 4)
                    Utility.stroke(kBtn, Library.theme.border, 1, 0.5)

                    local listening = false
                    kBtn.MouseButton1Click:Connect(function()
                        listening = true
                        kBtn.Text = "[...]"
                        kBtn.TextColor3 = Library.accent
                    end)

                    UIS.InputBegan:Connect(function(input, gp)
                        if not listening then
                            -- Trigger toggle on keybind press
                            if input.KeyCode == Library.flags[kFlag] and not gp then
                                row.MouseButton1Click:Fire()
                            end
                            return
                        end
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            listening = false
                            if input.KeyCode == Enum.KeyCode.Escape then
                                Library.flags[kFlag] = Enum.KeyCode.Unknown
                                kBtn.Text = "[None]"
                            else
                                Library.flags[kFlag] = input.KeyCode
                                kBtn.Text = "[" .. input.KeyCode.Name .. "]"
                            end
                            kBtn.TextColor3 = Library.theme.textMuted
                            if kCallback then kCallback(Library.flags[kFlag]) end
                        end
                    end)
                end

                -- Inline ColorPicker addon
                function ToggleObj:ColorPicker(cOpts)
                    cOpts = cOpts or {}
                    local cDefault = cOpts.Default or Color3.fromRGB(255, 255, 255)
                    local cFlag = cOpts.Flag or (flag .. "_color")
                    local cCallback = cOpts.Callback
                    Library.flags[cFlag] = cDefault

                    local colorBtn = Utility.new("TextButton", {
                        Size = UDim2.new(0, 24, 0, 16),
                        BackgroundColor3 = cDefault,
                        BorderSizePixel = 0,
                        Text = "",
                        ZIndex = 10,
                        Parent = addonHolder
                    })
                    Utility.corner(colorBtn, 4)
                    Utility.stroke(colorBtn, Library.theme.border, 1, 0.3)

                    -- Simple hue picker popup
                    local pickerVisible = false
                    local pickerFrame = Utility.new("Frame", {
                        Size = UDim2.new(0, 160, 0, 80),
                        Position = UDim2.new(0, 0, 1, 4),
                        BackgroundColor3 = Library.theme.groupbox,
                        BorderSizePixel = 0,
                        Visible = false,
                        ZIndex = 50,
                        Parent = colorBtn
                    })
                    Utility.corner(pickerFrame, 6)
                    Utility.stroke(pickerFrame, Library.theme.border, 1, 0.3)

                    -- Saturation/Value canvas
                    local svCanvas = Utility.new("Frame", {
                        Size = UDim2.new(1, -12, 0, 50),
                        Position = UDim2.new(0, 6, 0, 6),
                        BackgroundColor3 = Color3.new(1, 0, 0),
                        BorderSizePixel = 0,
                        ZIndex = 51,
                        Parent = pickerFrame
                    })
                    Utility.corner(svCanvas, 4)

                    -- White to transparent gradient (saturation)
                    Utility.new("UIGradient", {
                        Color = ColorSequence.new(Color3.new(1,1,1), Color3.new(1,1,1)),
                        Transparency = NumberSequence.new({
                            NumberSequenceKeypoint.new(0, 0),
                            NumberSequenceKeypoint.new(1, 1)
                        }),
                        Parent = svCanvas
                    })

                    -- Hue bar
                    local hueBar = Utility.new("Frame", {
                        Size = UDim2.new(1, -12, 0, 12),
                        Position = UDim2.new(0, 6, 0, 62),
                        BorderSizePixel = 0,
                        ZIndex = 51,
                        Parent = pickerFrame
                    })
                    Utility.corner(hueBar, 3)
                    local hueColors = {}
                    for i = 0, 6 do table.insert(hueColors, Color3.fromHSV(i/6, 1, 1)) end
                    Utility.new("UIGradient", {
                        Color = Utility.gradient(hueColors),
                        Parent = hueBar
                    })

                    local hueBtn = Utility.new("TextButton", {
                        Size = UDim2.new(1, 0, 1, 0),
                        BackgroundTransparency = 1,
                        Text = "",
                        ZIndex = 52,
                        Parent = hueBar
                    })

                    local currentH, currentS, currentV = cDefault:ToHSV()

                    local hueDragging = false
                    hueBtn.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then hueDragging = true end
                    end)
                    UIS.InputChanged:Connect(function(input)
                        if hueDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                            local perc = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
                            currentH = perc
                            local c = Color3.fromHSV(currentH, currentS, currentV)
                            colorBtn.BackgroundColor3 = c
                            svCanvas.BackgroundColor3 = Color3.fromHSV(currentH, 1, 1)
                            Library.flags[cFlag] = c
                            if cCallback then cCallback(c) end
                        end
                    end)
                    UIS.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then hueDragging = false end
                    end)

                    colorBtn.MouseButton1Click:Connect(function()
                        pickerVisible = not pickerVisible
                        pickerFrame.Visible = pickerVisible
                    end)
                end

                return ToggleObj
            end

            -- ---- SLIDER ----
            function Groupbox:Slider(opts)
                opts = opts or {}
                local text = opts.Text or "Slider"
                local flag = opts.Flag or text
                local min = opts.Min or 0
                local max = opts.Max or 100
                local default = opts.Default or min
                local suffix = opts.Suffix or ""
                local callback = opts.Callback

                Library.flags[flag] = default

                local frame = Utility.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 36),
                    BackgroundTransparency = 1,
                    ZIndex = 7,
                    Parent = items
                })

                -- Label + value
                Utility.new("TextLabel", {
                    Size = UDim2.new(0.6, 0, 0, 16),
                    Position = UDim2.new(0, 4, 0, 2),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Library.theme.textDim,
                    TextSize = 12,
                    Font = Library.fontBody,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 8,
                    Parent = frame
                })
                local valLabel = Utility.new("TextLabel", {
                    Size = UDim2.new(0.4, 0, 0, 16),
                    Position = UDim2.new(0.6, 0, 0, 2),
                    BackgroundTransparency = 1,
                    Text = tostring(default) .. suffix,
                    TextColor3 = Library.accent,
                    TextSize = 11,
                    Font = Library.fontMono,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    ZIndex = 8,
                    Parent = frame
                })

                -- Track
                local track = Utility.new("Frame", {
                    Size = UDim2.new(1, -8, 0, 6),
                    Position = UDim2.new(0, 4, 0, 22),
                    BackgroundColor3 = Library.theme.element,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = frame
                })
                Utility.corner(track, 3)

                local fill = Utility.new("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = Library.accent,
                    BorderSizePixel = 0,
                    ZIndex = 9,
                    Parent = track
                })
                Utility.corner(fill, 3)

                -- Invisible drag area
                local dragArea = Utility.new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 18),
                    Position = UDim2.new(0, 0, 0.5, -9),
                    BackgroundTransparency = 1,
                    Text = "",
                    ZIndex = 10,
                    Parent = track
                })

                local dragging = false
                local function update(input)
                    local perc = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    local value = math.floor((min + (max - min) * perc) * 100 + 0.5) / 100
                    Utility.tween(fill, 0.05, {Size = UDim2.new(perc, 0, 1, 0)})
                    valLabel.Text = tostring(value) .. suffix
                    Library.flags[flag] = value
                    if callback then callback(value) end
                end

                dragArea.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true; update(input)
                    end
                end)
                UIS.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end
                end)
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                end)
            end

            -- ---- DROPDOWN ----
            function Groupbox:Dropdown(opts)
                opts = opts or {}
                local text = opts.Text or "Dropdown"
                local flag = opts.Flag or text
                local list = opts.Values or {}
                local default = opts.Default
                local multi = opts.Multi or false
                local callback = opts.Callback

                if multi then
                    Library.flags[flag] = {}
                else
                    Library.flags[flag] = default or nil
                end

                local frame = Utility.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 48),
                    BackgroundTransparency = 1,
                    ZIndex = 7,
                    Parent = items
                })

                Utility.new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 16),
                    Position = UDim2.new(0, 4, 0, 2),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Library.theme.textDim,
                    TextSize = 12,
                    Font = Library.fontBody,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 8,
                    Parent = frame
                })

                local btn = Utility.new("TextButton", {
                    Size = UDim2.new(1, -8, 0, 24),
                    Position = UDim2.new(0, 4, 0, 20),
                    BackgroundColor3 = Library.theme.element,
                    BorderSizePixel = 0,
                    Text = "",
                    ZIndex = 8,
                    Parent = frame
                })
                Utility.corner(btn, 5)
                Utility.stroke(btn, Library.theme.border, 1, 0.5)

                local btnLabel = Utility.new("TextLabel", {
                    Size = UDim2.new(1, -30, 1, 0),
                    Position = UDim2.new(0, 8, 0, 0),
                    BackgroundTransparency = 1,
                    Text = default or "Select...",
                    TextColor3 = default and Library.theme.text or Library.theme.textMuted,
                    TextSize = 12,
                    Font = Library.fontBody,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 9,
                    Parent = btn
                })

                local arrow = Utility.new("TextLabel", {
                    Size = UDim2.new(0, 20, 1, 0),
                    Position = UDim2.new(1, -22, 0, 0),
                    BackgroundTransparency = 1,
                    Text = "▾",
                    TextColor3 = Library.theme.textMuted,
                    TextSize = 14,
                    Font = Library.fontTitle,
                    ZIndex = 9,
                    Parent = btn
                })

                local listFrame = Utility.new("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    Position = UDim2.new(0, 0, 1, 3),
                    BackgroundColor3 = Library.theme.element,
                    BorderSizePixel = 0,
                    Visible = false,
                    ZIndex = 30,
                    ScrollBarThickness = 3,
                    ScrollBarImageColor3 = Library.theme.scrollbar,
                    CanvasSize = UDim2.new(0, 0, 0, #list * 24),
                    Parent = btn
                })
                Utility.corner(listFrame, 5)
                Utility.stroke(listFrame, Library.theme.border, 1, 0.4)
                Utility.list(listFrame, nil, 1)
                Utility.padding(listFrame, 3, 3, 0, 0)

                local opened = false
                btn.MouseButton1Click:Connect(function()
                    opened = not opened
                    listFrame.Visible = opened
                    local h = opened and math.min(#list * 24 + 6, 150) or 0
                    Utility.tween(listFrame, 0.2, {Size = UDim2.new(1, 0, 0, h)})
                    Utility.tween(arrow, 0.2, {Rotation = opened and 180 or 0})
                end)

                local selected = multi and Library.flags[flag] or nil

                local function updateLabel()
                    if multi then
                        local sel = Library.flags[flag]
                        if #sel == 0 then
                            btnLabel.Text = "None"
                            btnLabel.TextColor3 = Library.theme.textMuted
                        elseif #sel <= 2 then
                            btnLabel.Text = table.concat(sel, ", ")
                            btnLabel.TextColor3 = Library.theme.text
                        else
                            btnLabel.Text = #sel .. " selected"
                            btnLabel.TextColor3 = Library.theme.text
                        end
                    end
                end

                for _, v in ipairs(list) do
                    local item = Utility.new("TextButton", {
                        Size = UDim2.new(1, 0, 0, 22),
                        BackgroundColor3 = Library.theme.element,
                        BackgroundTransparency = 1,
                        BorderSizePixel = 0,
                        Text = "",
                        ZIndex = 31,
                        Parent = listFrame
                    })
                    Utility.corner(item, 4)

                    local itemLabel = Utility.new("TextLabel", {
                        Size = UDim2.new(1, -28, 1, 0),
                        Position = UDim2.new(0, 8, 0, 0),
                        BackgroundTransparency = 1,
                        Text = v,
                        TextColor3 = Library.theme.textDim,
                        TextSize = 12,
                        Font = Library.fontBody,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 32,
                        Parent = item
                    })

                    local check = Utility.new("TextLabel", {
                        Size = UDim2.new(0, 16, 1, 0),
                        Position = UDim2.new(1, -20, 0, 0),
                        BackgroundTransparency = 1,
                        Text = "✓",
                        TextColor3 = Library.accent,
                        TextSize = 12,
                        Font = Library.fontTitle,
                        Visible = false,
                        ZIndex = 32,
                        Parent = item
                    })

                    item.MouseEnter:Connect(function()
                        Utility.tween(item, 0.1, {BackgroundTransparency = 0.3, BackgroundColor3 = Library.theme.elementHover})
                    end)
                    item.MouseLeave:Connect(function()
                        Utility.tween(item, 0.1, {BackgroundTransparency = 1})
                    end)

                    item.MouseButton1Click:Connect(function()
                        if not multi then
                            btnLabel.Text = v
                            btnLabel.TextColor3 = Library.theme.text
                            Library.flags[flag] = v
                            opened = false
                            listFrame.Visible = false
                            Utility.tween(listFrame, 0.2, {Size = UDim2.new(1, 0, 0, 0)})
                            Utility.tween(arrow, 0.2, {Rotation = 0})
                            if callback then callback(v) end
                        else
                            local sel = Library.flags[flag]
                            local idx = table.find(sel, v)
                            if idx then
                                table.remove(sel, idx)
                                check.Visible = false
                            else
                                table.insert(sel, v)
                                check.Visible = true
                            end
                            updateLabel()
                            if callback then callback(sel) end
                        end
                    end)

                    if not multi and default == v then check.Visible = true end
                end
            end

            -- ---- TEXTBOX ----
            function Groupbox:Textbox(opts)
                opts = opts or {}
                local text = opts.Text or "Input"
                local flag = opts.Flag or text
                local placeholder = opts.Placeholder or "..."
                local callback = opts.Callback

                Library.flags[flag] = ""

                local frame = Utility.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 48),
                    BackgroundTransparency = 1,
                    ZIndex = 7,
                    Parent = items
                })
                Utility.new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 16),
                    Position = UDim2.new(0, 4, 0, 2),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Library.theme.textDim,
                    TextSize = 12,
                    Font = Library.fontBody,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 8,
                    Parent = frame
                })
                local box = Utility.new("TextBox", {
                    Size = UDim2.new(1, -8, 0, 24),
                    Position = UDim2.new(0, 4, 0, 20),
                    BackgroundColor3 = Library.theme.element,
                    BorderSizePixel = 0,
                    Text = "",
                    PlaceholderText = placeholder,
                    PlaceholderColor3 = Library.theme.textMuted,
                    TextColor3 = Library.theme.text,
                    TextSize = 12,
                    Font = Library.fontBody,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false,
                    ZIndex = 8,
                    Parent = frame
                })
                Utility.corner(box, 5)
                local boxStroke = Utility.stroke(box, Library.theme.border, 1, 0.5)
                Utility.padding(box, 0, 0, 8, 8)

                box.Focused:Connect(function()
                    Utility.tween(boxStroke, 0.15, {Color = Library.accent, Transparency = 0})
                end)
                box.FocusLost:Connect(function()
                    Utility.tween(boxStroke, 0.15, {Color = Library.theme.border, Transparency = 0.5})
                    Library.flags[flag] = box.Text
                    if callback then callback(box.Text) end
                end)
            end

            -- ---- BUTTON ----
            function Groupbox:Button(opts)
                opts = opts or {}
                local text = opts.Text or "Button"
                local callback = opts.Callback
                local confirm = opts.Confirm or false

                local btn = Utility.new("TextButton", {
                    Size = UDim2.new(1, -8, 0, 26),
                    Position = UDim2.new(0, 4, 0, 0),
                    BackgroundColor3 = Library.theme.element,
                    BorderSizePixel = 0,
                    Text = text,
                    TextColor3 = Library.theme.text,
                    TextSize = 12,
                    Font = Library.fontBody,
                    ZIndex = 7,
                    Parent = items
                })
                Utility.corner(btn, 5)
                Utility.stroke(btn, Library.theme.border, 1, 0.5)
                Utility.ripple(btn)
                Utility.hover(btn, Library.theme.element, Library.theme.elementHover)

                local confirmed = false
                btn.MouseButton1Click:Connect(function()
                    if confirm and not confirmed then
                        confirmed = true
                        btn.Text = "Are you sure?"
                        btn.TextColor3 = Color3.fromRGB(240, 80, 80)
                        task.delay(2, function()
                            confirmed = false
                            btn.Text = text
                            btn.TextColor3 = Library.theme.text
                        end)
                        return
                    end
                    confirmed = false
                    btn.Text = text
                    btn.TextColor3 = Library.theme.text
                    if callback then callback() end
                end)
            end

            -- ---- LABEL ----
            function Groupbox:Label(text)
                Utility.new("TextLabel", {
                    Size = UDim2.new(1, -8, 0, 20),
                    Position = UDim2.new(0, 4, 0, 0),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Library.theme.textMuted,
                    TextSize = 11,
                    Font = Library.fontBody,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                    AutomaticSize = Enum.AutomaticSize.Y,
                    ZIndex = 7,
                    Parent = items
                })
            end

            -- ---- DIVIDER ----
            function Groupbox:Divider()
                local div = Utility.new("Frame", {
                    Size = UDim2.new(1, -16, 0, 12),
                    BackgroundTransparency = 1,
                    ZIndex = 7,
                    Parent = items
                })
                Utility.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 1),
                    Position = UDim2.new(0, 0, 0.5, 0),
                    BackgroundColor3 = Library.theme.border,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = div
                })
            end

            -- ---- KEYBIND (standalone) ----
            function Groupbox:Keybind(opts)
                opts = opts or {}
                local text = opts.Text or "Keybind"
                local flag = opts.Flag or text
                local default = opts.Default or Enum.KeyCode.Unknown
                local callback = opts.Callback
                local changeCb = opts.ChangedCallback

                Library.flags[flag] = default

                local row = Utility.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 26),
                    BackgroundTransparency = 1,
                    ZIndex = 7,
                    Parent = items
                })
                Utility.new("TextLabel", {
                    Size = UDim2.new(1, -70, 1, 0),
                    Position = UDim2.new(0, 4, 0, 0),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Library.theme.textDim,
                    TextSize = 12,
                    Font = Library.fontBody,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 8,
                    Parent = row
                })

                local kBtn = Utility.new("TextButton", {
                    Size = UDim2.new(0, 60, 0, 20),
                    Position = UDim2.new(1, -64, 0.5, -10),
                    BackgroundColor3 = Library.theme.element,
                    BorderSizePixel = 0,
                    Text = default == Enum.KeyCode.Unknown and "[None]" or "[" .. default.Name .. "]",
                    TextColor3 = Library.theme.textMuted,
                    TextSize = 10,
                    Font = Library.fontMono,
                    ZIndex = 8,
                    Parent = row
                })
                Utility.corner(kBtn, 4)
                Utility.stroke(kBtn, Library.theme.border, 1, 0.5)

                local listening = false
                kBtn.MouseButton1Click:Connect(function()
                    listening = true
                    kBtn.Text = "[...]"
                    kBtn.TextColor3 = Library.accent
                end)

                UIS.InputBegan:Connect(function(input, gp)
                    if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                        listening = false
                        if input.KeyCode == Enum.KeyCode.Escape then
                            Library.flags[flag] = Enum.KeyCode.Unknown
                            kBtn.Text = "[None]"
                        else
                            Library.flags[flag] = input.KeyCode
                            kBtn.Text = "[" .. input.KeyCode.Name .. "]"
                        end
                        kBtn.TextColor3 = Library.theme.textMuted
                        if changeCb then changeCb(Library.flags[flag]) end
                    elseif not gp and input.KeyCode == Library.flags[flag] then
                        if callback then callback(Library.flags[flag]) end
                    end
                end)
            end

            return Groupbox
        end

        return Tab
    end

    return Window
end

-- ============================================================
-- UNLOAD
-- ============================================================
function Library:Unload()
    Library.unloaded = true
    for _, gui in ipairs(CoreGui:GetChildren()) do
        if gui.Name:find("ZalHub") then gui:Destroy() end
    end
end

return Library
