        TextSize = 14,
        ZIndex = 2,
    })
    utility.label(contentFrame, options.Content or "Message", {
        Size = UDim2.new(1, 0, 0, 0),
        TextColor3 = theme.dimText,
        TextSize = 13,
        TextWrapped = true,
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 2,
    })

    local duration = options.Duration or 5
    utility.tween(notifyFrame, { 0.25, Enum.EasingStyle.Quad }, { Position = UDim2.new(1, -10, 1, -10) })
    task.spawn(function()
        task.wait(duration)
        utility.tween(notifyFrame, { 0.25, Enum.EasingStyle.Quad }, { Position = UDim2.new(1, 330, 1, 0) })
        task.wait(0.35)
        notifyFrame:Destroy()
    end)
end

----------------------------------------------------------------------
-- auto-save debounce
----------------------------------------------------------------------
local autoSaveDebounce = false
function library:ScheduleAutoSave()
    if not library.autoSaveEnabled or not library.autoSaveConfigName then return end
    if autoSaveDebounce then return end
    autoSaveDebounce = true
    task.delay(0.5, function()
        autoSaveDebounce = false
        if library.autoSaveEnabled and library.autoSaveConfigName then
            library:SaveConfig(library.autoSaveConfigName)
        end
    end)
end

function library:FlagChanged(flag)
    if not library._loading then
        library:ScheduleAutoSave()
    end
end

