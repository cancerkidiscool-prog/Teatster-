                local holderFrame = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 16),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ZIndex = 6,
                    Parent = items,
                })
                utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 1),
                    Position = UDim2.new(0, 0, 0.5, 0),
                    BackgroundColor3 = theme.divider,
                    BorderSizePixel = 0,
                    ZIndex = 6,
