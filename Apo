                    Size = UDim2.new(1,0,0,55), BackgroundTransparency = 1, ZIndex = 6, Parent = itemsFrame,
                })
                utility.create("TextLabel", {
                    Size = UDim2.new(1,0,0,22), BackgroundTransparency = 1, Text = text,
                    TextColor3 = Color3.fromRGB(180,180,180), TextSize = 14,
                    Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7, Parent = frame,
                })
                local colorBtn = utility.create("TextButton", {
                    Size = UDim2.new(1,0,0,28), Position = UDim2.new(0,0,0,24),
                    BackgroundColor3 = defaultColor or Color3.fromRGB(255,0,0), BorderSizePixel = 0,
                    Text = "", ZIndex = 7, Parent = frame,
                })
                utility.stroke(colorBtn, Color3.fromRGB(50,50,50), 1)
                utility.create("UICorner", { CornerRadius = UDim.new(0,8), Parent = colorBtn })
                local pickerFrame
                local hueBar, svBox, svCursor, hueCursor
                local alphaBar, alphaCursor
