                    Size = UDim2.new(1, 0, 0, 0),
                    Position = UDim2.new(0, 0, 1, 4),
                    BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                    BorderSizePixel = 0,
                    Visible = false,
                    ZIndex = 11,
                    ScrollBarThickness = 5,
                    ScrollBarImageColor3 = Color3.fromRGB(60, 60, 60),
                    CanvasSize = UDim2.new(1, 0, 0, 0),
                    Parent = btn,
                })
                utility.stroke(listFrame, Color3.fromRGB(50, 50, 50), 1)
                utility.create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = listFrame })
                local listLayout = utility.create("UIListLayout", {
                    Padding = UDim.new(0, 2),
                    Parent = listFrame,
                })
                local searchFrame = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 26),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    ZIndex = 12,
                    Parent = listFrame,
                })
                local searchInput = utility.create("TextBox", {
                    Size = UDim2.new(1, -10, 1, -4),
                    Position = UDim2.new(0, 5, 0, 2),
                    BackgroundTransparency = 1,
                    PlaceholderText = "Filter...",
                    PlaceholderColor3 = Color3.fromRGB(100, 100, 100),
                    Text = "",
                    TextColor3 = Color3.fromRGB(220, 220, 220),
                    TextSize = 13,
                    Font = library.fonts.UI,
                    ClearTextOnFocus = false,
                    ZIndex = 13,
                    Parent = searchFrame,
                })
                local opened = false
                btn.MouseButton1Click:Connect(function()
                    opened = not opened
                    listFrame.Visible = opened
                    if opened then
                        listFrame.Size = UDim2.new(1, 0, 0, math.min(#list * 28 + 26, 200))
                        listFrame.CanvasSize = UDim2.new(1, 0, 0, #list * 28 + 26)
                        searchInput.Text = ""
                        updateItems()
                    else
                        listFrame.Size = UDim2.new(1, 0, 0, 0)
                    end
                end)

                local selected = multi and (library.flags[flag] or {}) or {}
                if multi and not library.flags[flag] then library.flags[flag] = selected end

                local function updateButtonText()
                    if multi then
                        btn.Text = #selected == 0 and "Select..." or (#selected <= 3 and table.concat(selected, ", ") or #selected .. " selected")
                    else
                        btn.Text = selected[1] or "Select..."
                    end
                end
                updateButtonText()

                local function updateItems()
                    for _, child in ipairs(listFrame:GetChildren()) do
                        if child ~= searchFrame then child:Destroy() end
                    end
                    local filter = string.lower(searchInput.Text)
                    local y = 0
                    for _, item in ipairs(list) do
                        if filter == "" or string.find(string.lower(item), filter, 1, true) then
                            local optionBtn = utility.create("TextButton", {
                                Size = UDim2.new(1, 0, 0, 28),
                                BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                                BorderSizePixel = 0,
                                Text = "",
                                ZIndex = 12,
                                Parent = listFrame,
                            })
                            utility.create("TextLabel", {
                                Size = UDim2.new(1, -30, 1, 0),
                                Position = UDim2.new(0, 8, 0, 0),
                                BackgroundTransparency = 1,
                                Text = item,
                                TextColor3 = Color3.fromRGB(180, 180, 180),
                                TextSize = 14,
                                Font = library.fonts.UI,
                                TextXAlignment = Enum.TextXAlignment.Left,
                                ZIndex = 13,
                                Parent = optionBtn,
                            })
                            if multi then
                                local check = utility.create("TextLabel", {
                                    Size = UDim2.new(0, 20, 1, 0),
                                    Position = UDim2.new(1, -28, 0, 0),
                                    BackgroundTransparency = 1,
                                    Text = "✓",
                                    TextColor3 = library.accent,
                                    TextSize = 16,
                                    Font = library.fonts.UI,
                                    ZIndex = 13,
                                    Parent = optionBtn,
                                })
                                check.Visible = table.find(selected, item) ~= nil
                                optionBtn.MouseButton1Click:Connect(function()
                                    local idx = table.find(selected, item)
                                    if idx then table.remove(selected, idx); check.Visible = false
                                    else table.insert(selected, item); check.Visible = true end
                                    updateButtonText()
                                    if cb then cb(selected) end
                                end)
                            else
                                optionBtn.MouseButton1Click:Connect(function()
                                    selected[1] = item
                                    btn.Text = item
                                    opened = false
                                    listFrame.Visible = false
                                    listFrame.Size = UDim2.new(1, 0, 0, 0)
                                    library.flags[flag] = item
                                    if cb then cb(item) end
                                end)
                            end
                            y = y + 1
                        end
                    end
                    listFrame.CanvasSize = UDim2.new(1, 0, 0, y * 28 + 26)
                    if y * 28 + 26 > 200 then listFrame.Size = UDim2.new(1, 0, 0, 200) end
                end
                searchInput:GetPropertyChangedSignal("Text"):Connect(updateItems)
            end

            -- ============== COLOR PICKER (Premium) ==============
            function sectionActions:ColorPicker(text, flag, defaultColor, callback)
                local frame = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 55),
                    BackgroundTransparency = 1,
                    ZIndex = 6,
                    Parent = itemsFrame,
                })
                utility.create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 22),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(180, 180, 180),
                    TextSize = 14,
                    Font = library.fonts.UI,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 7,
                    Parent = frame,
                })
                local colorBtn = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 28),
                    Position = UDim2.new(0, 0, 0, 24),
                    BackgroundColor3 = defaultColor or Color3.fromRGB(255, 0, 0),
                    BorderSizePixel = 0,
                    Text = "",
                    ZIndex = 7,
                    Parent = frame,
                })
                utility.stroke(colorBtn, Color3.fromRGB(50, 50, 50), 1)
                utility.create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = colorBtn })
                local pickerOpen = false
                local pickerFrame
                local hueBar, svBox, svCursor, hueCursor

                local function closePicker()
                    if pickerFrame then pickerFrame:Destroy(); pickerFrame = nil end
                    pickerOpen = false
                end

                local function openPicker()
                    if pickerOpen then closePicker() return end
                    pickerOpen = true
                    pickerFrame = utility.create("Frame", {
                        Size = UDim2.new(0, 200, 0, 170),
                        Position = UDim2.new(0.5, -100, 1, 10),
                        BackgroundColor3 = Color3.fromRGB(18, 18, 18),
                        BorderSizePixel = 0,
                        ZIndex = 12,
                        Parent = frame,
                    })
                    utility.stroke(pickerFrame, library.accent, 1)
                    utility.create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = pickerFrame })

                    -- SV Box
                    svBox = utility.create("ImageButton", {
                        Size = UDim2.new(0, 150, 0, 150),
                        Position = UDim2.new(0, 5, 0, 5),
                        BackgroundColor3 = Color3.new(1,1,1),
                        Image = "rbxassetid://284402810", -- blank
                        BorderSizePixel = 0,
                        ZIndex = 13,
                        Parent = pickerFrame,
                    })
                    utility.create("UIGradient", {
                        Name = "SVGradient",
                        Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, Color3.new(1,1,1)),
                            ColorSequenceKeypoint.new(1, defaultColor or Color3.new(1,0,0))
                        }),
                        Rotation = 0,
                        Parent = svBox,
                    })
                    local whiteBlack = utility.create("UIGradient", {
                        Name = "WBGradient",
                        Transparency = NumberSequence.new({
                            NumberSequenceKeypoint.new(0, 0),
                            NumberSequenceKeypoint.new(1, 1)
                        }),
                        Rotation = 90,
                        Parent = svBox,
                    })
                    -- Hue bar (vertical)
                    hueBar = utility.create("ImageButton", {
                        Size = UDim2.new(0, 20, 0, 150),
                        Position = UDim2.new(0, 160, 0, 5),
                        BackgroundColor3 = Color3.new(1,1,1),
                        Image = "rbxassetid://284402810",
                        BorderSizePixel = 0,
                        ZIndex = 13,
                        Parent = pickerFrame,
                    })
                    utility.create("UIGradient", {
                        Name = "HueGradient",
                        Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)),
                            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,255,0)),
                            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
                            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0,255,255)),
                            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0,0,255)),
                            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
                            ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0)),
                        }),
                        Rotation = 90,
                        Parent = hueBar,
                    })
                    -- Cursors
                    svCursor = utility.create("Frame", {
                        Size = UDim2.new(0, 10, 0, 10),
                        BackgroundColor3 = Color3.new(1,1,1),
                        BorderSizePixel = 0,
                        ZIndex = 14,
                        Parent = svBox,
                    })
                    utility.create("UICorner", { CornerRadius = UDim.new(0, 5), Parent = svCursor })
                    utility.stroke(svCursor, Color3.new(0,0,0), 1)
                    svCursor.Position = UDim2.new(1, -5, 0, -5) -- top-right (max sat, min val)
                    hueCursor = utility.create("Frame", {
                        Size = UDim2.new(0, 24, 0, 6),
                        BackgroundColor3 = Color3.new(1,1,1),
                        BorderSizePixel = 0,
                        ZIndex = 14,
                        Parent = hueBar,
                    })
                    utility.stroke(hueCursor, Color3.new(0,0,0), 1)

                    local function updateColorFromSV()
                        local svX = math.clamp((svCursor.Position.X.Scale), 0, 1)
                        local svY = math.clamp((svCursor.Position.Y.Scale), 0, 1)
                        local hueColor = Color3.fromHSV(hueCursor.Position.Y.Scale, 1, 1)
                        local satColor = Color3.new(1,1,1):Lerp(hueColor, svX)
                        local finalColor = satColor:Lerp(Color3.new(0,0,0), svY)
                        colorBtn.BackgroundColor3 = finalColor
                        library.flags[flag] = finalColor
                        if callback then callback(finalColor) end
                    end

                    local function updateSVFromHue()
                        local hueColor = Color3.fromHSV(hueCursor.Position.Y.Scale, 1, 1)
                        if svBox:FindFirstChild("SVGradient") then
                            svBox.SVGradient.Color = ColorSequence.new({
                                ColorSequenceKeypoint.new(0, Color3.new(1,1,1)),
                                ColorSequenceKeypoint.new(1, hueColor)
                            })
                        end
                        updateColorFromSV()
                    end

                    -- Input handling
                    local function dragSV(input)
                        local posX = (input.Position.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X
                        local posY = (input.Position.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y
                        svCursor.Position = UDim2.new(math.clamp(posX, 0, 1), -5, math.clamp(posY, 0, 1), -5)
                        updateColorFromSV()
                    end
                    local function dragHue(input)
                        local posY = (input.Position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y
                        hueCursor.Position = UDim2.new(0, -2, math.clamp(posY, 0, 1), -3)
                        updateSVFromHue()
                    end
                    local svDragging, hueDragging = false, false
                    svBox.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                            svDragging = true
                            dragSV(inp)
                        end
                    end)
                    hueBar.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                            hueDragging = true
                            dragHue(inp)
                        end
                    end)
                    userInput.InputChanged:Connect(function(inp)
                        if svDragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                            dragSV(inp)
                        end
                        if hueDragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                            dragHue(inp)
                        end
                    end)
                    userInput.InputEnded:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                            svDragging = false
                            hueDragging = false
                        end
                    end)

                    -- Close on outside click
                    local conn
                    conn = userInput.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                            local pos = userInput:GetMouseLocation()
                            if not (pickerFrame.AbsolutePosition.X <= pos.X and pos.X <= pickerFrame.AbsolutePosition.X + pickerFrame.AbsoluteSize.X
                                and pickerFrame.AbsolutePosition.Y <= pos.Y and pos.Y <= pickerFrame.AbsolutePosition.Y + pickerFrame.AbsoluteSize.Y) then
                                closePicker()
                                conn:Disconnect()
                            end
                        end
                    end)
                end
                colorBtn.MouseButton1Click:Connect(openPicker)
            end

