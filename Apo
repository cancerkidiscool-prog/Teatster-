repeat wait() until game:IsLoaded()

local Drawing = Drawing or error("Drawing library not found.")

-- // Utility Color // --
local function RGB(r, g, b)
    return Color3.fromRGB(r, g, b)
end

-- // Draw Object // --
local Draw = {}
local allrender = {} -- master table of all drawing groups

function Draw:OutlinedRect(visible, x, y, w, h, clr, tablename)
    local obj = Drawing.new("Square")
    obj.Visible = visible
    obj.Position = Vector2.new(x, y)
    obj.Size = Vector2.new(w, h)
    obj.Color = RGB(clr[1], clr[2], clr[3])
    obj.Filled = false
    obj.Thickness = 1
    obj.Transparency = (clr[4] or 255) / 255
    table.insert(tablename, obj)
    if not table.find(allrender, tablename) then
        table.insert(allrender, tablename)
    end
    return obj
end

function Draw:FilledRect(visible, x, y, w, h, clr, tablename)
    local obj = Drawing.new("Square")
    obj.Visible = visible
    obj.Position = Vector2.new(x, y)
    obj.Size = Vector2.new(w, h)
    obj.Color = RGB(clr[1], clr[2], clr[3])
    obj.Filled = true
    obj.Thickness = 0
    obj.Transparency = (clr[4] or 255) / 255
    table.insert(tablename, obj)
    if not table.find(allrender, tablename) then
        table.insert(allrender, tablename)
    end
    return obj
end

function Draw:Line(visible, thickness, x1, y1, x2, y2, clr, tablename)
    local obj = Drawing.new("Line")
    obj.Visible = visible
    obj.Thickness = thickness
    obj.From = Vector2.new(x1, y1)
    obj.To = Vector2.new(x2, y2)
    obj.Color = RGB(clr[1], clr[2], clr[3])
    obj.Transparency = (clr[4] or 255) / 255
    table.insert(tablename, obj)
    if not table.find(allrender, tablename) then
        table.insert(allrender, tablename)
    end
    return obj
end

function Draw:Text(visible, text, x, y, font, size, clr, alignment, tablename)
    text = tostring(text or "")
    font = font or 0
    alignment = alignment or 0 -- 0=left,1=center,2=right
    local obj = Drawing.new("Text")
    obj.Visible = visible
    obj.Text = text
    obj.Position = Vector2.new(x, y)
    obj.Font = font
    obj.Size = size or 14
    obj.Color = RGB(clr[1], clr[2], clr[3])
    obj.Transparency = (clr[4] or 255) / 255
    obj.Center = (alignment == 1)
    obj.Outline = false
    -- Right alignment simulated via manual positioning later if needed
    table.insert(tablename, obj)
    if not table.find(allrender, tablename) then
        table.insert(allrender, tablename)
    end
    return obj
end

function Draw:Image(visible, imagedata, x, y, w, h, transparency, tablename)
    local obj = Drawing.new("Image")
    obj.Visible = visible
    obj.Data = imagedata
    obj.Position = Vector2.new(x, y)
    obj.Size = Vector2.new(w, h)
    obj.Transparency = transparency or 0
    table.insert(tablename, obj)
    if not table.find(allrender, tablename) then
        table.insert(allrender, tablename)
    end
    return obj
end

-- Clear a single group
function Draw:ClearGroup(tablename)
    if tablename then
        for _, obj in ipairs(tablename) do
            obj:Remove()
        end
        -- remove from allrender
        for i, group in ipairs(allrender) do
            if group == tablename then
                table.remove(allrender, i)
                break
            end
        end
        -- empty the table
        for k in pairs(tablename) do tablename[k] = nil end
    end
end

-- // Library // --
local library = {
    flags = {},
    accent = {117, 52, 235, 255},       -- RGB + Alpha
    outline = {{117, 52, 235, 255}, {200, 100, 255, 255}},
    toggled = true,
}

local services = setmetatable({}, {
    __index = function(_, s) return game:GetService(s) end
})

local notifyHolder = {} -- active notification groups

function library:Notify(options)
    local duration = options.Duration or 5
    local title = options.Title or "Notification"
    local content = options.Content or "Message"
    local group = {}
    local x = services.Workspace.CurrentCamera.ViewportSize.X - 310
    local y = services.Workspace.CurrentCamera.ViewportSize.Y - 80

    Draw:FilledRect(true, x, y, 300, 60, {15,15,15,255}, group)
    Draw:OutlinedRect(true, x, y, 300, 60, library.accent, group)
    Draw:Text(true, title, x+10, y+8, 2, 15, library.accent, 0, group)
    Draw:Text(true, content, x+10, y+30, 2, 13, {200,200,200,255}, 0, group)

    group._startTime = tick()
    group._duration = duration
    table.insert(notifyHolder, group)
end

-- Window State
local windowState = {
    visible = true,
    x = 200, y = 100, w = 550, h = 600,
    tabs = {},
    currentTab = nil,
    drag = {active = false, startX=0, startY=0, offsetX=0, offsetY=0},
    searchText = "",
    searchBoxFocused = false,
}
local windowGroup = {} -- main window drawings
local windowActions

function library:Window(name)
    local inputGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
    inputGui.Name = "ZalHub_Input"
    inputGui.ResetOnSpawn = false

    -- Toggle button (watermark)
    local toggleGroup = {}
    local toggleX, toggleY = 20, 10
    Draw:FilledRect(true, toggleX, toggleY, 140, 40, {15,15,15,255}, toggleGroup)
    Draw:OutlinedRect(true, toggleX, toggleY, 140, 40, library.accent, toggleGroup)
    local toggleText = Draw:Text(true, "ZalHub [ON]", toggleX+70, toggleY+20, 2, 16, library.accent, 1, toggleGroup)
    local toggleState = true

    local function updateToggleVisual()
        local txt = toggleState and "ZalHub [ON]" or "ZalHub [OFF]"
        local clr = toggleState and library.accent or {80,80,80,255}
        toggleText.Text = txt
        toggleText.Color = RGB(clr[1], clr[2], clr[3])
        -- also update outline colors (need to redraw)
        Draw:ClearGroup(toggleGroup)
        Draw:FilledRect(true, toggleX, toggleY, 140, 40, {15,15,15,255}, toggleGroup)
        Draw:OutlinedRect(true, toggleX, toggleY, 140, 40, clr, toggleGroup)
        toggleText = Draw:Text(true, txt, toggleX+70, toggleY+20, 2, 16, clr, 1, toggleGroup)
    end

    local function isInRect(x,y, rx,ry,rw,rh)
        return x >= rx and x <= rx+rw and y >= ry and y <= ry+rh
    end

    services.UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local mx, my = input.Position.X, input.Position.Y
            if isInRect(mx, my, toggleX, toggleY, 140, 40) then
                toggleState = not toggleState
                windowState.visible = toggleState
                updateToggleVisual()
                return
            end
            if not windowState.visible then return end
            if isInRect(mx, my, windowState.x, windowState.y, windowState.w, 50) then
                windowState.drag.active = true
                windowState.drag.startX = mx
                windowState.drag.startY = my
                windowState.drag.offsetX = windowState.x
                windowState.drag.offsetY = windowState.y
            end
            local sx = windowState.x + windowState.w - 240
            local sy = windowState.y + 9
            if isInRect(mx, my, sx, sy, 220, 32) then
                windowState.searchBoxFocused = true
                local sb = inputGui:FindFirstChild("SearchBox")
                if sb then sb:CaptureFocus() end
            else
                if windowState.searchBoxFocused then
                    windowState.searchBoxFocused = false
                    local sb = inputGui:FindFirstChild("SearchBox")
                    if sb then sb:ReleaseFocus() end
                end
            end
        end
        if input.KeyCode == Enum.KeyCode.RightShift and not gameProcessed then
            toggleState = not toggleState
            windowState.visible = toggleState
            updateToggleVisual()
        end
    end)

    services.UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if windowState.drag.active then
                local dx = input.Position.X - windowState.drag.startX
                local dy = input.Position.Y - windowState.drag.startY
                windowState.x = windowState.drag.offsetX + dx
                windowState.y = windowState.drag.offsetY + dy
            end
        end
    end)

    services.UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            windowState.drag.active = false
        end
    end)

    -- Search box
    local searchX = windowState.x + windowState.w - 240
    local searchY = windowState.y + 9
    local searchBoxInput = Instance.new("TextBox")
    searchBoxInput.Name = "SearchBox"
    searchBoxInput.Size = UDim2.new(0, 220, 0, 32)
    searchBoxInput.Position = UDim2.new(0, searchX, 0, searchY)
    searchBoxInput.BackgroundTransparency = 1
    searchBoxInput.Text = ""
    searchBoxInput.PlaceholderText = "Search Options..."
    searchBoxInput.PlaceholderColor3 = Color3.fromRGB(80,80,80)
    searchBoxInput.TextColor3 = Color3.fromRGB(200,200,200)
    searchBoxInput.TextSize = 14
    searchBoxInput.Font = Enum.Font.Code
    searchBoxInput.ClearTextOnFocus = false
    searchBoxInput.Parent = inputGui
    searchBoxInput:GetPropertyChangedSignal("Text"):Connect(function()
        windowState.searchText = searchBoxInput.Text
    end)

    -- Window static elements
    local function updateStatic()
        Draw:ClearGroup(windowGroup)
        local wx, wy = windowState.x, windowState.y
        Draw:FilledRect(windowState.visible, wx, wy, windowState.w, windowState.h, {15,15,15,255}, windowGroup)
        Draw:OutlinedRect(windowState.visible, wx, wy, windowState.w, windowState.h, {40,40,40,255}, windowGroup)
        Draw:FilledRect(windowState.visible, wx, wy, windowState.w, 50, {20,20,20,255}, windowGroup)
        Draw:OutlinedRect(windowState.visible, wx, wy, windowState.w, 50, {40,40,40,255}, windowGroup)
        Draw:Text(windowState.visible, name, wx+16, wy+25, 2, 18, library.accent, 0, windowGroup)
        Draw:FilledRect(windowState.visible, wx, wy+50, windowState.w, 40, {20,20,20,255}, windowGroup)
        Draw:OutlinedRect(windowState.visible, wx, wy+50, windowState.w, 40, {40,40,40,255}, windowGroup)
        -- search bar
        local sx = wx + windowState.w - 240
        local sy = wy + 9
        Draw:FilledRect(windowState.visible, sx, sy, 220, 32, {18,18,18,255}, windowGroup)
        Draw:OutlinedRect(windowState.visible, sx, sy, 220, 32, {50,50,50,255}, windowGroup)
        Draw:Text(windowState.visible, "🔍", sx+15, sy+16, 2, 16, {100,100,100,255}, 1, windowGroup)
        Draw:Text(windowState.visible, windowState.searchText, sx+35, sy+16, 2, 14, {200,200,200,255}, 0, windowGroup)
        searchBoxInput.Position = UDim2.new(0, sx, 0, sy)
    end

    -- Dynamic render
    local dynamicGroups = {} -- temporary groups for dynamic items, cleared each frame
    local function renderDynamic()
        -- clear old dynamic groups
        for _, group in ipairs(dynamicGroups) do
            Draw:ClearGroup(group)
        end
        dynamicGroups = {}

        if not windowState.currentTab then return end
        local activeTab = windowState.currentTab
        local leftColX = windowState.x + 10
        local rightColX = windowState.x + windowState.w/2 + 2
        local colY = windowState.y + 100

        -- Tab buttons
        local btnX = windowState.x + 10
        local btnY = windowState.y + 55
        for i, tab in ipairs(windowState.tabs) do
            local btnW = #tab.name * 10 + 20
            local btnH = 35
            local group = {}
            Draw:FilledRect(true, btnX, btnY, btnW, btnH, {0,0,0,0}, group)
            local clr = tab.active and library.accent or {120,120,120,255}
            Draw:Text(true, tab.name, btnX+btnW/2, btnY+btnH/2, 2, 15, clr, 1, group)
            if tab.active then
                Draw:FilledRect(true, btnX, btnY+btnH-3, btnW, 3, library.accent, group)
            end
            tab._hitbox = {x=btnX, y=btnY, w=btnW, h=btnH}
            table.insert(dynamicGroups, group)
            btnX = btnX + btnW + 15
        end

        -- Render sections
        local function renderSections(secs, colX)
            local yPos = colY
            for _, sec in ipairs(secs) do
                local secW = windowState.w/2 - 12
                local itemCount = #sec.items
                local secH = 25 + itemCount * 30 + (itemCount>0 and 10 or 0)
                local group = {}
                Draw:FilledRect(true, colX, yPos, secW, secH, {18,18,18,255}, group)
                Draw:OutlinedRect(true, colX, yPos, secW, secH, {40,40,40,255}, group)
                Draw:Text(true, sec.name:upper(), colX+5, yPos+12, 2, 15, library.accent, 0, group)
                local itemY = yPos + 25
                for _, item in ipairs(sec.items) do
                    local itemH = 30
                    if item.type == "Textbox" then itemH = 50 elseif item.type == "Dropdown" then itemH = 50 elseif item.type == "Slider" then itemH = 40 end
                    if item.type == "Toggle" then
                        Draw:FilledRect(true, colX, itemY, secW, itemH, {0,0,0,0}, group)
                        Draw:Text(true, item.text, colX+15, itemY+15, 2, 13, {180,180,180,255}, 0, group)
                        local trackX = colX + secW - 45
                        local trackY = itemY + 6
                        local trackColor = item.enabled and library.accent or {30,30,30,255}
                        Draw:FilledRect(true, trackX, trackY, 36, 18, trackColor, group)
                        Draw:OutlinedRect(true, trackX, trackY, 36, 18, {50,50,50,255}, group)
                        local knobX = item.enabled and (trackX + 36 - 16 - 1) or (trackX + 1)
                        Draw:FilledRect(true, knobX, trackY+1, 16, 16, {255,255,255,255}, group)
                        item._hitbox = {x=colX, y=itemY, w=secW, h=itemH}
                    elseif item.type == "Textbox" then
                        Draw:FilledRect(true, colX, itemY, secW, itemH, {0,0,0,0}, group)
                        Draw:Text(true, item.text, colX+5, itemY+5, 2, 14, {180,180,180,255}, 0, group)
                        local bx, by, bw, bh = colX+5, itemY+22, secW-10, 24
                        Draw:FilledRect(true, bx, by, bw, bh, {25,25,25,255}, group)
                        Draw:OutlinedRect(true, bx, by, bw, bh, {50,50,50,255}, group)
                        local display = (item.value ~= "" and item.value) or item.placeholder
                        Draw:Text(true, display, bx+5, by+12, 2, 14, item.value ~= "" and {220,220,220,255} or {80,80,80,255}, 0, group)
                        item._hitbox = {x=bx, y=by, w=bw, h=bh}
                        if item.inputObj then
                            item.inputObj.Position = UDim2.new(0, bx, 0, by)
                            item.inputObj.Size = UDim2.new(0, bw, 0, bh)
                            item.inputObj.Visible = true
                        end
                    elseif item.type == "Dropdown" then
                        Draw:FilledRect(true, colX, itemY, secW, itemH, {0,0,0,0}, group)
                        Draw:Text(true, item.text, colX+5, itemY+5, 2, 14, {180,180,180,255}, 0, group)
                        local bx, by, bw, bh = colX+5, itemY+22, secW-10, 24
                        Draw:FilledRect(true, bx, by, bw, bh, {25,25,25,255}, group)
                        Draw:OutlinedRect(true, bx, by, bw, bh, {50,50,50,255}, group)
                        local selected = "Select..."
                        if not item.multi and item.selected then selected = item.selected
                        elseif item.multi then
                            local sel = item.selected or {}
                            if #sel == 0 then selected = "Select..."
                            elseif #sel == 1 then selected = sel[1]
                            elseif #sel <= 3 then selected = table.concat(sel, ", ")
                            else selected = #sel .. " selected" end
                        end
                        Draw:Text(true, selected, bx+5, by+12, 2, 14, {200,200,200,255}, 0, group)
                        Draw:Text(true, "▼", bx+bw-20, by+12, 2, 14, {120,120,120,255}, 0, group)
                        item._hitbox = {x=bx, y=by, w=bw, h=bh}
                        if item.opened then
                            local listY = by + bh + 4
                            local listH = #item.list * 24
                            local lgroup = {}
                            Draw:FilledRect(true, bx, listY, bw, math.min(listH,200), {20,20,20,255}, lgroup)
                            Draw:OutlinedRect(true, bx, listY, bw, math.min(listH,200), {50,50,50,255}, lgroup)
                            local optY = listY
                            for _, opt in ipairs(item.list) do
                                Draw:FilledRect(true, bx, optY, bw, 24, {20,20,20,255}, lgroup)
                                Draw:Text(true, opt, bx+5, optY+12, 2, 14, {160,160,160,255}, 0, lgroup)
                                if item.multi and table.find(item.selected, opt) then
                                    Draw:Text(true, "✔", bx+bw-25, optY+12, 2, 14, library.accent, 0, lgroup)
                                end
                                opt._hitbox = {x=bx, y=optY, w=bw, h=24}
                                optY = optY + 24
                            end
                            table.insert(dynamicGroups, lgroup)
                        end
                    elseif item.type == "Slider" then
                        Draw:FilledRect(true, colX, itemY, secW, itemH, {0,0,0,0}, group)
                        Draw:Text(true, item.text, colX+5, itemY+5, 2, 13, {180,180,180,255}, 0, group)
                        local bx, by, bw, bh = colX+5, itemY+20, secW-10, 20
                        Draw:FilledRect(true, bx, by, bw, bh, {25,25,25,255}, group)
                        Draw:OutlinedRect(true, bx, by, bw, bh, {50,50,50,255}, group)
                        local perc = (item.value - item.min) / (item.max - item.min)
                        local fillW = math.max(0, bw * perc)
                        Draw:FilledRect(true, bx, by, fillW, bh, library.accent, group)
                        Draw:Text(true, string.format("%.2f/%.2f", item.value, item.max), bx+bw/2, by+bh/2, 2, 13, {255,255,255,255}, 1, group)
                        item._hitbox = {x=bx, y=by, w=bw, h=bh}
                    elseif item.type == "Button" then
                        local bx, by, bw, bh = colX+5, itemY, secW-10, 34
                        Draw:FilledRect(true, bx, by, bw, bh, {25,25,25,255}, group)
                        Draw:OutlinedRect(true, bx, by, bw, bh, {50,50,50,255}, group)
                        Draw:Text(true, item.text, bx+bw/2, by+bh/2, 2, 14, {200,200,200,255}, 1, group)
                        item._hitbox = {x=bx, y=by, w=bw, h=bh}
                    end
                    itemY = itemY + itemH
                end
                table.insert(dynamicGroups, group)
                yPos = yPos + secH + 10
            end
        end

        local left, right = {}, {}
        for _, sec in ipairs(activeTab.sections) do
            if sec.col == "left" then table.insert(left, sec) else table.insert(right, sec) end
        end
        renderSections(left, leftColX)
        renderSections(right, rightColX)
    end

    -- Interaction
    services.UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        local mx, my = input.Position.X, input.Position.Y
        for _, tab in ipairs(windowState.tabs) do
            if tab._hitbox and isInRect(mx, my, tab._hitbox.x, tab._hitbox.y, tab._hitbox.w, tab._hitbox.h) then
                if windowState.currentTab then windowState.currentTab.active = false end
                tab.active = true
                windowState.currentTab = tab
                return
            end
        end
        if windowState.currentTab then
            for _, sec in ipairs(windowState.currentTab.sections) do
                for _, item in ipairs(sec.items) do
                    if item._hitbox and isInRect(mx, my, item._hitbox.x, item._hitbox.y, item._hitbox.w, item._hitbox.h) then
                        if item.type == "Toggle" then
                            item.enabled = not item.enabled
                            library.flags[item.flag] = item.enabled
                            if item.cb then item.cb(item.enabled) end
                        elseif item.type == "Button" then
                            if item.callback then item.callback() end
                        elseif item.type == "Dropdown" then
                            item.opened = not item.opened
                            for _, sec2 in ipairs(windowState.currentTab.sections) do
                                for _, it2 in ipairs(sec2.items) do
                                    if it2 ~= item and it2.type == "Dropdown" then it2.opened = false end
                                end
                            end
                        elseif item.type == "Textbox" and item.inputObj then
                            item.inputObj:CaptureFocus()
                        end
                        return
                    end
                end
            end
            -- Dropdown list clicks
            for _, sec in ipairs(windowState.currentTab.sections) do
                for _, item in ipairs(sec.items) do
                    if item.type == "Dropdown" and item.opened then
                        for _, opt in ipairs(item.list) do
                            if opt._hitbox and isInRect(mx, my, opt._hitbox.x, opt._hitbox.y, opt._hitbox.w, opt._hitbox.h) then
                                if item.multi then
                                    local idx = table.find(item.selected, opt)
                                    if idx then table.remove(item.selected, idx) else table.insert(item.selected, opt) end
                                    if item.cb then item.cb(item.selected) end
                                else
                                    item.selected = opt
                                    library.flags[item.flag] = opt
                                    item.opened = false
                                    if item.cb then item.cb(opt) end
                                end
                                return
                            end
                        end
                        item.opened = false
                    end
                end
            end
        end
    end)

    services.UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and windowState.currentTab then
            for _, sec in ipairs(windowState.currentTab.sections) do
                for _, item in ipairs(sec.items) do
                    if item.type == "Slider" and item._hitbox and isInRect(input.Position.X, input.Position.Y, item._hitbox.x, item._hitbox.y, item._hitbox.w, item._hitbox.h) then
                        item.dragging = true
                        return
                    end
                end
            end
        end
    end)

    services.UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and windowState.currentTab then
            for _, sec in ipairs(windowState.currentTab.sections) do
                for _, item in ipairs(sec.items) do
                    if item.type == "Slider" and item.dragging then
                        local bar = item._hitbox
                        if bar then
                            local perc = math.clamp((input.Position.X - bar.x) / bar.w, 0, 1)
                            local value = item.min + (item.max - item.min) * perc
                            item.value = tonumber(string.format("%.2f", value))
                            library.flags[item.flag] = item.value
                            if item.callback then item.callback(item.value) end
                        end
                    end
                end
            end
        end
    end)

    services.UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and windowState.currentTab then
            for _, sec in ipairs(windowState.currentTab.sections) do
                for _, item in ipairs(sec.items) do
                    if item.type == "Slider" then item.dragging = false end
                end
            end
        end
    end)

    -- Main render loop
    task.spawn(function()
        while true do
            task.wait(0.03)
            updateStatic()
            renderDynamic()
            -- Notifications update
            local toRemove = {}
            for i, group in ipairs(notifyHolder) do
                local elapsed = tick() - group._startTime
                local progress = math.clamp(elapsed / 0.4, 0, 1)
                if elapsed < 0.4 then
                    local targetY = services.Workspace.CurrentCamera.ViewportSize.Y - 80 + (80 * (1 - progress))
                    for _, obj in ipairs(group) do
                        if obj.ClassName == "Square" or obj.ClassName == "Text" then
                            obj.Position = Vector2.new(obj.Position.X, targetY + (obj.Position.Y - (services.Workspace.CurrentCamera.ViewportSize.Y - 80)))
                        end
                    end
                end
                if elapsed > group._duration then
                    local fade = math.clamp((elapsed - group._duration) / 0.5, 0, 1)
                    for _, obj in ipairs(group) do
                        obj.Transparency = fade
                    end
                    if fade >= 1 then table.insert(toRemove, i) end
                end
            end
            for i = #toRemove, 1, -1 do
                local idx = toRemove[i]
                Draw:ClearGroup(notifyHolder[idx])
                table.remove(notifyHolder, idx)
            end
        end
    end)

    -- Create Window methods
    windowActions = {}
    function windowActions:Tab(tabName)
        local tab = {name = tabName, active = false, sections = {}}
        table.insert(windowState.tabs, tab)
        if #windowState.tabs == 1 then
            tab.active = true
            windowState.currentTab = tab
        end
        local tabActions = {}
        function tabActions:Section(secName)
            local section = {name = secName, items = {}, col = (#tab.sections % 2 == 0 and "left" or "right")}
            table.insert(tab.sections, section)
            local secActions = {}
            function secActions:Toggle(text, flag, defaultOrCallback, callback)
                local enabled, cb = false, nil
                if type(defaultOrCallback) == "boolean" then enabled = defaultOrCallback; cb = callback
                elseif type(defaultOrCallback) == "function" then cb = defaultOrCallback end
                table.insert(section.items, {type="Toggle", text=text, flag=flag, enabled=enabled, cb=cb})
            end
            function secActions:Textbox(text, flag, placeholder, callback)
                local item = {type="Textbox", text=text, flag=flag, placeholder=placeholder or "...", value="", cb=callback, inputObj=nil}
                local hidden = Instance.new("TextBox")
                hidden.Size = UDim2.new(0,200,0,24)
                hidden.BackgroundTransparency = 1
                hidden.Text = ""
                hidden.PlaceholderText = item.placeholder
                hidden.PlaceholderColor3 = Color3.fromRGB(80,80,80)
                hidden.TextColor3 = Color3.fromRGB(220,220,220)
                hidden.TextSize = 14
                hidden.Font = Enum.Font.Code
                hidden.Parent = inputGui
                hidden.FocusLost:Connect(function()
                    library.flags[flag] = hidden.Text
                    if item.cb then item.cb(hidden.Text) end
                end)
                item.inputObj = hidden
                table.insert(section.items, item)
            end
            function secActions:Dropdown(text, flag, list, callbackOrMulti, callback)
                local multi, cb = false, nil
                if type(callbackOrMulti) == "boolean" then multi = callbackOrMulti; cb = callback
                elseif type(callbackOrMulti) == "function" then cb = callbackOrMulti end
                local item = {type="Dropdown", text=text, flag=flag, list=list, multi=multi, selected=multi and (library.flags[flag] or {}) or nil, opened=false, cb=cb}
                if multi and not library.flags[flag] then library.flags[flag] = {} end
                table.insert(section.items, item)
            end
            function secActions:Slider(text, flag, min, max, default, callback)
                local item = {type="Slider", text=text, flag=flag, min=min, max=max, value=default, callback=callback, dragging=false}
                library.flags[flag] = default
                table.insert(section.items, item)
            end
            function secActions:Button(text, callback)
                table.insert(section.items, {type="Button", text=text, callback=callback})
            end
            return secActions
        end
        return tabActions
    end
    return windowActions
end

return library
