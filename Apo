                    Position = UDim2.new(1, -62, 0.5, -11),
                    BackgroundColor3 = currentColor,
                    BorderSizePixel = 0,
                    ZIndex = 7,
                    Parent = row
                })
                utility.corner(preview, 5)
                utility.stroke(preview, library.theme.border, 1, 0.3)

                -- Expanded hue picker
                local pickerOpen = false
                local pickerFrame = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    BackgroundColor3 = library.theme.bg,
                    BorderSizePixel = 0,
                    Visible = false,
                    ZIndex = 15,
                    Parent = items
                })
                utility.corner(pickerFrame, 8)
                utility.stroke(pickerFrame, library.theme.border, 1, 0.3)

                local hueBar = utility.create("Frame", {
                    Size = UDim2.new(1, -16, 0, 16),
                    Position = UDim2.new(0, 8, 0, 8),
                    BorderSizePixel = 0,
                    ZIndex = 16,
                    Parent = pickerFrame
                })
                utility.corner(hueBar, 4)

                -- Rainbow gradient
                local hueColors = {}
                for i = 0, 6 do
                    table.insert(hueColors, Color3.fromHSV(i / 6, 1, 1))
                end
                utility.create("UIGradient", {
                    Color = utility.gradient(hueColors),
                    Rotation = 0,
                    Parent = hueBar
                })

                local hueThumb = utility.create("Frame", {
                    Size = UDim2.new(0, 10, 1, 4),
                    Position = UDim2.new(0, -5, 0, -2),
                    BackgroundColor3 = Color3.new(1,1,1),
                    BorderSizePixel = 0,
                    ZIndex = 17,
                    Parent = hueBar
                })
                utility.corner(hueThumb, 3)

                local hueBtn = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    ZIndex = 18,
                    Parent = hueBar
                })

                local currentH, currentS, currentV = currentColor:ToHSV()

                local function updateColor()
                    currentColor = Color3.fromHSV(currentH, currentS, currentV)
                    preview.BackgroundColor3 = currentColor
                    library.flags[flag] = currentColor
                    if callback then callback(currentColor) end
                end

                local hueDragging = false
                local function updateHue(input)
                    local perc = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
                    currentH = perc
                    hueThumb.Position = UDim2.new(perc, -5, 0, -2)
                    updateColor()
                end

                hueBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        hueDragging = true; updateHue(input)
                    end
                end)
                services.UserInputService.InputChanged:Connect(function(input)
                    if hueDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        updateHue(input)
                    end
                end)
                services.UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then hueDragging = false end
                end)

                preview.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        pickerOpen = not pickerOpen
                        pickerFrame.Visible = pickerOpen
                        utility.tween(pickerFrame, {0.2}, {Size = UDim2.new(1, 0, 0, pickerOpen and 36 or 0)})
                    end
                end)
            end

            return sectionActions
        end

        return tabActions
    end

    -- Search logic (searches section names AND item text labels)
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(searchBox.Text)
        if not (currentTab and currentTab.LeftCol and currentTab.RightCol) then return end
        for _, col in ipairs({currentTab.LeftCol, currentTab.RightCol}) do
            for _, child in ipairs(col:GetChildren()) do
                if child.Name == "ZalSection" then
                    if query == "" then
                        child.Visible = true
                    else
                        local match = false
                        -- Check section title
                        local header = child:FindFirstChildOfClass("TextButton")
                        if header then
                            local lbl = header:FindFirstChildWhichIsA("TextLabel")
                            if lbl and string.find(string.lower(lbl.Text), query, 1, true) then
                                match = true
                            end
                        end
                        -- Check item labels
                        if not match then
                            for _, desc in ipairs(child:GetDescendants()) do
                                if desc:IsA("TextLabel") and string.find(string.lower(desc.Text), query, 1, true) then
                                    match = true; break
                                end
                            end
                        end
                        child.Visible = match
                    end
                end
            end
        end
    end)

    return windowActions
end

return library
