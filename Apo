function library:Notify(opts)
    opts = opts or {}
    local title = opts.Title or "ZalHub"
    local msg = opts.Content or ""
    local dur = opts.Duration or 4
    
    local frame = create("Frame", {
        Size = UDim2.new(0, 280, 0, 0),
        Position = UDim2.new(1, 300, 1, 0),
