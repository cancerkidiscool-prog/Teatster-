                end)
                btn.MouseLeave:Connect(function()
                    tween(btn, 0.12, {BackgroundColor3 = Color3.fromRGB(22, 22, 30)})
                end)
                btn.MouseButton1Click:Connect(function()
                    -- click feedback
                    tween(btn, 0.06, {BackgroundColor3 = library.accent})
                    task.wait(0.06)
                    tween(btn, 0.15, {BackgroundColor3 = Color3.fromRGB(22, 22, 30)})
                    if callback then callback() end
                end)
            end
            
            -- INFO TIP
            function api:Info(text)
                local box = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundColor3 = Color3.fromRGB(22, 20, 32),
                    BorderSizePixel = 0,
                    ZIndex = 7,
                    Parent = items
                })
                addCorner(box, 6)
                addStroke(box, Color3.fromRGB(45, 38, 65), 1, 0.6)
                
                create("TextLabel", {
                    Size = UDim2.new(0, 18, 0, 18),
                    Position = UDim2.new(0, 8, 0, 7),
                    BackgroundTransparency = 1,
                    Text = "⭐",
                    TextSize = 12,
                    ZIndex = 8,
                    Parent = box
                })
                create("TextLabel", {
                    Size = UDim2.new(1, -36, 0, 0),
                    Position = UDim2.new(0, 30, 0, 7),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(150, 150, 170),
                    TextSize = 11,
                    Font = Enum.Font.Code,
                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 8,
                    Parent = box
                })
                create("UIPadding", {PaddingBottom = UDim.new(0, 9), Parent = box})
            end
            
            return api
        end
        
        return tabApi
    end
    
    -- search filtering
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local q = searchBox.Text:lower()
        if not activeTab then return end
        
        for _, col in ipairs({activeTab.LeftCol, activeTab.RightCol}) do
            for _, child in ipairs(col:GetChildren()) do
                if child.Name == "ZalSection" then
                    local lbl = child:FindFirstChildWhichIsA("TextLabel", true)
                    if lbl then
                        child.Visible = q == "" or lbl.Text:lower():find(q, 1, true) ~= nil
                    end
                end
            end
        end
    end)
    
    -- "/" shortcut to focus search
    uis.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.Slash then
            searchBox:CaptureFocus()
        end
    end)
    
    return win
end

return library
