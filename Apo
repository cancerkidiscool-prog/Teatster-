                    isOpen = not isOpen
                    listFrame.Visible = isOpen
                    if isOpen then
                        listFrame.Size = UDim2.new(1, 0, 0, math.min(totalH, maxH))
                        listFrame.CanvasPosition = Vector2.new(0, 0)
                    else
                        listFrame.Size = UDim2.new(1, 0, 0, 0)
                    end
                end)
                
                if not multi then
                    -- single select
                    for _, v in ipairs(list) do
                        local item = create("TextButton", {
                            Size = UDim2.new(1, 0, 0, itemH),
                            BackgroundColor3 = Color3.fromRGB(18, 18, 26),
                            BorderSizePixel = 0,
                            Text = "  " .. v,
                            TextColor3 = Color3.fromRGB(165, 165, 178),
                            TextSize = 12,
                            Font = Enum.Font.Code,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 26,
                            Parent = listFrame
                        })
                        item.MouseEnter:Connect(function()
                            item.BackgroundColor3 = Color3.fromRGB(28, 24, 42)
                        end)
                        item.MouseLeave:Connect(function()
                            item.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
                        end)
                        item.MouseButton1Click:Connect(function()
                            dropBtn.Text = "  " .. v
                            isOpen = false
                            listFrame.Visible = false
                            listFrame.Size = UDim2.new(1, 0, 0, 0)
                            library.flags[flag] = v
                            if callback then callback(v) end
                        end)
                    end
                else
                    -- multi select
                    local selected = library.flags[flag]
                    if type(selected) ~= "table" then
                        selected = {}
                        library.flags[flag] = selected
                    end
                    
                    local function refreshText()
                        if #selected == 0 then
                            dropBtn.Text = "  Select..."
                        elseif #selected <= 2 then
                            dropBtn.Text = "  " .. table.concat(selected, ", ")
                        else
                            dropBtn.Text = "  " .. #selected .. " selected"
                        end
                    end
                    refreshText()
                    
                    for _, v in ipairs(list) do
                        local item = create("TextButton", {
                            Size = UDim2.new(1, 0, 0, itemH),
                            BackgroundColor3 = Color3.fromRGB(18, 18, 26),
                            BorderSizePixel = 0,
                            Text = "",
