            })
            local itemLayout = utility.create("UIListLayout", {
                Padding = UDim.new(0,4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = itemsFrame,
            })
            local collapsed = false
            headerBtn.MouseButton1Click:Connect(function()
                collapsed = not collapsed
                itemsFrame.Visible = not collapsed
                utility.tween(arrow, {0.2}, {Rotation = collapsed and 270 or 0})
                updateCanvases()
            end)

            local sectionActions = {}

            -- ========== TOGGLE ==========
            function sectionActions:Toggle(text, flag, defaultOrCallback, callback)
                local default, cb = false, nil
                if typeof(defaultOrCallback) == "boolean" then default = defaultOrCallback; cb = callback
                elseif typeof(defaultOrCallback) == "function" then cb = defaultOrCallback end
                local enabled = default
                local toggleBtn = utility.create("TextButton", {
                    Size = UDim2.new(1,0,0,34), BackgroundTransparency = 1, Text = "", ZIndex = 6, Parent = itemsFrame,
                })
                local label = utility.create("TextLabel", {
                    AnchorPoint = Vector2.new(0,0.5), Size = UDim2.new(1,-80,0,20),
                    Position = UDim2.new(0,12,0.5,0), BackgroundTransparency = 1, Text = text,
                    TextColor3 = Color3.fromRGB(200,200,200), TextSize = 13,
                    Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7, Parent = toggleBtn,
                })
                local track = utility.create("Frame", {
                    Size = UDim2.new(0,42,0,22), Position = UDim2.new(1,-50,0.5,-11),
                    BackgroundColor3 = enabled and library.accent or Color3.fromRGB(40,40,40), ZIndex = 7, Parent = toggleBtn,
                })
                utility.create("UICorner", { CornerRadius = UDim.new(0,11), Parent = track })
                utility.stroke(track, Color3.fromRGB(60,60,60), 1)
                local knob = utility.create("Frame", {
                    Size = UDim2.new(0,18,0,18),
                    Position = enabled and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9),
                    BackgroundColor3 = Color3.new(1,1,1), ZIndex = 8, Parent = track,
                })
                utility.create("UICorner", { CornerRadius = UDim.new(0,9), Parent = knob })
                toggleBtn.MouseButton1Click:Connect(function()
                    enabled = not enabled
                    utility.tween(knob, {0.25, Enum.EasingStyle.Quart}, {
                        Position = enabled and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9)
                    })
                    utility.tween(track, {0.25, Enum.EasingStyle.Quart}, {
                        BackgroundColor3 = enabled and library.accent or Color3.fromRGB(40,40,40)
                    })
                    library.flags[flag] = enabled
                    if cb then cb(enabled) end
                end)
                -- Tooltip
                if text:len() > 0 then
                    label.MouseEnter:Connect(function()
                        local tip = utility.create("TextLabel", {
                            Text = text, Size = UDim2.new(0,0,0,20), Position = UDim2.new(0,0,1,5),
                            BackgroundColor3 = Color3.fromRGB(25,25,25), TextColor3 = Color3.new(1,1,1),
                            TextSize = 12, Font = Enum.Font.Gotham, ZIndex = 10, Parent = label,
                            AutomaticSize = Enum.AutomaticSize.X, BorderSizePixel = 0,
                        })
                        utility.create("UICorner", { CornerRadius = UDim.new(0,4), Parent = tip })
                        task.delay(1.5, function() if tip then tip:Destroy() end end)
                    end)
                    label.MouseLeave:Connect(function()
                        for _, child in ipairs(label:GetChildren()) do if child:IsA("TextLabel") then child:Destroy() end end
                    end)
                end
            end

            -- ========== BUTTON ==========
            function sectionActions:Button(text, callback)
                local btn = utility.create("TextButton", {
                    Size = UDim2.new(1,0,0,36), BackgroundColor3 = Color3.fromRGB(25,25,25),
                    BorderSizePixel = 0, Text = text, TextColor3 = Color3.fromRGB(220,220,220),
                    TextSize = 14, Font = Enum.Font.Gotham, ZIndex = 6, Parent = itemsFrame,
                })
                utility.stroke(btn, Color3.fromRGB(50,50,50), 1)
                utility.create("UICorner", { CornerRadius = UDim.new(0,8), Parent = btn })
                btn.MouseButton1Click:Connect(function() if callback then callback() end end)
            end

            -- ========== TEXTBOX ==========
            function sectionActions:Textbox(text, flag, placeholder, callback)
                local frame = utility.create("Frame", {
                    Size = UDim2.new(1,0,0,55), BackgroundTransparency = 1, ZIndex = 6, Parent = itemsFrame,
                })
                utility.create("TextLabel", {
                    Size = UDim2.new(1,0,0,22), BackgroundTransparency = 1, Text = text,
