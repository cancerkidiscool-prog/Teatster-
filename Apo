    ------------------------------------------------------------------
    -- watermark / toggle button
    ------------------------------------------------------------------
    local toggleGui = utility.create("ScreenGui", {
        Name = "ZalHub_Toggle",
        Parent = game:GetService("CoreGui"),
        ResetOnSpawn = false,
        DisplayOrder = 999,
    })
    local toggleBtn = utility.create("TextButton", {
        Name = "ToggleBtn",
        Size = UDim2.new(0, 140, 0, 26),
        Position = UDim2.new(0, 20, 0, 10),
        BackgroundColor3 = theme.titlebar,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "ZalHub [ON]",
        TextColor3 = theme.text,
        Font = Enum.Font.Code,
        TextSize = 14,
        ZIndex = 100,
        Parent = toggleGui,
    })
    local toggleStroke = utility.stroke(toggleBtn, theme.outline, 1)
    local toggleAccent = utility.create("Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = library.accent,
        BorderSizePixel = 0,
        ZIndex = 101,
        Parent = toggleBtn,
    })

    local isOpen = true
    local function toggleWindow()
        isOpen = not isOpen
        holder.Visible = isOpen
        toggleBtn.Text = isOpen and "ZalHub [ON]" or "ZalHub [OFF]"
        toggleBtn.TextColor3 = isOpen and theme.text or theme.dimText
        toggleStroke.Color = isOpen and theme.outline or Color3.fromRGB(90, 90, 90)
