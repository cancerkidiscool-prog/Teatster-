    Name = "ZalHub_Notify", Parent = CoreGui,
    ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999
})
local NotifyList = U.new("Frame", {
    Size = UDim2.new(0, 340, 1, 0),
