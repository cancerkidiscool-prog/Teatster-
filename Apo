--[[
    ZalHub Premium UI Library v2.0
    Features:
    - Modern glassmorphism design, layered popups (dropdowns, color picker on top)
    - Original slider style with gradient fill and value display
    - Interactive Color Picker with HSV + Transparency (Alpha)
    - Keybind with modes (Toggle, Hold, Always)
    - Enhanced Dropdown: search, multi-select, select all/none
    - New components: Paragraph, Radio, ToggleList, Tooltips
    - Smooth animations, customizable accent
    - Better Z‑index handling: popups drawn on overlay layer
    - Collapsible sections, global search, minimizable window
]]

repeat wait() until game:IsLoaded()

local library = {
    flags = {},
    accent = Color3.fromRGB(117, 52, 235),
    outline = { Color3.fromRGB(117, 52, 235), Color3.fromRGB(200, 100, 255) },
}

function library:SetAccent(color)
    library.accent = color
    library.outline = {
        color,
        Color3.fromRGB(
            math.clamp(color.R * 255 + 100, 0, 255),
            math.clamp(color.G * 255 + 50, 0, 255),
            math.clamp(color.B * 255 + 100, 0, 255)
        )
    }
end

local services = setmetatable({}, { __index = function(_, s) return game:GetService(s) end })
local tweenService = services.TweenService
local userInput = services.UserInputService
local coreGui = game:GetService("CoreGui") or game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

local utility = {}
function utility.create(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props) do obj[k] = v end
    return obj
end
function utility.gradient(colors)
    local pts = {}
    for i, c in ipairs(colors) do pts[i] = ColorSequenceKeypoint.new((i-1)/(#colors-1), c) end
    return ColorSequence.new(pts)
end
function utility.tween(obj, info, props)
    local t = tweenService:Create(obj, TweenInfo.new(table.unpack(info)), props)
    t:Play(); return t
end
function utility.stroke(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(50,50,50)
    s.Thickness = thickness or 1; s.Transparency = 0.5; s.Parent = obj; return s
end
function utility.dragify(obj, input)
    local dragInput, startPos, dragging
    local target = input or obj
    target.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true; startPos = inp.Position
            local conn; conn = inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then dragging = false; conn:Disconnect() end
            end)
        end
    end)
    target.InputChanged:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then dragInput = inp end
    end)
    userInput.InputChanged:Connect(function(inp)
        if inp == dragInput and dragging then
            local delta = inp.Position - startPos
            obj.Position = UDim2.new(obj.Position.X.Scale, obj.Position.X.Offset + delta.X, obj.Position.Y.Scale, obj.Position.Y.Offset + delta.Y)
        end
    end)
end

-- ========== Notification ==========
local notifyHolder = coreGui:FindFirstChild("ZalHub_NotifyHolder") or utility.create("ScreenGui", {
    Name = "ZalHub_NotifyHolder", Parent = coreGui, ResetOnSpawn = false, IgnoreGuiInset = true,
})
