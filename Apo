                local check = utility.create("Frame", {
                    Size = UDim2.new(1, -4, 1, -4),
                    Position = UDim2.new(0, 2, 0, 2),
                    BackgroundColor3 = library.accent,
                    BackgroundTransparency = enabled and 0 or 1,
                    BorderSizePixel = 0,
                    ZIndex = 8,
