                        Size = UDim2.new(0, 6, 1, 4),
                        Position = UDim2.new(h, -3, 0, -2),
                        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                        BorderSizePixel = 0,
                        ZIndex = 52,
                        Parent = hueFrame
                    })
                    utility.create("UICorner", {CornerRadius = UDim.new(0, 3), Parent = hueCursor})
                    utility.stroke(hueCursor, Color3.fromRGB(0, 0, 0), 1, 0)

                    -- Preview + Hex
                    local preview = utility.create("Frame", {
                        Size = UDim2.new(0, 40, 0, 28),
                        Position = UDim2.new(0, 12, 0, 190),
                        BackgroundColor3 = defaultColor,
                        BorderSizePixel = 0,
                        ZIndex = 51,
                        Parent = pickerFrame
                    })
                    utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = preview})

                    local hexBox = utility.create("TextBox", {
                        Size = UDim2.new(0, 130, 0, 28),
                        Position = UDim2.new(0, 60, 0, 190),
                        BackgroundColor3 = Color3.fromRGB(30, 30, 38),
                        BorderSizePixel = 0,
                        Text = Color3ToHex(defaultColor),
                        TextColor3 = Color3.fromRGB(230, 230, 240),
                        TextSize = 13,
                        Font = Enum.Font.Gotham,
                        Parent = pickerFrame
                    })
                    utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = hexBox})

                    -- RGB Inputs
                    local function makeRGBBox(posX, label, value)
                        local box = utility.create("TextBox", {
                            Size = UDim2.new(0, 54, 0, 26),
                            Position = UDim2.new(0, posX, 0, 230),
                            BackgroundColor3 = Color3.fromRGB(30, 30, 38),
                            BorderSizePixel = 0,
                            Text = tostring(value),
                            TextColor3 = Color3.fromRGB(230, 230, 240),
                            TextSize = 12,
                            Font = Enum.Font.Gotham,
                            Parent = pickerFrame
                        })
                        utility.create("UICorner", {CornerRadius = UDim.new(0, 5), Parent = box})
                        return box
                    end

                    local rBox = makeRGBBox(12, "R", math.floor(defaultColor.R * 255))
                    local gBox = makeRGBBox(74, "G", math.floor(defaultColor.G * 255))
                    local bBox = makeRGBBox(136, "B", math.floor(defaultColor.B * 255))

                    local function updateColor(newH, newS, newV, fromInput)
                        h, s, v = newH or h, newS or s, newV or v
                        local r, g, b = HSVToRGB(h, s, v)
                        local newColor = Color3.fromRGB(r, g, b)

                        colorBtn.BackgroundColor3 = newColor
                        preview.BackgroundColor3 = newColor
                        library.flags[flag] = newColor

                        -- Update SV gradient base color
                        local pureR, pureG, pureB = HSVToRGB(h, 1, 1)
                        satGradient.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
                            ColorSequenceKeypoint.new(1, Color3.fromRGB(pureR, pureG, pureB))
                        })

                        svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                        hueCursor.Position = UDim2.new(h, -3, 0, -2)

                        if not fromInput then
                            hexBox.Text = Color3ToHex(newColor)
                            rBox.Text = tostring(r)
                            gBox.Text = tostring(g)
                            bBox.Text = tostring(b)
                        end

                        if callback then callback(newColor) end
                    end

                    -- SV interaction
                    local svDragging = false
                    svFrame.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            svDragging = true
                            local rel = input.Position - svFrame.AbsolutePosition
                            local newS = math.clamp(rel.X / svFrame.AbsoluteSize.X, 0, 1)
                            local newV = 1 - math.clamp(rel.Y / svFrame.AbsoluteSize.Y, 0, 1)
                            updateColor(nil, newS, newV)
                        end
                    end)
                    services.UserInputService.InputChanged:Connect(function(input)
                        if svDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                            local rel = input.Position - svFrame.AbsolutePosition
                            local newS = math.clamp(rel.X / svFrame.AbsoluteSize.X, 0, 1)
                            local newV = 1 - math.clamp(rel.Y / svFrame.AbsoluteSize.Y, 0, 1)
                            updateColor(nil, newS, newV)
                        end
                    end)
                    services.UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            svDragging = false
                        end
                    end)

                    -- Hue interaction
                    local hueDragging = false
                    hueFrame.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            hueDragging = true
                            local rel = (input.Position.X - hueFrame.AbsolutePosition.X) / hueFrame.AbsoluteSize.X
                            updateColor(math.clamp(rel, 0, 1), nil, nil)
                        end
                    end)
                    services.UserInputService.InputChanged:Connect(function(input)
                        if hueDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                            local rel = (input.Position.X - hueFrame.AbsolutePosition.X) / hueFrame.AbsoluteSize.X
                            updateColor(math.clamp(rel, 0, 1), nil, nil)
                        end
                    end)
                    services.UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            hueDragging = false
                        end
                    end)

                    -- Hex + RGB inputs
                    hexBox.FocusLost:Connect(function()
                        local hex = hexBox.Text:gsub("#", "")
                        if #hex == 6 then
                            local r = tonumber(hex:sub(1, 2), 16) or 255
                            local g = tonumber(hex:sub(3, 4), 16) or 255
                            local b = tonumber(hex:sub(5, 6), 16) or 255
                            local nh, ns, nv = RGBToHSV(r, g, b)
                            updateColor(nh, ns, nv, true)
                        end
                    end)

                    local function rgbChanged()
                        local r = math.clamp(tonumber(rBox.Text) or 0, 0, 255)
                        local g = math.clamp(tonumber(gBox.Text) or 0, 0, 255)
                        local b = math.clamp(tonumber(bBox.Text) or 0, 0, 255)
                        local nh, ns, nv = RGBToHSV(r, g, b)
                        updateColor(nh, ns, nv, true)
                    end
                    rBox.FocusLost:Connect(rgbChanged)
                    gBox.FocusLost:Connect(rgbChanged)
                    bBox.FocusLost:Connect(rgbChanged)

                    -- Initial cursor positions
                    updateColor(h, s, v, true)
                end)
            end

