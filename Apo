            -- ═══ BUTTON ═══
            function G:Button(opts)
                opts = opts or {}
                local text = opts.Text or "Execute"
                local cb = opts.Callback
                local confirm = opts.Confirm or false

                local btn = U.new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24),
                    BackgroundColor3 = ZalHub.theme.elementBg, BorderSizePixel = 0,
                    Text = text, TextColor3 = ZalHub.theme.text,
                    TextSize = 11, Font = Enum.Font.GothamSemibold,
                    ZIndex = 8, Parent = items
                })
                U.corner(btn, 2)
                U.stroke(btn, ZalHub.theme.border, 1, 0.3)
                U.hover(btn, ZalHub.theme.elementBg, ZalHub.theme.elementHover)

                btn.MouseButton1Click:Connect(function()
                    if confirm then
                        if btn.Text == "CONFIRM?" then
                            btn.Text = text; btn.TextColor3 = ZalHub.theme.text
                            if cb then cb() end
                        else
                            btn.Text = "CONFIRM?"; btn.TextColor3 = ZalHub.theme.danger
                            task.delay(2, function()
                                if btn.Text == "CONFIRM?" then
                                    btn.Text = text; btn.TextColor3 = ZalHub.theme.text
                                end
                            end)
                        end
                        return
                    end
                    U.tween(btn, 0.05, {BackgroundColor3 = ZalHub.accent})
                    task.delay(0.1, function() U.tween(btn, 0.15, {BackgroundColor3 = ZalHub.theme.elementBg}) end)
                    if cb then cb() end
                end)
            end

            -- ═══ KEYBIND (standalone) with mode ═══
            function G:Keybind(opts)
                opts = opts or {}
                local text = opts.Text or "Bind"
                local flag = opts.Flag or text
                local default = opts.Default or Enum.KeyCode.Unknown
                local mode = opts.Mode or "Toggle"
                local cb = opts.Callback
                ZalHub.flags[flag] = {key = default, mode = mode}
                local listening = false

                local row = U.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1,
                    ZIndex = 8, Parent = items
                })
                U.new("TextLabel", {
                    Size = UDim2.new(1, -110, 1, 0), BackgroundTransparency = 1,
                    Text = text, TextColor3 = ZalHub.theme.textSub,
                    TextSize = 11, Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9, Parent = row
                })

                local kBtn = U.new("TextButton", {
                    Size = UDim2.new(0, 50, 0, 16), Position = UDim2.new(1, -105, 0.5, -8),
                    BackgroundColor3 = ZalHub.theme.inputBg, BorderSizePixel = 0,
                    Text = default == Enum.KeyCode.Unknown and "[-]" or "[" .. default.Name .. "]",
                    TextColor3 = ZalHub.theme.textDim, TextSize = 9,
                    Font = Enum.Font.RobotoMono, ZIndex = 9, Parent = row
                })
                U.corner(kBtn, 2)
                U.stroke(kBtn, ZalHub.theme.border, 1, 0.5)

                local modeBtn = U.new("TextButton", {
                    Size = UDim2.new(0, 48, 0, 16), Position = UDim2.new(1, -52, 0.5, -8),
                    BackgroundColor3 = ZalHub.theme.inputBg, BorderSizePixel = 0,
                    Text = mode, TextColor3 = ZalHub.theme.textSub,
                    TextSize = 9, Font = Enum.Font.Gotham, ZIndex = 9, Parent = row
                })
                U.corner(modeBtn, 2)
                U.stroke(modeBtn, ZalHub.theme.border, 1, 0.5)

                local function cycleMode()
                    if mode == "Toggle" then mode = "Hold"
                    elseif mode == "Hold" then mode = "Always"
                    else mode = "Toggle" end
                    modeBtn.Text = mode
                    ZalHub.flags[flag].mode = mode
                end

                modeBtn.MouseButton1Click:Connect(cycleMode)

                kBtn.MouseButton1Click:Connect(function()
                    listening = true; kBtn.Text = "[...]"; kBtn.TextColor3 = ZalHub.accent
                end)
                UIS.InputBegan:Connect(function(input, gp)
                    if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                        listening = false
                        if input.KeyCode == Enum.KeyCode.Escape then
                            ZalHub.flags[flag].key = Enum.KeyCode.Unknown; kBtn.Text = "[-]"
                        else
                            ZalHub.flags[flag].key = input.KeyCode; kBtn.Text = "[" .. input.KeyCode.Name .. "]"
                        end
                        kBtn.TextColor3 = ZalHub.theme.textDim
                    elseif not listening and not gp and input.KeyCode == ZalHub.flags[flag].key then
                        local m = ZalHub.flags[flag].mode
                        if m == "Toggle" then
                            ZalHub.flags[flag .. "_state"] = not ZalHub.flags[flag .. "_state"]
                            if cb then cb(ZalHub.flags[flag .. "_state"]) end
                        elseif m == "Hold" then
                            ZalHub.flags[flag .. "_state"] = true
                            if cb then cb(true) end
                        elseif m == "Always" then
                            -- always true while window exists, handled by script logic
                        end
                    end
                end)
                UIS.InputEnded:Connect(function(input)
                    if not listening and ZalHub.flags[flag] and input.KeyCode == ZalHub.flags[flag].key then
                        local m = ZalHub.flags[flag].mode
                        if m == "Hold" then
                            ZalHub.flags[flag .. "_state"] = false
                            if cb then cb(false) end
                        end
                    end
                end)
            end

            -- ═══ COLOR PICKER (standalone) ═══
            function G:ColorPicker(opts)
                opts = opts or {}
                local text = opts.Text or "Color"
                local flag = opts.Flag or text
                local default = opts.Default or Color3.new(1, 1, 1)
                local cb = opts.Callback
                ZalHub.flags[flag] = default

                local frame = U.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1,
                    ZIndex = 8, Parent = items
                })
                U.new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
                    Text = text, TextColor3 = ZalHub.theme.textSub,
                    TextSize = 11, Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9, Parent = frame
                })
                local cBtn = U.new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0, 16),
                    BackgroundColor3 = default, BorderSizePixel = 0,
                    Text = "", ZIndex = 9, Parent = frame
                })
                U.corner(cBtn, 2)
                U.stroke(cBtn, ZalHub.theme.border, 1, 0.3)

                local function openPicker()
                    local picker = U.new("Frame", {
                        Size = UDim2.new(0, 220, 0, 180),
                        BackgroundColor3 = ZalHub.theme.panelBg, BorderSizePixel = 0,
                        ZIndex = 250, Parent = overlay
                    })
                    U.corner(picker, 3)
                    U.stroke(picker, ZalHub.accent, 1)
                    picker.Position = UDim2.new(0, math.clamp(cBtn.AbsolutePosition.X - 100, 0, 500), 0,
                        cBtn.AbsolutePosition.Y + cBtn.AbsoluteSize.Y + 5)

                    local svBox = U.new("ImageButton", {
                        Size = UDim2.new(0, 150, 0, 150), Position = UDim2.new(0, 5, 0, 5),
                        BackgroundColor3 = Color3.new(1,1,1), Image = "rbxassetid://284402810",
                        BorderSizePixel = 0, ZIndex = 251, Parent = picker
                    })
                    U.corner(svBox, 2)
                    local svGrad = U.new("UIGradient", {
                        Color = ColorSequence.new{ColorSequenceKeypoint.new(0, Color3.new(1,1,1)), ColorSequenceKeypoint.new(1, Color3.fromHSV(0,1,1))},
                        Rotation = 0, Parent = svBox
                    })
                    local wbGrad = U.new("UIGradient", {
                        Transparency = NumberSequence.new{NumberSequenceKeypoint.new(0,0), NumberSequenceKeypoint.new(1,1)},
                        Rotation = 90, Parent = svBox
                    })
                    local svCursor = U.new("Frame", {
                        Size = UDim2.new(0, 8, 0, 8), BackgroundColor3 = Color3.new(1,1,1),
                        BorderSizePixel = 0, ZIndex = 252, Parent = svBox
                    })
                    U.corner(svCursor, 4)
                    U.stroke(svCursor, Color3.new(0,0,0), 1)
                    svCursor.Position = UDim2.new(1, -4, 0, -4)

                    local hueBar = U.new("ImageButton", {
                        Size = UDim2.new(0, 18, 0, 150), Position = UDim2.new(0, 160, 0, 5),
                        BackgroundColor3 = Color3.new(1,1,1), Image = "rbxassetid://284402810",
                        BorderSizePixel = 0, ZIndex = 251, Parent = picker
                    })
                    U.corner(hueBar, 2)
                    U.new("UIGradient", {
                        Color = ColorSequence.new{
                            ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)),
                            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,255,0)),
                            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
                            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0,255,255)),
                            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0,0,255)),
                            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
                            ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0)),
                        }, Rotation = 90, Parent = hueBar
                    })
                    local hueCursor = U.new("Frame", {
                        Size = UDim2.new(0, 22, 0, 4), BackgroundColor3 = Color3.new(1,1,1),
                        BorderSizePixel = 0, ZIndex = 252, Parent = hueBar
                    })
                    U.stroke(hueCursor, Color3.new(0,0,0), 1)
                    hueCursor.Position = UDim2.new(0, -2, 0, -2)

                    local alphaBar = U.new("ImageButton", {
                        Size = UDim2.new(0, 18, 0, 150), Position = UDim2.new(0, 183, 0, 5),
                        BackgroundColor3 = Color3.new(1,1,1), Image = "rbxassetid://284402810",
                        BorderSizePixel = 0, ZIndex = 251, Parent = picker
                    })
                    U.corner(alphaBar, 2)
                    local alphaGrad = U.new("UIGradient", {
                        Transparency = NumberSequence.new{NumberSequenceKeypoint.new(0,0), NumberSequenceKeypoint.new(1,1)},
                        Rotation = 90, Parent = alphaBar
                    })
                    local alphaCursor = U.new("Frame", {
                        Size = UDim2.new(0, 22, 0, 4), BackgroundColor3 = Color3.new(1,1,1),
                        BorderSizePixel = 0, ZIndex = 252, Parent = alphaBar
                    })
                    U.stroke(alphaCursor, Color3.new(0,0,0), 1)
                    alphaCursor.Position = UDim2.new(0, -2, 1, -2)

                    local h,s,v = default:ToHSV()
                    local alpha = 1
                    local function updateColor()
                        local col = Color3.fromHSV(h, s, v)
                        cBtn.BackgroundColor3 = col
                        ZalHub.flags[flag] = col
                        if cb then cb(col, alpha) end
                    end

                    local function updateSV()
                        svGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, Color3.new(1,1,1)), ColorSequenceKeypoint.new(1, Color3.fromHSV(h,1,1))}
                        svCursor.Position = UDim2.new(s, -4, 1-v, -4)
                        updateColor()
                    end

                    local svDrag, hueDrag, alphaDrag = false, false, false
                    svBox.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 then svDrag = true end
                    end)
                    hueBar.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 then hueDrag = true end
                    end)
                    alphaBar.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 then alphaDrag = true end
                    end)
                    UIS.InputChanged:Connect(function(inp)
                        if svDrag and inp.UserInputType == Enum.UserInputType.MouseMovement then
                            local mx = (inp.Position.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X
                            local my = (inp.Position.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y
                            s = math.clamp(mx, 0, 1); v = 1 - math.clamp(my, 0, 1)
                            updateSV()
                        elseif hueDrag and inp.UserInputType == Enum.UserInputType.MouseMovement then
                            local my = (inp.Position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y
                            h = math.clamp(my, 0, 1)
                            hueCursor.Position = UDim2.new(0, -2, h, -2)
                            updateSV()
                        elseif alphaDrag and inp.UserInputType == Enum.UserInputType.MouseMovement then
                            local my = (inp.Position.Y - alphaBar.AbsolutePosition.Y) / alphaBar.AbsoluteSize.Y
                            alpha = 1 - math.clamp(my, 0, 1)
                            alphaCursor.Position = UDim2.new(0, -2, 1-alpha, -2)
                            updateColor()
                        end
                    end)
                    UIS.InputEnded:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                            svDrag, hueDrag, alphaDrag = false, false, false
                        end
                    end)

                    local conn
                    conn = UIS.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 and picker then
                            local pos = UIS:GetMouseLocation()
                            if not (picker.AbsolutePosition.X <= pos.X and pos.X <= picker.AbsolutePosition.X + picker.AbsoluteSize.X
                                and picker.AbsolutePosition.Y <= pos.Y and pos.Y <= picker.AbsolutePosition.Y + picker.AbsoluteSize.Y) then
                                picker:Destroy()
                                conn:Disconnect()
                            end
                        end
                    end)
                    updateSV()
                end
                cBtn.MouseButton1Click:Connect(openPicker)
            end

            -- ═══ SEPARATOR ═══
            function G:Separator()
                U.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 8), BackgroundTransparency = 1,
                    ZIndex = 8, Parent = items
                })
                U.new("Frame", {
                    Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 0.5, 0),
                    BackgroundColor3 = ZalHub.theme.separator, BorderSizePixel = 0,
                    ZIndex = 9, Parent = items
                })
            end

            -- ═══ LABEL ═══
            function G:Label(txt)
                U.new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1,
                    Text = txt, TextColor3 = ZalHub.theme.textDim,
                    TextSize = 10, Font = Enum.Font.Gotham, TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 8, Parent = items
                })
            end

            return G
        end

        return Tab
    end

    -- ═══ GLOBAL SEARCH ═══
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(searchBox.Text)
        for _, col in ipairs({leftCol, rightCol}) do
            for _, group in ipairs(col:GetChildren()) do
                if group.Name:find("Group_") then
                    local title = group:FindFirstChild("Group_") and group:FindFirstChild("Group_"):FindFirstChild("TextLabel")
                    if title then
                        group.Visible = query == "" or string.find(string.lower(title.Text), query, 1, true) ~= nil
                    end
                end
            end
        end
    end)

    return Window
end

function ZalHub:Destroy()
    ZalHub.unloaded = true
    for _, g in ipairs(CoreGui:GetChildren()) do
        if g.Name:find("ZalHub") then g:Destroy() end
    end
end

return ZalHub
