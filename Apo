                local searchFrame = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 26),
                    BackgroundColor3 = Color3.fromRGB(28, 28, 36),
                    Parent = listFrame
                })
                local searchDropdown = utility.create("TextBox", {
                    Size = UDim2.new(1, -12, 1, -4),
                    Position = UDim2.new(0, 6, 0, 2),
                    BackgroundTransparency = 1,
                    PlaceholderText = "Filter...",
                    PlaceholderColor3 = Color3.fromRGB(100, 100, 120),
                    Text = "",
                    TextColor3 = Color3.fromRGB(220, 220, 230),
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    ClearTextOnFocus = false,
                    Parent = searchFrame
                })

                local selected = multi and (library.flags[flag] or {}) or {}
                if multi then library.flags[flag] = selected end

                local function updateButtonText()
                    if multi then
                        if #selected == 0 then
                            btn.Text = "  Select..."
                        elseif #selected <= 2 then
                            btn.Text = "  " .. table.concat(selected, ", ")
                        else
                            btn.Text = "  " .. #selected .. " selected"
                        end
                    else
                        btn.Text = "  " .. (selected[1] or "Select...")
                    end
                end
                updateButtonText()

                local function refreshItems()
                    for _, child in ipairs(listFrame:GetChildren()) do
                        if child ~= searchFrame and not child:IsA("UIListLayout") then
                            child:Destroy()
                        end
                    end

                    local filter = string.lower(searchDropdown.Text)
                    local count = 0

                    for _, v in ipairs(list) do
                        if filter == "" or string.find(string.lower(v), filter, 1, true) then
                            count += 1
                            local item = utility.create("TextButton", {
                                Size = UDim2.new(1, 0, 0, 26),
                                BackgroundColor3 = Color3.fromRGB(22, 22, 28),
                                BorderSizePixel = 0,
                                Text = "",
                                ZIndex = 21,
                                Parent = listFrame
                            })

                            local itemText = utility.create("TextLabel", {
                                Size = UDim2.new(1, -30, 1, 0),
                                Position = UDim2.new(0, 10, 0, 0),
                                BackgroundTransparency = 1,
                                Text = v,
                                TextColor3 = Color3.fromRGB(180, 180, 195),
                                TextSize = 13,
                                Font = Enum.Font.Gotham,
                                TextXAlignment = Enum.TextXAlignment.Left,
                                Parent = item
                            })

                            if multi then
                                local check = utility.create("TextLabel", {
                                    Size = UDim2.new(0, 22, 1, 0),
                                    Position = UDim2.new(1, -26, 0, 0),
                                    BackgroundTransparency = 1,
                                    Text = "✓",
                                    TextColor3 = library.accent,
                                    TextSize = 14,
                                    Font = Enum.Font.GothamBold,
                                    Visible = table.find(selected, v) ~= nil,
                                    Parent = item
                                })

                                item.MouseButton1Click:Connect(function()
                                    local idx = table.find(selected, v)
                                    if idx then
                                        table.remove(selected, idx)
                                        check.Visible = false
                                    else
                                        table.insert(selected, v)
                                        check.Visible = true
                                    end
                                    updateButtonText()
                                    if callback then callback(selected) end
                                end)
                            else
                                item.MouseButton1Click:Connect(function()
                                    selected = {v}
                                    library.flags[flag] = v
                                    updateButtonText()
                                    listFrame.Visible = false
                                    listFrame.Size = UDim2.new(1, 0, 0, 0)
                                    if callback then callback(v) end
                                end)
                            end
                        end
                    end

                    local height = math.min(26 + count * 28, 180)
                    listFrame.Size = UDim2.new(1, 0, 0, height)
                    listFrame.CanvasSize = UDim2.new(0, 0, 0, 26 + count * 28)
                end

                local opened = false
                btn.MouseButton1Click:Connect(function()
                    opened = not opened
                    listFrame.Visible = opened
                    if opened then
                        searchDropdown.Text = ""
                        refreshItems()
                    else
                        listFrame.Size = UDim2.new(1, 0, 0, 0)
                    end
                end)

                searchDropdown:GetPropertyChangedSignal("Text"):Connect(refreshItems)
            end

