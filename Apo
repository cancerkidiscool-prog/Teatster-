                PaddingLeft = UDim.new(0, 2),
                PaddingRight = UDim.new(0, 2),
                PaddingTop = UDim.new(0, 12),
                PaddingBottom = UDim.new(0, 12),
            })
            local layout = utility.create("UIListLayout", {
                FillDirection = Enum.FillDirection.Vertical,
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 16),
                Parent = col,
            })
            return col, layout
        end

        local leftCol, leftList = makeColumn(0, 0)
        local rightCol, rightList = makeColumn(0.5, 5)

        local function updateCanvas()
            leftCol.CanvasSize = UDim2.new(0, 0, 0, leftList.AbsoluteContentSize.Y + 30)
            rightCol.CanvasSize = UDim2.new(0, 0, 0, rightList.AbsoluteContentSize.Y + 30)
