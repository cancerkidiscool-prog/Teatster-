local function getSmartArmorData(character)
    local foundSet, highestCount, counts, isGodPlayer = "None", 0, {}, false
    for setName in pairs(armorSets) do counts[setName] = 0 end
    for _, item in pairs(character:GetChildren()) do
        local name = item.Name
        if item:IsA("Accessory") or item:IsA("Pants") or item:IsA("Shirt") or name:find("Chestplate") or name:find("Helmet") or name:find("Greaves") or name:find("Legs") or name:find("Boots") then
            for setName in pairs(armorSets) do
                if name:find(setName) then counts[setName] = counts[setName] + 1 break end
            end
        end
    end
    for setName, count in pairs(counts) do if count > highestCount then highestCount = count foundSet = setName end end
    if counts["God"] > 0 then isGodPlayer = true end
    return foundSet, isGodPlayer
end
