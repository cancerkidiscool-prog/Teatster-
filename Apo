            ------------------------------------------------------------
            -- slider (improved: centered Arcade value, purple gradient, rounded)
            ------------------------------------------------------------
            function sectionActions:Slider(text, flag, min, max, default, callback, suffix)
                local opts = {}
                if typeof(callback) == "table" then
                    opts = callback
                    callback = opts.callback
                    suffix = opts.suffix or suffix
                end
                suffix = suffix or ""
                local decimals = opts.decimals
                if decimals == nil then
                    decimals = (min % 1 == 0 and max % 1 == 0 and default % 1 == 0) and 0 or 2
                end

                local initialValue
                if library.flags[flag] ~= nil and type(library.flags[flag]) == "number" then
                    initialValue = math.clamp(library.flags[flag], min, max)
                else
                    initialValue = default
                    library.flags[flag] = initialValue
                end

                local function fmt(value)
                    if decimals <= 0 then return string.format("%d", value) end
                    return string.format("%." .. decimals .. "f", value)
                end

                local slider = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 38),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ZIndex = 6,
                    Parent = items,
                })

                -- Label: just the name, without value
                local label = utility.label(slider, text, {
                    Size = UDim2.new(1, 0, 0, 16),
                    TextColor3 = theme.text,
                    TextSize = 13,
                    ZIndex = 7,
                })

                -- Track background
                local bg = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 20),
                    Position = UDim2.new(0, 0, 0, 18),
                    BackgroundColor3 = theme.control,
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Text = "",
                    ClipsDescendants = true,
                    ZIndex = 7,
                    Parent = slider,
                })
                utility.stroke(bg, theme.controlOutline, 1)
                -- Rounded corners
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0, 4)
                corner.Parent = bg

                -- Fill with gradient (dark purple → light purple)
                local fill = utility.create("Frame", {
                    Size = UDim2.new((initialValue - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = library.accent,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = bg,
                })
                utility.create("UIGradient", {
                    Color = utility.gradient(library.outline),
                    Rotation = 0,
                    Parent = fill,
                })
                local fillCorner = Instance.new("UICorner")
                fillCorner.CornerRadius = UDim.new(0, 4)
                fillCorner.Parent = fill

                -- Centered value display (Arcade font)
                local valueLabel = utility.create("TextLabel", {
                    Size = UDim2.new(1, 0, 1, 0),
                    Position = UDim2.new(0.5, 0, 0.5, 0),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    BackgroundTransparency = 1,
                    Text = fmt(initialValue) .. suffix,
                    TextColor3 = theme.text,
                    TextSize = 13,
                    Font = Enum.Font.Arcade,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    TextYAlignment = Enum.TextYAlignment.Center,
                    ZIndex = 9,
                    Parent = bg,
                })

                local function setValue(value, fire)
                    value = math.clamp(utility.round(value, decimals), min, max)
                    fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
                    valueLabel.Text = fmt(value) .. suffix
                    library.flags[flag] = value
                    if fire ~= false and callback then callback(value) end
                end

                utility.draggableBar(bg, function(perc)
                    setValue(min + (max - min) * perc)
                end)

                local sliderObj = {
                    Set = function(_, value, fire)
                        setValue(value, fire)
                    end,
                }
                library.uiElements[flag] = sliderObj
                return sliderObj
            end

