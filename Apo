                    dropdownOptions.Visible = isOpen
                    if isOpen then
                        dropdownOptions.Size = UDim2.new(1, 0, 0, math.min(contentHeight, maxDropdownHeight))
                        dropdownOptions.CanvasSize = UDim2.new(1, 0, 0, contentHeight)
                        dropdownOptions.CanvasPosition = Vector2.new(0, 0)
                    else
                        dropdownOptions.Size = UDim2.new(1, 0, 0, 0)
                    end
                end)

                if not multi then
                    for _, v in next, list do
                        local option = util.create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 24),
                            BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                            BorderSizePixel = 0,
                            Text = v,
                            TextColor3 = Color3.fromRGB(160, 160, 160),
                            TextSize = 14,
                            Font = Enum.Font.Code,
                            ZIndex = 12,
                            Parent = dropdownOptions
                        })

                        option.MouseButton1Click:Connect(function()
                            dropdownButton.Text = v
                            isOpen = false
                            dropdownOptions.Visible = false
                            dropdownOptions.Size = UDim2.new(1, 0, 0, 0)
                            lib.flags[flag] = v
                            if cb then
                                cb(v)
                            end
                        end)
                    end
                else
                    local selected = lib.flags[flag]
                    if not selected or typeof(selected) ~= "table" then
                        selected = {}
                        lib.flags[flag] = selected
                    end

                    local function updateButtonText()
                        if #selected == 0 then
                            dropdownButton.Text = "Select..."
                        elseif #selected == 1 then
                            dropdownButton.Text = selected[1]
                        elseif #selected <= 3 then
                            dropdownButton.Text = table.concat(selected, ", ")
                        else
                            dropdownButton.Text = #selected .. " selected"
                        end
                    end
                    updateButtonText()

                    for _, v in next, list do
                        local option = util.create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 24),
                            BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                            BorderSizePixel = 0,
                            Text = "",
                            TextColor3 = Color3.fromRGB(160, 160, 160),
                            TextSize = 14,
                            Font = Enum.Font.Code,
                            ZIndex = 12,
                            Parent = dropdownOptions
                        })

                        local optionText = util.create("TextLabel", {
                            Size = UDim2.new(1, -30, 1, 0),
                            Position = UDim2.new(0, 5, 0, 0),
                            BackgroundTransparency = 1,
                            Text = v,
                            TextColor3 = Color3.fromRGB(160, 160, 160),
                            TextSize = 14,
                            Font = Enum.Font.Code,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 13,
                            Parent = option
                        })

                        local check = util.create("TextLabel", {
                            Size = UDim2.new(0, 20, 1, 0),
                            Position = UDim2.new(1, -25, 0, 0),
                            BackgroundTransparency = 1,
                            Text = "✔",
                            TextColor3 = lib.accent,
                            TextSize = 14,
                            Font = Enum.Font.Code,
                            TextXAlignment = Enum.TextXAlignment.Center,
                            ZIndex = 13,
                            Parent = option
                        })
                        check.Visible = table.find(selected, v) ~= nil

                        option.MouseButton1Click:Connect(function()
                            local idx = table.find(selected, v)
                            if idx then
                                table.remove(selected, idx)
                                check.Visible = false
                            else
                                table.insert(selected, v)
                                check.Visible = true
                            end
                            updateButtonText()
                            if cb then
                                cb(selected)
                            end
                        end)
                    end
                end
            end

            function section:Slider(text, flag, min, max, default, callback)
                local sliderContainer = util.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundTransparency = 1,
                    ZIndex = 6,
                    Parent = itemHolder
                })

                util.create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(180, 180, 180),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 7,
                    Parent = sliderContainer
                })

                local sliderTrack = util.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 20),
                    Position = UDim2.new(0, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Parent = sliderContainer
                })

                local sliderBg = util.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 20),
                    Position = UDim2.new(0, 0, 0.5, -10),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    Text = "",
                    ZIndex = 7,
                    Parent = sliderTrack
                })

                util.stroke(sliderBg, Color3.fromRGB(50, 50, 50), 1)
                sliderBg.ClipsDescendants = true

                local sliderFill = util.create("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = lib.accent,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = sliderBg
                })

                local fillGradient = util.create("UIGradient", {
                    Color = util.gradient(lib.outline),
                    Rotation = 0,
                    Parent = sliderFill
                })

                local valueLabel = util.create("TextLabel", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Size = UDim2.new(1, 0, 1, 0),
                    Position = UDim2.new(0.5, 0, 0.5, 0),
                    BackgroundTransparency = 1,
                    Text = string.format("%.2f/%.2f", default, max),
                    TextColor3 = Color3.fromRGB(255, 255, 255),
                    TextSize = 13,
                    Font = Enum.Font.Code,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    ZIndex = 9,
                    Parent = sliderBg
                })

                local function update(input)
                    local perc = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
                    local rawValue = min + (max - min) * perc
                    local value = tonumber(string.format("%.2f", rawValue))
                    util.tween(sliderFill, {0.1}, {Size = UDim2.new(perc, 0, 1, 0)})
                    valueLabel.Text = string.format("%.2f/%.2f", value, max)
                    lib.flags[flag] = value
                    if callback then
                        callback(value)
                    end
                end

                local isDragging = false

                sliderBg.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        isDragging = true
                        update(input)
                    end
                end)

                svcs.UserInputService.InputChanged:Connect(function(input)
                    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        update(input)
                    end
                end)

                svcs.UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        isDragging = false
                    end
                end)
            end

            function section:Button(text, callback)
                local button = util.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    BorderSizePixel = 0,
                    Text = text,
                    TextColor3 = Color3.fromRGB(200, 200, 200),
                    TextSize = 14,
                    Font = Enum.Font.Code,
                    ZIndex = 6,
                    Parent = itemHolder
                })

                util.stroke(button, Color3.fromRGB(50, 50, 50), 1)

                util.create("UICorner", {
                    CornerRadius = UDim.new(0, 6),
                    Parent = button
                })

                button.MouseButton1Click:Connect(function()
                    if callback then
                        callback()
                    end
                end)
            end

            return section
        end

        return tab
    end

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(searchBox.Text)

        if currentTab and currentTab.LeftSide and currentTab.RightSide then
            local sides = {currentTab.LeftSide, currentTab.RightSide}

            for _, side in ipairs(sides) do
                for _, child in ipairs(side:GetChildren()) do
                    if child.Name == "ZalSection" then
                        local title = child:FindFirstChildWhichIsA("TextLabel")
                        if title then
                            child.Visible = (query == "") or string.find(string.lower(title.Text), query, 1, true)
                        end
                    end
                end

                side.CanvasPosition = Vector2.new(0, 0)
            end

            task.delay(0.05, function()
                if currentTab.LeftSide then
                    local leftLayout = currentTab.LeftSide:FindFirstChild("UIListLayout")
                    if leftLayout then
                        currentTab.LeftSide.CanvasSize = UDim2.new(0, 0, 0, leftLayout.AbsoluteContentSize.Y + 20)
                    end
                end
                if currentTab.RightSide then
                    local rightLayout = currentTab.RightSide:FindFirstChild("UIListLayout")
                    if rightLayout then
                        currentTab.RightSide.CanvasSize = UDim2.new(0, 0, 0, rightLayout.AbsoluteContentSize.Y + 20)
                    end
                end
            end)
        end
    end)

    return window
end

return lib
