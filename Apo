                    TextColor3 = Color3.fromRGB(190, 190, 205),
                    TextSize = 13,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = slider
                })

                local bg = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 18),
                    Position = UDim2.new(0, 0, 0, 24),
                    BackgroundColor3 = Color3.fromRGB(28, 28, 36),
                    Text = "",
                    AutoButtonColor = false,
                    Parent = slider
                })
                utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = bg})
                utility.stroke(bg, Color3.fromRGB(50, 50, 65), 1, 0.5)

                local fill = utility.create("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = library.accent,
                    BorderSizePixel = 0,
                    Parent = bg
                })
                utility.create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = fill})
                utility.create("UIGradient", {
                    Color = utility.gradient(library.outline),
                    Parent = fill
                })

                local valLabel = utility.create("TextLabel", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = string.format("%.1f", default),
                    TextColor3 = Color3.fromRGB(255, 255, 255),
                    TextSize = 12,
                    Font = Enum.Font.GothamBold,
                    Parent = bg
                })

                local function setValue(frac)
                    frac = math.clamp(frac, 0, 1)
                    local value = min + (max - min) * frac
                    value = math.floor(value * 10 + 0.5) / 10
                    fill.Size = UDim2.new(frac, 0, 1, 0)
                    valLabel.Text = string.format("%.1f", value)
                    library.flags[flag] = value
                    if callback then callback(value) end
                end

                local dragging = false
                bg.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        local frac = (input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X
                        setValue(frac)
                    end
                end)
                services.UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        local frac = (input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X
                        setValue(frac)
                    end
                end)
                services.UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                setValue((default - min) / (max - min))
            end

