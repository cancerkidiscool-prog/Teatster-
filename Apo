----------------------------------------------------------------------
-- utility
----------------------------------------------------------------------
local utility = {}

function utility.create(class, properties)
    local obj = Instance.new(class)
    for prop, v in next, properties do
        obj[prop] = v
    end
    return obj
end

function utility.gradient(colors)
    local colortbl = {}
    for i, color in next, colors do
        table.insert(colortbl, ColorSequenceKeypoint.new((i - 1) / (#colors - 1), color))
    end
    return ColorSequence.new(colortbl)
end

function utility.tween(obj, info, props)
    local tween = services.TweenService:Create(obj, TweenInfo.new(unpack(info)), props)
    tween:Play()
    return tween
end

-- crisp 1px border (no rounded corners anywhere in this theme)
function utility.stroke(obj, color, thickness, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = color or theme.controlOutline
    stroke.Thickness = thickness or 1
    stroke.Transparency = transparency or 0
    stroke.Parent = obj
    return stroke
end

function utility.label(parent, text, props)
    local base = {
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = theme.text,
        TextSize = 13,
        Font = Enum.Font.Code,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = parent,
    }
    for k, v in next, props or {} do
        base[k] = v
    end
    return utility.create("TextLabel", base)
end

function utility.round(value, decimals)
    local mult = 10 ^ (decimals or 0)
    return math.floor(value * mult + 0.5) / mult
end

function utility.dragify(object, inputFrame)
    local dragging, dragInput, dragStart, startPos
    local targetInput = inputFrame or object
    targetInput.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = object.Position
            local connection
            connection = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    connection:Disconnect()
                end
            end)
        end
    end)
    targetInput.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    services.UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            object.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

-- generic horizontal drag handler used by sliders and the color picker
function utility.draggableBar(track, onUpdate)
    local dragging = false
    local function update(input)
        local perc = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        onUpdate(perc)
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    services.UserInputService.InputChanged:Connect(function(input)
        if
            dragging
            and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)
        then
            update(input)
        end
    end)
    services.UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- inline color picker (small swatch + HSV popup), anchored to the right of a row
function utility.colorpicker(row, flag, default, callback)
    local color = default or library.accent
    local h, s, v = Color3.toHSV(color)

    local swatch = utility.create("TextButton", {
        Name = "ColorSwatch",
        Size = UDim2.new(0, 24, 0, 12),
        Position = UDim2.new(1, -24, 0.5, -6),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "",
        ZIndex = 9,
        Parent = row,
    })
    utility.stroke(swatch, theme.controlOutline, 1)

    local panel = utility.create("Frame", {
        Name = "ColorPanel",
        AnchorPoint = Vector2.new(1, 0),
        Size = UDim2.new(0, 176, 0, 94),
        Position = UDim2.new(1, 0, 1, 5),
        BackgroundColor3 = theme.titlebar,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 40,
        Parent = swatch,
    })
    utility.stroke(panel, theme.outline, 1)

    local preview = utility.create("Frame", {
        Size = UDim2.new(1, -16, 0, 14),
        Position = UDim2.new(0, 8, 0, 8),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        ZIndex = 41,
        Parent = panel,
    })
    utility.stroke(preview, theme.controlOutline, 1)

    local function apply()
        color = Color3.fromHSV(h, s, v)
        preview.BackgroundColor3 = color
        swatch.BackgroundColor3 = color
        library.flags[flag] = color
        if callback then
            callback(color)
        end
    end

    local function channel(name, y, initial, setter)
        local track = utility.create("TextButton", {
            Size = UDim2.new(1, -16, 0, 12),
            Position = UDim2.new(0, 8, 0, y),
            BackgroundColor3 = theme.control,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "",
            ClipsDescendants = true,
            ZIndex = 41,
            Parent = panel,
        })
        utility.stroke(track, theme.controlOutline, 1)

        local fill = utility.create("Frame", {
            Size = UDim2.new(initial, 0, 1, 0),
            BackgroundColor3 = library.accent,
            BorderSizePixel = 0,
            ZIndex = 42,
            Parent = track,
        })
        utility.create("UIGradient", {
            Color = utility.gradient(library.outline),
            Parent = fill,
        })
        utility.label(track, name, {
            Size = UDim2.new(1, -6, 1, 0),
            Position = UDim2.new(0, 4, 0, 0),
            TextSize = 11,
            TextColor3 = theme.text,
            ZIndex = 43,
        })

        utility.draggableBar(track, function(perc)
            fill.Size = UDim2.new(perc, 0, 1, 0)
            setter(perc)
            apply()
        end)
    end

    channel("H", 28, h, function(p)
        h = p
    end)
    channel("S", 46, s, function(p)
        s = p
    end)
    channel("V", 64, v, function(p)
        v = p
    end)

    swatch.MouseButton1Click:Connect(function()
        panel.Visible = not panel.Visible
    end)

    library.flags[flag] = color

    return {
        Swatch = swatch,
        Set = function(_, newColor)
            h, s, v = Color3.toHSV(newColor)
            apply()
        end,
    }
end

