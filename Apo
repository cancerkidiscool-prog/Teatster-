                    TextSize = 12,
                    Font = Enum.Font.GothamSemibold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 8,
                    Parent = headerRow
                })
                local valLabel = utility.create("TextLabel", {
                    Size = UDim2.new(0.3, 0, 1, 0),
                    Position = UDim2.new(0.7, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(default),
                    TextColor3 = library.accent,
                    TextSize = 12,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    ZIndex = 8,
                    Parent = headerRow
                })

                local track = utility.create("Frame", {
                    Size = UDim2.new(1, 0, 0, 6),
                    Position = UDim2.new(0, 0, 0, 26),
                    BackgroundColor3 = library.theme.bg,
                    BorderSizePixel = 0,
                    ZIndex = 7,
                    Parent = frame
                })
                utility.corner(track, 3)
                utility.stroke(track, library.theme.border, 1, 0.5)

                local fill = utility.create("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = library.accent,
                    BorderSizePixel = 0,
                    ZIndex = 8,
                    Parent = track
                })
                utility.corner(fill, 3)

                -- Gradient fill
                utility.create("UIGradient", {
                    Color = utility.gradient(library.outline),
                    Rotation = 0,
                    Parent = fill
                })

                -- Thumb
                local thumb = utility.create("Frame", {
                    Size = UDim2.new(0, 14, 0, 14),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    ZIndex = 9,
                    Parent = track
                })
                utility.corner(thumb, 7)
                utility.stroke(thumb, library.accent, 2, 0)

                -- Invisible drag button
                local dragBtn = utility.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 20),
                    Position = UDim2.new(0, 0, 0.5, -10),
                    BackgroundTransparency = 1,
                    Text = "",
                    ZIndex = 10,
                    Parent = track
                })

                local dragging = false
                local function updateSlider(input)
                    local perc = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    local value = math.floor((min + (max - min) * perc) * 100 + 0.5) / 100
                    utility.tween(fill, {0.05}, {Size = UDim2.new(perc, 0, 1, 0)})
                    utility.tween(thumb, {0.05}, {Position = UDim2.new(perc, 0, 0.5, 0)})
                    valLabel.Text = tostring(value)
                    library.flags[flag] = value
                    updateStatus()
                    if callback then callback(value) end
                end

                dragBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        updateSlider(input)
                    end
                end)
                services.UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        updateSlider(input)
                    end
                end)
                services.UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)
            end

