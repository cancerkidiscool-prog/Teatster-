            BackgroundColor3 = library.accent, BorderSizePixel = 0, BackgroundTransparency = 1, ZIndex = 4, Parent = tabBtn,
        })
        local tabFrame = utility.create("Frame", {
            Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Visible = false, ZIndex = 2, Parent = content,
        })
        local leftCol = utility.create("ScrollingFrame", {
            Size = UDim2.new(0.5,-4,1,0), Position = UDim2.new(0,0,0,0),
            BackgroundTransparency = 1, ScrollBarThickness = 0, ZIndex = 3, Parent = tabFrame,
        })
        local rightCol = utility.create("ScrollingFrame", {
            Size = UDim2.new(0.5,-4,1,0), Position = UDim2.new(0.5,4,0,0),
            BackgroundTransparency = 1, ScrollBarThickness = 0, ZIndex = 3, Parent = tabFrame,
        })
        utility.create("UIPadding", { Parent = leftCol, PaddingLeft = UDim.new(0,2), PaddingRight = UDim.new(0,2), PaddingTop = UDim.new(0,5), PaddingBottom = UDim.new(0,5) })
        utility.create("UIPadding", { Parent = rightCol, PaddingLeft = UDim.new(0,2), PaddingRight = UDim.new(0,2), PaddingTop = UDim.new(0,5), PaddingBottom = UDim.new(0,5) })
        local leftList = utility.create("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical, HorizontalAlignment = Enum.HorizontalAlignment.Left,
            SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0,10), Parent = leftCol,
        })
        local rightList = utility.create("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical, HorizontalAlignment = Enum.HorizontalAlignment.Left,
            SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0,10), Parent = rightCol,
        })
        local function updateCanvases()
            leftCol.CanvasSize = UDim2.new(0,0,0, leftList.AbsoluteContentSize.Y + 20)
            rightCol.CanvasSize = UDim2.new(0,0,0, rightList.AbsoluteContentSize.Y + 20)
        end
        leftList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvases)
        rightList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvases)

        local function select()
            if currentTab then
                currentTab.Frame.Visible = false
                utility.tween(currentTab.Btn, {0.2}, {TextColor3 = Color3.fromRGB(120,120,120)})
                utility.tween(currentTab.Line, {0.2}, {BackgroundTransparency = 1})
            end
            tabFrame.Visible = true
            leftCol.CanvasPosition = Vector2.new(0,0); rightCol.CanvasPosition = Vector2.new(0,0)
            updateCanvases()
            utility.tween(tabBtn, {0.2}, {TextColor3 = library.accent})
            utility.tween(underline, {0.2}, {BackgroundTransparency = 0})
            currentTab = { Frame = tabFrame, Btn = tabBtn, Line = underline, LeftCol = leftCol, RightCol = rightCol }
        end
        tabBtn.MouseButton1Click:Connect(select)
        if not currentTab then select() end

        local tabActions = {}
        local sectionIndex = 0
        function tabActions:Section(name)
            local targetCol = sectionIndex % 2 == 0 and leftCol or rightCol
            sectionIndex = sectionIndex + 1
            local sectionFrame = utility.create("Frame", {
                Name = "ZalSection", BackgroundColor3 = Color3.fromRGB(18,18,18),
                BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.Y,
                Size = UDim2.new(1,0,0,0), ZIndex = 4, Parent = targetCol,
            })
            utility.stroke(sectionFrame, Color3.fromRGB(40,40,40), 1)
            utility.create("UICorner", { CornerRadius = UDim.new(0,10), Parent = sectionFrame })

            local headerBtn = utility.create("TextButton", {
                Size = UDim2.new(1,0,0,36), BackgroundTransparency = 1, Text = "", ZIndex = 5, Parent = sectionFrame,
            })
            local headerText = utility.create("TextLabel", {
                Size = UDim2.new(1,-30,1,0), Position = UDim2.new(0,12,0,0),
                BackgroundTransparency = 1, Text = name:upper(), TextColor3 = library.accent,
                TextSize = 14, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6, Parent = headerBtn,
            })
            local arrow = utility.create("TextLabel", {
                Size = UDim2.new(0,20,1,0), Position = UDim2.new(1,-25,0,0),
                BackgroundTransparency = 1, Text = "▼", TextColor3 = library.accent,
                TextSize = 14, Font = Enum.Font.Gotham, ZIndex = 6, Parent = headerBtn,
            })
            local itemsFrame = utility.create("Frame", {
                Name = "Items", Size = UDim2.new(1,0,0,0), Position = UDim2.new(0,0,0,36),
