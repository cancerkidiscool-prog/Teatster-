    ByteNetReliable.FireServer = function(self, ...)
        local args = {...}
        if args[1] and typeof(args[1]) == "buffer" then
            if LearningMode.active and not LearningMode.captured then
                learningPacketBuffer = args[1]
                LearningMode.captured = true
            end
        end
        return oldFireServer(self, ...)
    end
end

-- Analyse a captured packet to extract its structure
local function analyzePacket(packetBuffer, expectedType)
    local str = buffer.tostring(packetBuffer)
    local len = #str
    local template = {bytes = {}}
    for i = 1, len do
        template.bytes[i] = string.byte(str, i)
    end
    return template
end

-- Apply learned template
local function applyLearnedTemplate(template, actionType)
    if actionType == "harvest" then
        LearnedTemplates.harvest = {
            build = function(entityId)
                local bytes = {}
                for i, b in ipairs(template.bytes) do bytes[i] = b end
                bytes[3] = entityId % 256
                bytes[4] = math.floor(entityId / 256) % 256
                bytes[5] = math.floor(entityId / 65536) % 256
                return string.char(unpack(bytes))
            end
        }
    elseif actionType == "plant" then
        LearnedTemplates.plant = {
            build = function(entityId, itemId)
                local bytes = {}
                for i, b in ipairs(template.bytes) do bytes[i] = b end
                bytes[3] = entityId % 256
                bytes[4] = math.floor(entityId / 256) % 256
                bytes[5] = math.floor(entityId / 65536) % 256
                bytes[7] = itemId % 256
                bytes[8] = math.floor(itemId / 256) % 256
                return string.char(unpack(bytes))
            end
        }
    elseif actionType == "drop" then
        LearnedTemplates.drop = {
            build = function(slotId)
                local bytes = {}
                for i, b in ipairs(template.bytes) do bytes[i] = b end
                bytes[3] = slotId % 256
                return string.char(unpack(bytes))
            end
        }
    elseif actionType == "heal" then
        LearnedTemplates.heal = {
            build = function(entityId)
                local bytes = {}
                for i, b in ipairs(template.bytes) do bytes[i] = b end
                bytes[3] = entityId % 256
                bytes[4] = math.floor(entityId / 256) % 256
                bytes[5] = math.floor(entityId / 65536) % 256
                return string.char(unpack(bytes))
            end
        }
    end
end

-- Start learning mode for a specific action type
function StartLearning(actionType)
    if LearningMode.active then
        Notify({Title = "Learning", Content = "Already learning! Finish or cancel first.", Duration = 3})
        return
    end
    LearningMode.active = true
    LearningMode.type = actionType
    LearningMode.captured = false
    learningPacketBuffer = nil
    Notify({Title = "Learning "..actionType, Content = "Perform the action now (e.g. click a bush).", Duration = 5})
end

-- Confirm and apply learned template
function ConfirmLearn()
    if not LearningMode.active or not LearningMode.captured then
        Notify({Title = "Learning", Content = "No packet captured yet.", Duration = 3})
        return
    end
    local template = analyzePacket(learningPacketBuffer, LearningMode.type)
    applyLearnedTemplate(template, LearningMode.type)
    LearningMode.active = false
    LearningMode.captured = false
    Notify({Title = "Learning", Content = LearningMode.type .. " template updated!", Duration = 4})
end

-- Cancel learning
function CancelLearn()
    LearningMode.active = false
    LearningMode.captured = false
    learningPacketBuffer = nil
    Notify({Title = "Learning", Content = "Cancelled.", Duration = 2})
end

-- ==================== PACKET ENCODING FUNCTIONS ====================
-- These use learned templates if available, otherwise defaults
local function EncodeInteract(entityId) -- used for harvest and pickup
    if LearnedTemplates.harvest then
        return LearnedTemplates.harvest.build(entityId)
    else
        return DefaultTemplates.harvest.build(entityId)
    end
end

local function EncodePlant(entityId, itemId)
    if LearnedTemplates.plant then
        return LearnedTemplates.plant.build(entityId, itemId)
    else
        return DefaultTemplates.plant.build(entityId, itemId)
    end
end

local function EncodeDrop(slotId)
    if LearnedTemplates.drop then
        return LearnedTemplates.drop.build(slotId)
    else
        return DefaultTemplates.drop.build(slotId)
    end
end

local function EncodeOVHeal(entityId)
    if LearnedTemplates.heal then
        return LearnedTemplates.heal.build(entityId)
    else
        return DefaultTemplates.heal.build(entityId)
    end
end

local function EncodeCollect(entityId) -- cauldron collect (unchanged, not learned)
    return DefaultTemplates.collect.build(entityId)
end

local function EncodeSwing(entityIds)
    if #entityIds == 0 then return "" end
    local packet = {string.char(0x00, 0x13)}
    packet[#packet + 1] = string.char(#entityIds)
    packet[#packet + 1] = string.char(0x00)
    for _, id in ipairs(entityIds) do
        local b1 = id % 256
        local b2 = math.floor(id / 256) % 256
        local b3 = math.floor(id / 65536) % 256
        packet[#packet + 1] = string.char(b1, b2, b3, 0x00)
    end
    return table.concat(packet)
end

-- Other encoders (FirstDig, SecondDig, PlacePlantBox) remain unchanged
local function EncodeFirstDig(pos)
    return string.char(0x00, 0x90)
        .. string.pack("<f", pos.X)
        .. string.pack("<f", pos.Y)
        .. string.pack("<f", pos.Z)
        .. string.char(0x00)
end
local function EncodeSecondDig(pos, entityID)
    return string.char(0x00, 0x90)
        .. string.pack("<f", pos.X)
        .. string.pack("<f", pos.Y)
        .. string.pack("<f", pos.Z)
        .. string.char(0x01)
        .. string.pack("<I4", entityID)
        .. string.char(0x00, 0x00)
end
local function EncodePlacePlantBox(cframe)
    local pos = cframe.Position
    local header = string.char(0x00, 0xE0, 0x09, 0x00) .. "Plant Box"
    local xBytes = string.pack("<f", pos.X)
    local yBytes = string.pack("<f", pos.Y)
    local zBytes = string.pack("<f", pos.Z)
    local constant2 = string.char(0x48, 0xC2, 0x2C, 0xBE, 0x48, 0xC2)
    return header .. xBytes .. yBytes .. zBytes .. constant2
end

local function FirePacket(packetData)
    if buffer then
        ByteNetReliable:FireServer(buffer.fromstring(packetData))
    else
        warn("ZalHub: Buffer library missing. Packets will not send.")
    end
end

-- ==================== WAYPOINT SERIALIZATION HELPERS ====================
local function serializeWaypoints(waypoints)
    local serialized = {}
    for _, pos in ipairs(waypoints) do
        table.insert(serialized, {X = pos.X, Y = pos.Y, Z = pos.Z})
    end
    return serialized
end
local function deserializeWaypoints(serialized)
    local waypoints = {}
    for _, data in ipairs(serialized or {}) do
        table.insert(waypoints, Vector3.new(data.X or 0, data.Y or 0, data.Z or 0))
    end
    return waypoints
end

