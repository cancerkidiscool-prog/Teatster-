            ------------------------------------------------------------------
            -- Toggle (checkbox style with gradient check)
            ------------------------------------------------------------------
            function sectionActions:Toggle(text, flag, defaultOrCallback, callback)
                local default, cb = false, nil
                if typeof(defaultOrCallback) == "boolean" then
                    default = defaultOrCallback
                    cb = callback
                elseif typeof(defaultOrCallback) == "function" then
                    cb = defaultOrCallback
                else
