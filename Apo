            -- ========== SLIDER (Original Style) ==========
            function sectionActions:Slider(text, flag, min, max, default, callback)
                local slider = utility.create("Frame", {
                    Size = UDim2.new(1,0,0,45), BackgroundTransparency = 1, ZIndex = 6, Parent = itemsFrame,
                })
                utility.create("TextLabel", {
                    Size = UDim2.new(1,0,0,20), BackgroundTransparency = 1, Text = text,
                    TextColor3 = Color3.fromRGB(180,180,180), TextSize = 13,
                    Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7, Parent = slider,
