-- Services
local services = setmetatable({}, {__index = function(_, s) return game:GetService(s) end})
local utility = {}

function utility.create(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        obj[k] = v
    end
    return obj
end

function utility.gradient(colors)
    local tbl = {}
    for i, color in ipairs(colors) do
        table.insert(tbl, ColorSequenceKeypoint.new((i-1)/(#colors-1), color))
    end
    return ColorSequence.new(tbl)
end

function utility.tween(obj, info, props)
    local tween = services.TweenService:Create(obj, TweenInfo.new(unpack(info)), props)
    tween:Play()
    return tween
end

function utility.stroke(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or library.theme.strokeColor
    s.Thickness = thickness or 1
    s.Transparency = 0.5
    s.Parent = obj
    return s
end

function utility.shadow(obj, size, transparency)
    local shadow = Instance.new("ImageLabel")
    shadow.Name = "Shadow"
    shadow.AnchorPoint = Vector2.new(0.5, 0.5)
    shadow.Size = UDim2.new(1, size or 20, 1, size or 20)
    shadow.Position = UDim2.new(0.5, 0, 0.5, 0)
    shadow.BackgroundTransparency = 1
    shadow.Image = "rbxassetid://6014261993" -- default shadow image
    shadow.ImageColor3 = Color3.new(0,0,0)
    shadow.ImageTransparency = transparency or 0.85
    shadow.ScaleType = Enum.ScaleType.Slice
    shadow.SliceCenter = Rect.new(64, 64, 128, 128)
    shadow.ZIndex = 0
    shadow.Parent = obj
    return shadow
end

function utility.dragify(object, inputFrame)
    local dragging, dragInput, dragStart, startPos
    local target = inputFrame or object
    target.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = object.Position
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    conn:Disconnect()
                end
            end)
        end
    end)
    target.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    services.UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            object.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

function utility.makeResizable(windowFrame, minSize, maxSize)
    -- adds a resize grip in bottom-right corner
    local grip = utility.create("TextButton", {
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(1, -20, 1, -20),
        BackgroundTransparency = 1,
        Text = "⤡",
        TextColor3 = library.theme.text,
        TextSize = 18,
        Font = Enum.Font.Code,
        ZIndex = 10,
        Parent = windowFrame,
    })
    local resizing = false
    grip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = true
            local startPos = input.Position
            local startSize = windowFrame.Size
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    resizing = false
                    conn:Disconnect()
                end
            end)
            services.UserInputService.InputChanged:Connect(function(inp)
                if resizing and inp.UserInputType == Enum.UserInputType.MouseMovement then
                    local delta = inp.Position - startPos
                    local newWidth = math.clamp(startSize.X.Offset + delta.X, minSize.X.Offset, maxSize.X.Offset)
                    local newHeight = math.clamp(startSize.Y.Offset + delta.Y, minSize.Y.Offset, maxSize.Y.Offset)
                    windowFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
                end
            end)
        end
    end)
end

