function library:Notify(options)
    if not notifyHolder then return end
    options = options or {}
    local frame = utility.create("Frame", {
        Size = UDim2.new(0, 300, 0, 0),
        Position = UDim2.new(1, 330, 1, 0),
        AnchorPoint = Vector2.new(1, 1),
        BackgroundColor3 = theme.window,
        BorderSizePixel = 0,
        Parent = notifyHolder,
        AutomaticSize = Enum.AutomaticSize.Y,
    })
    utility.stroke(frame, theme.outline)

    utility.create("Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = library.accent,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = frame,
    })

    local content = utility.create("Frame", {
        Size = UDim2.new(1, -14, 0, 0),
        Position = UDim2.new(0, 11, 0, 0),
        BackgroundTransparency = 1,
        Parent = frame,
        AutomaticSize = Enum.AutomaticSize.Y,
    })
    utility.create("UIListLayout", {
        Parent = content,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })
    utility.create("UIPadding", {
        Parent = content,
        PaddingTop = UDim.new(0, 6),
        PaddingBottom = UDim.new(0, 6),
    })

    utility.label(content, options.Title or "Notification", {
        Size = UDim2.new(1, 0, 0, 18),
        TextColor3 = theme.text,
        TextSize = 14,
        ZIndex = 2,
    })
    utility.label(content, options.Content or "Message", {
        Size = UDim2.new(1, 0, 0, 0),
        TextColor3 = theme.dimText,
        TextSize = 13,
        TextWrapped = true,
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 2,
    })

    local duration = options.Duration or 5
    utility.tween(frame, { 0.25, Enum.EasingStyle.Quad }, { Position = UDim2.new(1, -10, 1, -10) })
    task.spawn(function()
        task.wait(duration)
        utility.tween(frame, { 0.25, Enum.EasingStyle.Quad }, { Position = UDim2.new(1, 330, 1, 0) })
        task.wait(0.35)
        frame:Destroy()
    end)
end

----------------------------------------------------------------------
-- Auto‑save
----------------------------------------------------------------------
local autoSaveDebounce = false
function library:ScheduleAutoSave()
    if not library.autoSaveEnabled or not library.autoSaveConfigName then return end
    if autoSaveDebounce then return end
    autoSaveDebounce = true
    task.delay(0.5, function()
        autoSaveDebounce = false
        if library.autoSaveEnabled and library.autoSaveConfigName then
            library:SaveConfig(library.autoSaveConfigName)
        end
    end)
end

function library:FlagChanged(flag)
    if not library._loading then library:ScheduleAutoSave() end
end

