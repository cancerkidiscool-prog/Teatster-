    -- ════════════════════════════════════════════════════════════
    -- TAB SYSTEM
    -- ════════════════════════════════════════════════════════════
    local currentTab = nil
    local Window = {}

    function Window:Tab(tabName)
        local tabBtn = U.new("TextButton", {
            Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = ZalHub.theme.panelBg, BackgroundTransparency = 1,
            BorderSizePixel = 0, Text = "", ZIndex = 10, Parent = tabContainer
