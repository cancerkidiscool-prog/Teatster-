local function stopWaypointTween()
    if waypointData.tween then
        waypointData.tween:Cancel()
        waypointData.tween = nil
    end
    waypointData.tweening = false
    waypointData.currentIndex = 0
end

local function startWaypointTween()
    if #waypointData.waypoints == 0 then
        Notify({Title = "Waypoints", Content = "No waypoints added.", Duration = 3})
        return
    end
    stopWaypointTween()
    local char = plr.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    waypointData.tweening = true
    waypointData.currentIndex = 1
    local function moveToNext()
        if not waypointData.tweening then return end
        if waypointData.currentIndex > #waypointData.waypoints then
            if waypointData.loop then
                waypointData.currentIndex = 1
            else
                stopWaypointTween()
                Notify({Title = "Waypoints", Content = "Tween finished.", Duration = 2})
                return
            end
        end
        local targetPos = waypointData.waypoints[waypointData.currentIndex]
        local distance = (root.Position - targetPos).Magnitude
        local duration = distance / waypointData.speed
        if duration < 0.05 then duration = 0.05 end
        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
        waypointData.tween = TweenService:Create(root, tweenInfo, {CFrame = CFrame.new(targetPos)})
        waypointData.tween.Completed:Connect(function()
            waypointData.currentIndex = waypointData.currentIndex + 1
            moveToNext()
        end)
        waypointData.tween:Play()
    end
    moveToNext()
end

local function saveWaypointsToFile(name, dataTable)
    if not name or name == "" then return false end
    local success, err = pcall(function()
        if not isfolder(waypointData.saveFolder) then
            makefolder(waypointData.saveFolder)
        end
        local json = HttpService:JSONEncode(dataTable)
        writefile(waypointData.saveFolder .. "/" .. name .. ".json", json)
    end)
    if success then
        Notify({Title = "Saved", Content = "Config '" .. name .. "' saved.", Duration = 2})
        return true
    else
        Notify({Title = "Save Failed", Content = err, Duration = 4})
        return false
    end
end

