-- ==================== SILENT AIM TARGETING (CHEST) ====================
function isGodPlayer(character)
    for _, item in pairs(character:GetChildren()) do
        if (item:IsA("Accessory") or item:IsA("Pants") or item:IsA("Shirt") 
            or item.Name:find("Chestplate") or item.Name:find("Helmet") 
            or item.Name:find("Greaves") or item.Name:find("Legs") 
            or item.Name:find("Boots")) then
            if item.Name:find("God") then
                return true
            end
        end
    end
    return false
end

function IsTargetInFOV(worldPos)
    local camera = workspace.CurrentCamera
    if not camera then return false end
    local screenPoint, onScreen = camera:WorldToScreenPoint(worldPos)
    if not onScreen then return false end
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - center).Magnitude
    return dist <= getgenv().silentAimFOVRadius
end

local function getArrowSpeed(dist)
    if dist <= 494 then
        return 430.16
    elseif dist <= 532 then
        local t = (dist - 494) / (532 - 494)
        return 430.16 + (424.46 - 430.16) * t
    elseif dist <= 595 then
        local t = (dist - 532) / (595 - 532)
        return 424.46 + (424.00 - 424.46) * t
    elseif dist <= 990 then
        local t = (dist - 595) / (990 - 595)
        return 424.00 + (329.71 - 424.00) * t
    else
        return 329.71
    end
end

local gravity = workspace.Gravity or 196.2

local function getAimPos(from, targetPos, targetVel)
    local guess = targetPos
    local arrowSpeed = 430.16
    local lead = getgenv().silentAimLeadMult or 1.0
    for i = 1, 4 do
        local dist = (guess - from).Magnitude
        arrowSpeed = getArrowSpeed(dist)
        local timeToHit = dist / arrowSpeed
        local predicted = targetPos + (targetVel * timeToHit * lead)
        local newDist = (predicted - from).Magnitude
        local newTime = newDist / arrowSpeed
        local flatDist = Vector3.new(predicted.X - from.X, 0, predicted.Z - from.Z).Magnitude
        local dropTime = flatDist / arrowSpeed
        local drop = 0.5 * gravity * (dropTime * dropTime)
        guess = predicted + Vector3.new(0, drop, 0)
    end
    return guess
end

local function findSilentAimTarget()
    local myChar = plr.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myRoot = myChar.HumanoidRootPart
    local camera = workspace.CurrentCamera
    if not camera then return nil end
    local best, bestDistOnScreen = nil, math.huge
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= plr then
            local targetChar = targetPlayer.Character
            if targetChar and targetChar:FindFirstChild("Humanoid") and targetChar.Humanoid.Health > 0 then
                if not isGodPlayer(targetChar) then continue end
                -- Aim at UpperTorso (chest), fallback to HumanoidRootPart
                local aimPart = targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("HumanoidRootPart")
                if not aimPart then continue end
                local distance = (aimPart.Position - myRoot.Position).Magnitude
                if distance > (getgenv().silentAimMaxDist or 1000) then continue end
                if IsTargetInFOV(aimPart.Position) then
                    local screenPoint = camera:WorldToScreenPoint(aimPart.Position)
                    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
                    local screenDist = (Vector2.new(screenPoint.X, screenPoint.Y) - center).Magnitude
                    if screenDist < bestDistOnScreen then
                        bestDistOnScreen = screenDist
                        best = aimPart
                    end
                end
            end
        end
    end
    return best
end

-- ==================== WALLBANG PATCH (PROJECTILES IGNORE NON-PLAYERS) ====================
getgenv().wallbangEnabled = false

local function updateWallbangFilter()
    if not getgenv().wallbangEnabled then return end
    -- Cache all non-player parts once per tick to avoid massive performance hit
    local ignoreList = {}
    local function addParts(parent)
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("BasePart") and obj.CanCollide then
                -- Ignore parts that belong to a player character
                local char = Players:GetPlayerFromCharacter(obj.Parent)
                if not char then
                    table.insert(ignoreList, obj)
                end
            end
            if obj ~= workspace.Terrain then  -- terrain handled separately
                addParts(obj)
            end
        end
    end
    addParts(workspace)
    return ignoreList
end

local wallbangIgnoreList = {}
local lastWallbangUpdate = 0

local oldFilterToArray
oldFilterToArray = hookfunction(require(rs.Modules.GameUtil).filterToArray, function(...)
    local args = {...}
    if debug.traceback():find("projectile") and getgenv().wallbangEnabled then
        local now = tick()
        if now - lastWallbangUpdate > 2 then
            wallbangIgnoreList = updateWallbangFilter()
            lastWallbangUpdate = now
        end
        for _, part in ipairs(wallbangIgnoreList) do
            table.insert(args[1], part)
        end
        table.insert(args[1], workspace.Terrain)
        table.insert(args[1], workspace.Deployables)  -- chests etc.
    end
    return oldFilterToArray(table.unpack(args))
end)

