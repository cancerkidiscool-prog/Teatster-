                        Size = UDim2.new(1,-30,1,0), Position = UDim2.new(0,8,0,0),
                        BackgroundTransparency = 1, Text = item, TextColor3 = Color3.fromRGB(200,200,200),
                        TextSize = 13, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = radioBtn,
                    })
                    local dot = utility.create("Frame", {
                        Size = UDim2.new(0,14,0,14), Position = UDim2.new(1,-22,0.5,-7),
                        BackgroundColor3 = (item == selected) and library.accent or Color3.fromRGB(40,40,40),
                        BorderSizePixel = 0, ZIndex = 8, Parent = radioBtn,
                    })
                    utility.create("UICorner", { CornerRadius = UDim.new(0,7), Parent = dot })
                    radioBtn.MouseButton1Click:Connect(function()
                        selected = item
                        library.flags[flag] = selected
                        for _, b in ipairs(buttons) do
                            b.dot.BackgroundColor3 = (b.item == selected) and library.accent or Color3.fromRGB(40,40,40)
                        end
                        if callback then callback(selected) end
                    end)
                    table.insert(buttons, {item = item, dot = dot})
                end
            end

            -- ========== TOGGLE LIST (multiple toggles inline) ==========
            function sectionActions:ToggleList(listData) -- listData: {{text, flag, default, callback}, ...}
                local height = #listData * 30
                local frame = utility.create("Frame", {
                    Size = UDim2.new(1,0,0, height), BackgroundTransparency = 1, ZIndex = 6, Parent = itemsFrame,
                })
                for i, data in ipairs(listData) do
                    local text, flag, default, cb = data[1], data[2], data[3] or false, data[4]
                    local enabled = default
                    local toggleRow = utility.create("TextButton", {
                        Size = UDim2.new(1,0,0,28), Position = UDim2.new(0,0,0,(i-1)*30),
                        BackgroundTransparency = 1, Text = "", ZIndex = 7, Parent = frame,
                    })
                    utility.create("TextLabel", {
                        AnchorPoint = Vector2.new(0,0.5), Size = UDim2.new(1,-80,0,20),
                        Position = UDim2.new(0,12,0.5,0), BackgroundTransparency = 1, Text = text,
                        TextColor3 = Color3.fromRGB(200,200,200), TextSize = 13,
                        Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = toggleRow,
                    })
                    local track = utility.create("Frame", {
                        Size = UDim2.new(0,42,0,22), Position = UDim2.new(1,-50,0.5,-11),
                        BackgroundColor3 = enabled and library.accent or Color3.fromRGB(40,40,40), ZIndex = 8, Parent = toggleRow,
                    })
                    utility.create("UICorner", { CornerRadius = UDim.new(0,11), Parent = track })
                    utility.stroke(track, Color3.fromRGB(60,60,60), 1)
                    local knob = utility.create("Frame", {
                        Size = UDim2.new(0,18,0,18),
                        Position = enabled and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9),
                        BackgroundColor3 = Color3.new(1,1,1), ZIndex = 9, Parent = track,
                    })
                    utility.create("UICorner", { CornerRadius = UDim.new(0,9), Parent = knob })
                    toggleRow.MouseButton1Click:Connect(function()
                        enabled = not enabled
                        utility.tween(knob, {0.25}, {Position = enabled and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9)})
                        utility.tween(track, {0.25}, {BackgroundColor3 = enabled and library.accent or Color3.fromRGB(40,40,40)})
                        library.flags[flag] = enabled
                        if cb then cb(enabled) end
                    end)
                end
            end

            -- ========== PARAGRAPH ==========
            function sectionActions:Paragraph(text)
                utility.create("TextLabel", {
                    Size = UDim2.new(1,0,0,0), BackgroundTransparency = 1, Text = text,
                    TextColor3 = Color3.fromRGB(150,150,150), TextSize = 13,
                    Font = Enum.Font.Gotham, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
                    AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 6, Parent = itemsFrame,
                })
            end

            -- ========== LABEL ==========
            function sectionActions:Label(text)
                utility.create("TextLabel", {
                    Size = UDim2.new(1,0,0,24), BackgroundTransparency = 1, Text = text,
                    TextColor3 = Color3.fromRGB(150,150,150), TextSize = 13,
                    Font = Enum.Font.Gotham, TextWrapped = true, ZIndex = 6, Parent = itemsFrame,
                })
            end

            return sectionActions
        end
        return tabActions
    end

    -- Global search
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(searchBox.Text)
        if currentTab and currentTab.Frame then
            for _, col in ipairs({currentTab.LeftCol, currentTab.RightCol}) do
                for _, section in ipairs(col:GetChildren()) do
                    if section.Name == "ZalSection" then
                        local items = section:FindFirstChild("Items")
                        if items then
                            local anyVisible = false
                            for _, child in ipairs(items:GetChildren()) do
                                if child:IsA("GuiObject") then
                                    local txt = child:FindFirstChildWhichIsA("TextLabel") or child:FindFirstChildWhichIsA("TextButton")
                                    local match = (query == "") or (txt and string.find(string.lower(txt.Text), query, 1, true))
                                    child.Visible = match
                                    if match then anyVisible = true end
                                end
                            end
                            section.Visible = (query == "") or anyVisible
                        end
                    end
                end
                col.CanvasPosition = Vector2.new(0,0)
            end
            task.wait(0.05)
            if currentTab.LeftCol then
                local ll = currentTab.LeftCol:FindFirstChild("UIListLayout")
                if ll then currentTab.LeftCol.CanvasSize = UDim2.new(0,0,0, ll.AbsoluteContentSize.Y+20) end
            end
            if currentTab.RightCol then
                local rl = currentTab.RightCol:FindFirstChild("UIListLayout")
                if rl then currentTab.RightCol.CanvasSize = UDim2.new(0,0,0, rl.AbsoluteContentSize.Y+20) end
            end
        end
    end)

    return windowActions
end

return library
