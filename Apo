                                    local match = (query == "") or (textObj and string.find(string.lower(textObj.Text), query, 1, true))
                                    child.Visible = match
                                    if match then anyVisible = true end
                                    -- Highlight (underline or color change) can be added but omitted for brevity
                                end
                            end
                            section.Visible = (query == "") or anyVisible
                        end
                    end
                end
                col.CanvasPosition = Vector2.new(0,0)
            end
            task.wait(0.05)
            updateCanvas()
        end
    end)

    return windowActions
end

return library
