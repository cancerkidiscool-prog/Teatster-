        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = notifGui
    })
    addCorner(frame, 8)
    addStroke(frame, self.accent, 1, 0.4)
    
    local content = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = frame
    })
    create("UIListLayout", {Parent = content, Padding = UDim.new(0, 4)})
    create("UIPadding", {
        Parent = content,
        PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12)
    })
    
    create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = self.accent,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = content
    })
    create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Text = msg,
        TextColor3 = Color3.fromRGB(190, 190, 200),
        TextSize = 12,
        Font = Enum.Font.Code,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = content
    })
    
    -- slide in
    tween(frame, 0.35, {Position = UDim2.new(1, -10, 1, -10)}, Enum.EasingStyle.Back)
    
    task.delay(dur, function()
        tween(frame, 0.3, {Position = UDim2.new(1, 300, 1, 0)})
        task.wait(0.35)
        frame:Destroy()
    end)
end

