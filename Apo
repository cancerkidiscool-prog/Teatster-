function Library:CreateWatermark(text)
    local wmGui = Utility.new("ScreenGui", {
        Name = "ZalHub_Watermark",
        Parent = CoreGui,
        ResetOnSpawn = false,
        DisplayOrder = 998
    })

    local wmFrame = Utility.new("Frame", {
        Size = UDim2.new(0, 0, 0, 26),
        Position = UDim2.new(1, -10, 0, 10),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundColor3 = Library.theme.sidebar,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.X,
        Parent = wmGui
    })
    Utility.corner(wmFrame, 5)
    Utility.stroke(wmFrame, Library.theme.border, 1, 0.3)
    Utility.padding(wmFrame, 0, 0, 10, 10)

    local wmLabel = Utility.new("TextLabel", {
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        Text = text or "ZalHub",
        TextColor3 = Library.theme.textDim,
        TextSize = 11,
        Font = Library.fontMono,
        Parent = wmFrame
    })

    -- FPS/Ping updater
    local fps = 60
    local lastTick = tick()
    RunService.RenderStepped:Connect(function()
        fps = math.floor(1 / (tick() - lastTick))
        lastTick = tick()
    end)

    task.spawn(function()
        while not Library.unloaded do
            local ping = math.floor(Players.LocalPlayer:GetNetworkPing() * 1000)
            wmLabel.Text = string.format("%s  |  %d fps  |  %dms", text or "ZalHub", fps, ping)
            task.wait(0.5)
        end
    end)

    Utility.dragify(wmFrame)
    return wmFrame
end

