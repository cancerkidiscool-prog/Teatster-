local function getCauldronBase(cauldron)
    if cauldron then
        local base = cauldron:FindFirstChild("Base")
        if base and base:IsA("BasePart") then return base end
    end
    return cauldron and cauldron.PrimaryPart
end
local function getItemPosition(item)
    if item:IsA("BasePart") then return item.Position end
    if item:IsA("Model") then return item.PrimaryPart and item.PrimaryPart.Position or item:GetPivot().Position end
    return nil
end
local function countItemsInCauldron(cauldron, itemName)
    local count = 0
    local basePart = getCauldronBase(cauldron)
    if not basePart then return 0 end
    local itemsFolder = workspace:FindFirstChild("Items")
    if itemsFolder then
        for _, item in pairs(itemsFolder:GetChildren()) do
            if item.Name == itemName then
                local pos = getItemPosition(item)
                if pos and (pos - basePart.Position).Magnitude <= 3 then count = count + 1 end
            end
        end
    end
    return count
end
local function getInventorySlot(itemName)
    local PlayerData = require(rs.Modules.GameUtil).Data
    for i, v in pairs(PlayerData) do
        if typeof(v) == "table" and i == "inventory" then
            for slot, item in pairs(v) do
                if item.name == itemName then return slot end
            end
        end
    end
    return nil
end
local function dropItemToCauldron(itemName, cauldron)
    local slot = getInventorySlot(itemName)
    if not slot or not cauldron then return false end
    local basePart = getCauldronBase(cauldron)
    if not basePart then return false end
    FirePacket(EncodeDrop(slot))
    task.wait(getgenv().potionDropDelay)
    local itemsFolder = workspace:FindFirstChild("Items")
    if itemsFolder then
        local droppedItem, closestDist = nil, 30
        for _, item in pairs(itemsFolder:GetChildren()) do
            if item.Name == itemName then
                local pos = getItemPosition(item)
                if pos and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (pos - plr.Character.HumanoidRootPart.Position).Magnitude
                    if dist < closestDist then closestDist = dist droppedItem = item end
                end
            end
        end
        if droppedItem then
            local targetCFrame = basePart.CFrame + Vector3.new(0,4,0)
            if droppedItem:IsA("BasePart") then droppedItem.CFrame = targetCFrame elseif droppedItem:IsA("Model") then droppedItem:PivotTo(targetCFrame) end
            return true
        end
    end
    return false
end

local function autoPotionManager()
    getgenv().potionManagerRunning = true
    while true do
        task.wait(getgenv().potionManagerLoopDelay)
        if not (getgenv().autoIceEnabled or getgenv().autoBrewEnabled) then continue end
        if not plr or not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then continue end
        local myPos = plr.Character.HumanoidRootPart.Position
        local range = getgenv().autoPotionRange or 30
        for _, cauldron in pairs(workspace.Deployables:GetChildren()) do
            if cauldron.Name ~= "Cauldron" or not cauldron.PrimaryPart then continue end
            if (myPos - cauldron.PrimaryPart.Position).Magnitude > range then continue end
            local state = getgenv().cauldronState[cauldron]
            if not state then
                state = {iceCount = 0, hasIce = false, brewing = false, stage = "empty", iceDropTime = 0}
                getgenv().cauldronState[cauldron] = state
            end
            local potionAttr = cauldron:GetAttribute("Potion") or ""
            if potionAttr ~= "" and potionAttr ~= "Placebo" then
                if getgenv().autoCollectEnabled then
                    local eid = cauldron:GetAttribute("EntityID")
                    if eid then FirePacket(EncodeCollect(eid)) getgenv().cauldronState[cauldron] = nil Notify({Title = "Collected", Content = potionAttr .. " potion", Duration = 2}) end
                end
                continue
            end
            if getgenv().autoBrewEnabled then
                if (potionAttr == "" or potionAttr == "Placebo") and state.stage == "empty" then
                    local iceCount = countItemsInCauldron(cauldron, "Ice Cube")
                    if iceCount == 0 then iceCount = countItemsInCauldron(cauldron, "Ice") end
                    state.iceCount = iceCount
                    if iceCount < 3 then
                        local slot = getInventorySlot("Ice Cube") or getInventorySlot("Ice")
                        if slot then
                            local name = getInventorySlot("Ice Cube") and "Ice Cube" or "Ice"
                            for i = 1, 3 - iceCount do dropItemToCauldron(name, cauldron) task.wait(getgenv().iceDropDelay) end
                            state.hasIce = true state.stage = "ice_dropped" state.iceDropTime = tick()
                            Notify({Title = "Ice", Content = "3 Ice dropped → Waiting 7s melt...", Duration = 4})
                        else
                            Notify({Title = "Error", Content = "Out of Ice!", Duration = 3})
                            getgenv().autoIceEnabled = false
                        end
                    end
                end
                if (potionAttr == "Placebo" or state.stage == "ice_dropped") and (tick() - state.iceDropTime >= 7) then
                    state.brewing = true state.stage = "brewing"
                    local recipe = potionRecipes[getgenv().selectedPotion]
                    if recipe then
                        local success = true
                        for _, ing in pairs(recipe) do
                            local ingName = ing[1] local req = ing[2]
                            local current = countItemsInCauldron(cauldron, ingName)
                            if current < req then
                                local slot = getInventorySlot(ingName)
                                if slot then
                                    for _ = 1, req - current do dropItemToCauldron(ingName, cauldron) task.wait(getgenv().ingredientDropDelay) end
                                else
                                    Notify({Title = "Brew Error", Content = "Missing " .. ingName, Duration = 3})
                                    success = false break
                                end
                            end
                        end
                        if success then Notify({Title = "Brewing", Content = getgenv().selectedPotion .. " started!", Duration = 2}) end
                    end
                    continue
                end
            end
            if getgenv().autoIceEnabled and not getgenv().autoBrewEnabled then
                if potionAttr == "" then
                    local iceCount = countItemsInCauldron(cauldron, "Ice Cube")
                    if iceCount == 0 then iceCount = countItemsInCauldron(cauldron, "Ice") end
                    if iceCount < 3 then
                        local slot = getInventorySlot("Ice Cube") or getInventorySlot("Ice")
                        if slot then
                            local name = getInventorySlot("Ice Cube") and "Ice Cube" or "Ice"
                            for i = 1, 3 - iceCount do dropItemToCauldron(name, cauldron) task.wait(getgenv().iceDropDelay) end
                            Notify({Title = "Ice", Content = "Cauldron filled with 3 Ice", Duration = 2})
                        end
                    end
                end
            end
        end
    end
end

local function autoCollectLoop()
    while getgenv().autoCollectEnabled do
        pcall(function()
            if not plr or not plr.Character then return end
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if not root then return end
            local range = getgenv().collectRange or 60
            for _, cauldron in pairs(workspace.Deployables:GetChildren()) do
