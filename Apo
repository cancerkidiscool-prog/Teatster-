        ZIndex = 2,
        Parent = content,
    })
    utility.create("TextLabel", {
        Size = UDim2.new(1, -12, 0, 0),
        Position = UDim2.new(0, 6, 0, 0),
        BackgroundTransparency = 1,
        Text = options.Content or "Message",
